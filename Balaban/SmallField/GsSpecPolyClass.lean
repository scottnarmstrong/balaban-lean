module

public import Balaban.SmallField.GsSpecPolyEqv
public import Balaban.SmallField.GsSpecClass

/-!
# A class member with genuinely local generating sets

`localTerms` has zero terms `ℰ = ℳ = 0` and, for every set `X` and `j ≤ k`, the generating set
`gs j X = polyGS X`, the minimal set `𝔹_j(X)` of P3 (4.4)-(4.6).  It satisfies all clauses of
`SFTermClausesStrong`, in particular the equivariance clause `pavingGS` (`pavingGS_polyGS`),
under the paving group generated by translations by, reflections about and exchanges of the
cell side `L ^ (j + m₀ + m₁)`.
-/

@[expose] public section

namespace Balaban.SmallField.GsSpec

open Balaban Balaban.Multiscale Balaban.Background Balaban.Localization Balaban.SmallField
  Balaban.SmallField.Def6 Balaban.SmallField.Def6v2 Balaban.LargeField Finset

variable {d L N₁ m₁ k N : ℕ} [NeZero L] [NeZero N₁]

/-- **`pavingGS` for the minimal sets**: `Ω_i(𝔹_j(r X)) = r Ω_i(𝔹_j(X))` for `r` in the paving
group of scale `j` (all sets `X`). -/
theorem pavingGS_polyGS {m₀ j : ℕ} (hjk : j ≤ k) (X : Set (CTorus d L N₁ m₁ k))
    {r : Equiv.Perm (CTorus d L N₁ m₁ k)}
    (hr : r ∈ pavingSymGroup (N₁ := N₁) (m₁ := m₁) (k := k) (d := d) L m₀ j) (i : ℕ) :
    (((polyGS hjk (r '' X)).Ω i : Finset (CTorus d L N₁ m₁ k)) : Set (CTorus d L N₁ m₁ k)) =
      r '' (((polyGS hjk X).Ω i : Finset (CTorus d L N₁ m₁ k)) : Set (CTorus d L N₁ m₁ k)) := by
  have hI : CubeIso j r := cubeIso_of_mem_symGroupBy hjk
    (fun i hi => (pow_dvd_pow L (by omega : i ≤ j + m₀ + m₁) : L ^ i ∣ L ^ (j + m₀ + m₁))) hr
  ext z
  rw [Set.mem_image_equiv]
  simp only [Finset.mem_coe, mem_polyGS_Ω_iff]
  refine and_congr_right fun hi => ?_
  have := plAux_equiv hI X (t := j - i) (by omega) (r.symm z)
  simpa using this

/-- **The zero terms with the minimal generating sets**: `ℰ = ℳ = 0` and `gs j X = 𝔹_j(X)`
(`polyGS`) for `j ≤ k`. -/
noncomputable def localTerms (d L N₁ m₁ k N : ℕ) [NeZero L] [NeZero N₁] :
    Terms d L N₁ m₁ k N (minSep L 1) where
  E := fun _ _ _ _ _ => 0
  M := fun _ _ _ _ _ _ => 0
  gs := fun j X => if h : j ≤ k then polyGS h X else topGS d L N₁ m₁ k (minSep L 1)

theorem localTerms_gs {j : ℕ} (hjk : j ≤ k) (X : Set (CTorus d L N₁ m₁ k)) :
    (localTerms d L N₁ m₁ k N).gs j X = polyGS hjk X := by
  simp [localTerms, hjk]

theorem Eloc_localTerms (m₀ j : ℕ) (y : CTorus d L N₁ m₁ k) (ψ h : Fld d L N₁ m₁ k N) :
    Eloc m₀ (localTerms d L N₁ m₁ k N) j y ψ h = 0 := by
  simp [Eloc, localTerms]

theorem Mloc_localTerms (m₀ j : ℕ) (x : CTorus d L N₁ m₁ k) (ψ h g : Fld d L N₁ m₁ k N) :
    Mloc m₀ (localTerms d L N₁ m₁ k N) j x ψ h g = 0 := by
  simp [Mloc, localTerms]

/-- **The strong term clauses hold for the zero terms with the minimal generating sets**: a class
member whose local sets `Tm.gs j X = 𝔹_j(X)` are genuinely local (`Ω₁(𝔹_j(X))` is not the whole
torus in general, `gsSpecStrong_minimal_witness`). -/
theorem sfTermClausesStrong_localTerms {P : Consts} (hE₀ : 0 ≤ P.E₀)
    (hc9 : ∀ j, 0 < P.c₉ * ((L : ℝ) ^ j)⁻¹ ^ (((d : ℝ) - 2) / 2 + P.γ - P.α₁))
    (Dom : FieldDom d L N₁ m₁ k N (minSep L 1)) :
    SFTermClausesStrong P Dom (localTerms d L N₁ m₁ k N) where
  gs_spec := fun j hj1 hjk X hX => by
    rw [localTerms_gs hjk]
    have := gsSpecCore_polyGS hj1 hjk hX
    exact ⟨this.subset, this.noAbove⟩
  analyticE := fun j _ _ y X _ _ => analyticOnNhd_const
  analyticM := fun j _ _ x X _ _ => analyticOnNhd_const
  rotE := by intros; rfl
  pavingGS := fun j hj1 hjk X _ r hr i => by
    rw [localTerms_gs hjk, localTerms_gs hjk]
    exact pavingGS_polyGS hjk X hr i
  eucE := by intros; rfl
  eucEloc := by
    intro j _ hjk y r _ Ψ h _ _
    rw [Eloc_localTerms, Eloc_localTerms]
  rotM := by
    intro j _ _ x X _ _ R hR Ψ h g _ _
    show (0 : Fin N → ℂ) = R.mulVec 0
    simp
  eucM := by intros; rfl
  eucMloc := by
    intro j _ hjk x r _ Ψ h g _ _
    rw [Mloc_localTerms, Mloc_localTerms]
  localE := by intros; rfl
  localM := by intros; rfl
  boundE := by
    intro j _ _ y X _ _ Ψ h _
    show ‖(0 : ℂ)‖ ≤ _
    rw [norm_zero]
    exact mul_nonneg hE₀ (Real.exp_pos _).le
  boundM := by
    intro j _ _ x X _ _ Ψ h g _ _
    show vn (0 : Fin N → ℂ) < _
    rw [vn_zero]
    exact mul_pos (hc9 j) (Real.exp_pos _)
  gsStrong := fun j hj1 hjk X hX => by
    rw [localTerms_gs hjk]
    exact gsSpecStrong_polyGS hj1 hjk hX

/-- The strong term clauses with genuinely local generating sets are inhabited (hard rule 10):
the zero terms with the minimal generating sets, for every field domain, with the constants
`witnessConsts`. -/
theorem sfTermClausesStrong_localTerms_nonempty (Dom : FieldDom d L N₁ m₁ k N (minSep L 1)) :
    Nonempty (SFTermClausesStrong witnessConsts Dom (localTerms d L N₁ m₁ k N)) := by
  refine ⟨sfTermClausesStrong_localTerms (by simp [witnessConsts]) (fun j => ?_) Dom⟩
  have hL : (0 : ℝ) < L := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne L)
  simp only [witnessConsts, one_mul]
  positivity

end Balaban.SmallField.GsSpec
