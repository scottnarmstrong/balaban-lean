module

public import Balaban.SmallField.IrrelTorusDefectMatrix
public import Balaban.Localization.DecEquivReflectPolymer

/-!
# Point symmetries of the full density Hessian

The `eucEloc` clause applies to the full level density under the group generated by block
translations, reflections and coordinate exchanges. This lemma differentiates that clause
at the constant reference field. The geometric action on block directions is recorded
explicitly so that one proof serves every point symmetry.
-/

@[expose] public section

namespace Balaban.SmallField.Def6

open Balaban Balaban.Multiscale Balaban.Background Balaban.Localization Balaban.SmallField
  Balaban.Localization.DecEquiv

variable {d L N₁ m₁ k N : ℕ} [NeZero L] [NeZero N₁] {ϱ : ℝ} {P : Consts}
  {β ν a : ℕ → ℝ} {Ek : ℝ} {Tm : Terms d L N₁ m₁ k N ϱ}
  {ρd : (CTorus d L N₁ m₁ k → Fin N → ℝ) → (Fin N → ℝ) →
    (CTorus d L N₁ m₁ k → Fin N → ℝ) → ℝ} {j : ℕ} {ρ : ℝ}

omit [NeZero L] [NeZero N₁] in
/-- Coordinate exchange belongs to the full level symmetry group. -/
theorem swapJ_mem_fullJSymGroup (μ ν : Fin d) :
    swapJ (L := L) (N₁ := N₁) (m₁ := m₁) (k := k) μ ν ∈
      fullJSymGroup (d := d) (N₁ := N₁) (m₁ := m₁) (k := k) L j := by
  apply Subgroup.subset_closure
  exact Or.inr ⟨μ, ν, rfl⟩

omit [NeZero L] [NeZero N₁] in
/-- Reflection belongs to the full level symmetry group. -/
theorem flipBy_mem_fullJSymGroup (μ : Fin d) :
    flipBy (d := d) (L := L) (N₁ := N₁) (m₁ := m₁) (k := k) (L ^ j) μ ∈
      fullJSymGroup (d := d) (N₁ := N₁) (m₁ := m₁) (k := k) L j := by
  apply Subgroup.subset_closure
  exact Or.inl (Or.inr ⟨μ, rfl⟩)

open Classical in
/-- Reflection carries a block direction to the reflected block base. -/
theorem actField_flipBy_blockDir (hjk : j ≤ k) (μ : Fin d)
    (x : CTorus d L N₁ m₁ k) (i : Fin N) :
    actField (N := N) (flipBy (L ^ j) μ) (blockDir L j x i) =
      blockDir L j (reflBase (L ^ j) μ (L ^ j : ZMod _) x) i := by
  have hdvd : L ^ j ∣ (N₁ * L ^ m₁) * L ^ k :=
    (pow_dvd_pow L hjk).trans (dvd_mul_left _ _)
  have hval : L ^ j ∣ ((L ^ j : ZMod (N₁ * L ^ m₁ * L ^ k))).val := by
    simpa only [Nat.cast_pow] using
      (dvd_val_natCast (L := L) (N₁ := N₁) (m₁ := m₁) (k := k) hjk dvd_rfl)
  have hs0 : 0 < L ^ j := pow_pos (NeZero.pos L) j
  funext z i'
  have hcb : cbase (L ^ j) ((flipBy (L ^ j) μ).symm z) =
      reflBase (L ^ j) μ (L ^ j : ZMod _) (cbase (L ^ j) z) := by
    change cbase (L ^ j) (reflPerm μ (L ^ j : ZMod _) z) = _
    simpa only [Nat.cast_pow] using (cbase_refl hdvd hs0 μ _ hval z)
  have hbase : cbase (L ^ j) ((flipBy (L ^ j) μ).symm z) = x ↔
      cbase (L ^ j) z = reflBase (L ^ j) μ (L ^ j : ZMod _) x := by
    rw [hcb]
    constructor
    · intro h
      have h' := congrArg (reflBase (L ^ j) μ (L ^ j : ZMod _)) h
      simpa only [reflBase_reflBase] using h'.symm.symm
    · intro h
      rw [h]
      exact reflBase_reflBase _ _ _ _
  simp only [actField, blockDir, hbase]

/-- Reflection about the origin block fixes its block base. -/
theorem flipBy_blockBase_zero (hjk : j ≤ k) (μ : Fin d) :
    blockBase L j ((flipBy (L ^ j) μ) (0 : CTorus d L N₁ m₁ k)) = 0 := by
  have hdvd : L ^ j ∣ (N₁ * L ^ m₁) * L ^ k :=
    (pow_dvd_pow L hjk).trans (dvd_mul_left _ _)
  have hval : L ^ j ∣ ((L ^ j : ZMod (N₁ * L ^ m₁ * L ^ k))).val := by
    simpa only [Nat.cast_pow] using
      (dvd_val_natCast (L := L) (N₁ := N₁) (m₁ := m₁) (k := k) hjk dvd_rfl)
  have hs0 : 0 < L ^ j := pow_pos (NeZero.pos L) j
  change cbase (L ^ j) (reflPerm μ (L ^ j : ZMod _) 0) = 0
  have h := cbase_refl hdvd hs0 μ _ hval (0 : CTorus d L N₁ m₁ k)
  rw [show cbase (L ^ j) (reflPerm μ (L ^ j : ZMod _) 0) =
    reflBase (L ^ j) μ (L ^ j : ZMod _) (cbase (L ^ j) 0) from by
      simpa only [Nat.cast_pow] using h]
  rw [← blockBase, blockBase_zero]
  simp [reflBase]

omit [NeZero L] [NeZero N₁] in
open Classical in
/-- Exchange of coordinates carries a block direction to the exchanged block. -/
theorem actField_swapJ_blockDir (μ ν : Fin d)
    (x : CTorus d L N₁ m₁ k) (i : Fin N) :
    actField (N := N) (swapJ μ ν) (blockDir L j x i) =
      blockDir L j (swapJ μ ν x) i := by
  funext z i'
  have hcb : cbase (L ^ j) ((swapJ μ ν).symm z) =
      (swapJ μ ν).symm (cbase (L ^ j) z) := by
    funext ξ
    rfl
  have hbase : cbase (L ^ j) ((swapJ μ ν).symm z) = x ↔
      cbase (L ^ j) z = swapJ μ ν x := by
    rw [hcb]
    exact (swapJ μ ν).symm_apply_eq
  simp only [actField, blockDir]
  simp only [hbase]

/-- Differentiated `eucEloc` at a point symmetry fixing the origin block. The two
direction identities are the geometric calculation for the selected symmetry. -/
theorem LiftCtx.D2_Eloc_pointSymm_of_blockDir
    (ctx : LiftCtx P β ν a Tm ρd Ek j ρ) (i₀ i₁ : Fin N)
    (r : Equiv.Perm (CTorus d L N₁ m₁ k))
    (hr : r ∈ fullJSymGroup L j)
    (hr0 : blockBase L j (r 0) = 0)
    (x v x' v' : CTorus d L N₁ m₁ k)
    (hx : actField (N := N) r (blockDir L j x i₁) = blockDir L j x' i₁)
    (hv : actField (N := N) r (blockDir L j v i₁) = blockDir L j v' i₁) :
    D2 (fun ψ : Fld d L N₁ m₁ k N => Eloc P.m₀ Tm j 0 ψ
      (eFld d L N₁ m₁ k N i₀)) (eFld d L N₁ m₁ k N i₀)
      (blockDir L j x i₁) (blockDir L j v i₁) =
    D2 (fun ψ : Fld d L N₁ m₁ k N => Eloc P.m₀ Tm j 0 ψ
      (eFld d L N₁ m₁ k N i₀)) (eFld d L N₁ m₁ k N i₀)
      (blockDir L j x' i₁) (blockDir L j v' i₁) := by
  have hjk := ctx.jk
  have hlev : ∀ i, j < i →
      (levelGS (d := d) (L := L) (N₁ := N₁) (m₁ := m₁) (ϱ := ϱ) j hjk).Ω i = ∅ := by
    intro i hi
    simp [levelGS, not_le.2 hi]
  refine D2_congr_slice (ctx.analyticAt_Eloc i₀ 0) (ctx.analyticAt_Eloc i₀ 0)
    (δ := ρ / 2) (by linarith [ctx.rho_pos]) fun s t hs ht => ?_
  have hst : ‖s‖ + ‖t‖ ≤ ρ := by linarith
  have X1 := ctx.xiDom_const (levelGS (d := d) (L := L) (N₁ := N₁) (m₁ := m₁)
    (ϱ := ϱ) j hjk) hlev i₀
    (eFld d L N₁ m₁ k N i₀ + s • blockDir L j x i₁ + t • blockDir L j v i₁)
    (fun z i => (slice_dev x v i₁ i₀ s t z i).trans hst)
    (fun z z' h => slice_jBlock hjk x v i₁ i₀ s t h)
  have X2 := ctx.xiDom_const (levelGS (d := d) (L := L) (N₁ := N₁) (m₁ := m₁)
    (ϱ := ϱ) j hjk) hlev i₀
    (eFld d L N₁ m₁ k N i₀ + s • blockDir L j x' i₁ + t • blockDir L j v' i₁)
    (fun z i => (slice_dev x' v' i₁ i₀ s t z i).trans hst)
    (fun z z' h => slice_jBlock hjk x' v' i₁ i₀ s t h)
  have hact : actField (N := N) r
      (eFld d L N₁ m₁ k N i₀ + s • blockDir L j x i₁ + t • blockDir L j v i₁) =
      eFld d L N₁ m₁ k N i₀ + s • blockDir L j x' i₁ + t • blockDir L j v' i₁ := by
    funext z i'
    have h1 := congrFun (congrFun hx z) i'
    have h2 := congrFun (congrFun hv z) i'
    simp only [actField, Pi.add_apply, Pi.smul_apply, smul_eq_mul, eFld, constFld] at h1 h2 ⊢
    rw [h1, h2]
  have hc0 : actField (N := N) r (eFld d L N₁ m₁ k N i₀) =
      eFld d L N₁ m₁ k N i₀ := rfl
  have key := ctx.sf.eucEloc j ctx.j1 hjk (0 : CTorus d L N₁ m₁ k) r hr
    (eFld d L N₁ m₁ k N i₀ + s • blockDir L j x i₁ + t • blockDir L j v i₁)
    (eFld d L N₁ m₁ k N i₀) X1 (by rw [hact, hc0]; exact X2)
  rw [hact, hc0, hr0] at key
  exact key.symm

/-- The complete Hessian at the origin is unchanged by exchange of spatial coordinates. -/
theorem LiftCtx.D2_Eloc_swapJ (ctx : LiftCtx P β ν a Tm ρd Ek j ρ)
    (i₀ i₁ : Fin N) (μ ν : Fin d) (x v : CTorus d L N₁ m₁ k) :
    D2 (fun ψ : Fld d L N₁ m₁ k N => Eloc P.m₀ Tm j 0 ψ
      (eFld d L N₁ m₁ k N i₀)) (eFld d L N₁ m₁ k N i₀)
      (blockDir L j x i₁) (blockDir L j v i₁) =
    D2 (fun ψ : Fld d L N₁ m₁ k N => Eloc P.m₀ Tm j 0 ψ
      (eFld d L N₁ m₁ k N i₀)) (eFld d L N₁ m₁ k N i₀)
      (blockDir L j (swapJ μ ν x) i₁) (blockDir L j (swapJ μ ν v) i₁) := by
  have h0 : blockBase L j ((swapJ μ ν) (0 : CTorus d L N₁ m₁ k)) = 0 := by
    change blockBase L j (0 : CTorus d L N₁ m₁ k) = 0
    exact blockBase_zero L j
  exact ctx.D2_Eloc_pointSymm_of_blockDir i₀ i₁ (swapJ μ ν)
    (swapJ_mem_fullJSymGroup μ ν) h0 x v _ _
    (actField_swapJ_blockDir μ ν x i₁) (actField_swapJ_blockDir μ ν v i₁)

/-- The complete Hessian at the origin is unchanged by reflection of a spatial coordinate. -/
theorem LiftCtx.D2_Eloc_flipBy (ctx : LiftCtx P β ν a Tm ρd Ek j ρ)
    (i₀ i₁ : Fin N) (μ : Fin d) (x v : CTorus d L N₁ m₁ k) :
    D2 (fun ψ : Fld d L N₁ m₁ k N => Eloc P.m₀ Tm j 0 ψ
      (eFld d L N₁ m₁ k N i₀)) (eFld d L N₁ m₁ k N i₀)
      (blockDir L j x i₁) (blockDir L j v i₁) =
    D2 (fun ψ : Fld d L N₁ m₁ k N => Eloc P.m₀ Tm j 0 ψ
      (eFld d L N₁ m₁ k N i₀)) (eFld d L N₁ m₁ k N i₀)
      (blockDir L j (reflBase (L ^ j) μ (L ^ j : ZMod _) x) i₁)
      (blockDir L j (reflBase (L ^ j) μ (L ^ j : ZMod _) v) i₁) := by
  exact ctx.D2_Eloc_pointSymm_of_blockDir i₀ i₁ (flipBy (L ^ j) μ)
    (flipBy_mem_fullJSymGroup μ) (flipBy_blockBase_zero ctx.jk μ) x v _ _
    (actField_flipBy_blockDir ctx.jk μ x i₁)
    (actField_flipBy_blockDir ctx.jk μ v i₁)

/-- Transport of point symmetry to any aligned centre. The point symmetry is applied to the
two block positions relative to the centre. -/
theorem LiftCtx.D2_Eloc_pointSymm_at_of_blockDir
    (ctx : LiftCtx P β ν a Tm ρd Ek j ρ) (i₀ i₁ : Fin N)
    {y : CTorus d L N₁ m₁ k} (hy : Aligned (L ^ j) y)
    (r : Equiv.Perm (CTorus d L N₁ m₁ k))
    (hr : r ∈ fullJSymGroup L j) (hr0 : blockBase L j (r 0) = 0)
    (x v x' v' : CTorus d L N₁ m₁ k)
    (hx : actField (N := N) r (blockDir L j (x - y) i₁) = blockDir L j x' i₁)
    (hv : actField (N := N) r (blockDir L j (v - y) i₁) = blockDir L j v' i₁) :
    D2 (fun ψ : Fld d L N₁ m₁ k N => Eloc P.m₀ Tm j y ψ
      (eFld d L N₁ m₁ k N i₀)) (eFld d L N₁ m₁ k N i₀)
      (blockDir L j x i₁) (blockDir L j v i₁) =
    D2 (fun ψ : Fld d L N₁ m₁ k N => Eloc P.m₀ Tm j y ψ
      (eFld d L N₁ m₁ k N i₀)) (eFld d L N₁ m₁ k N i₀)
      (blockDir L j (x' + y) i₁) (blockDir L j (v' + y) i₁) := by
  calc
    _ = D2 (fun ψ : Fld d L N₁ m₁ k N => Eloc P.m₀ Tm j 0 ψ
          (eFld d L N₁ m₁ k N i₀)) (eFld d L N₁ m₁ k N i₀)
          (blockDir L j (x - y) i₁) (blockDir L j (v - y) i₁) :=
      ctx.D2_Eloc_translate' i₀ i₁ hy x v
    _ = D2 (fun ψ : Fld d L N₁ m₁ k N => Eloc P.m₀ Tm j 0 ψ
          (eFld d L N₁ m₁ k N i₀)) (eFld d L N₁ m₁ k N i₀)
          (blockDir L j x' i₁) (blockDir L j v' i₁) :=
      ctx.D2_Eloc_pointSymm_of_blockDir i₀ i₁ r hr hr0 _ _ _ _ hx hv
    _ = _ := by
      simpa only [add_sub_cancel_right] using
        (ctx.D2_Eloc_translate' i₀ i₁ hy (x' + y) (v' + y)).symm

/-- Coordinate exchange of the full Hessian at every aligned centre. -/
theorem LiftCtx.D2_Eloc_swapJ_at (ctx : LiftCtx P β ν a Tm ρd Ek j ρ)
    (i₀ i₁ : Fin N) {y : CTorus d L N₁ m₁ k} (hy : Aligned (L ^ j) y)
    (μ ν : Fin d) (x v : CTorus d L N₁ m₁ k) :
    D2 (fun ψ : Fld d L N₁ m₁ k N => Eloc P.m₀ Tm j y ψ
      (eFld d L N₁ m₁ k N i₀)) (eFld d L N₁ m₁ k N i₀)
      (blockDir L j x i₁) (blockDir L j v i₁) =
    D2 (fun ψ : Fld d L N₁ m₁ k N => Eloc P.m₀ Tm j y ψ
      (eFld d L N₁ m₁ k N i₀)) (eFld d L N₁ m₁ k N i₀)
      (blockDir L j (swapJ μ ν (x - y) + y) i₁)
      (blockDir L j (swapJ μ ν (v - y) + y) i₁) := by
  have h0 : blockBase L j ((swapJ μ ν) (0 : CTorus d L N₁ m₁ k)) = 0 := by
    change blockBase L j (0 : CTorus d L N₁ m₁ k) = 0
    exact blockBase_zero L j
  exact ctx.D2_Eloc_pointSymm_at_of_blockDir i₀ i₁ hy (swapJ μ ν)
    (swapJ_mem_fullJSymGroup μ ν) h0 x v _ _
    (actField_swapJ_blockDir μ ν (x - y) i₁)
    (actField_swapJ_blockDir μ ν (v - y) i₁)

/-- Reflection of the full Hessian at every aligned centre. -/
theorem LiftCtx.D2_Eloc_flipBy_at (ctx : LiftCtx P β ν a Tm ρd Ek j ρ)
    (i₀ i₁ : Fin N) {y : CTorus d L N₁ m₁ k} (hy : Aligned (L ^ j) y)
    (μ : Fin d) (x v : CTorus d L N₁ m₁ k) :
    D2 (fun ψ : Fld d L N₁ m₁ k N => Eloc P.m₀ Tm j y ψ
      (eFld d L N₁ m₁ k N i₀)) (eFld d L N₁ m₁ k N i₀)
      (blockDir L j x i₁) (blockDir L j v i₁) =
    D2 (fun ψ : Fld d L N₁ m₁ k N => Eloc P.m₀ Tm j y ψ
      (eFld d L N₁ m₁ k N i₀)) (eFld d L N₁ m₁ k N i₀)
      (blockDir L j (reflBase (L ^ j) μ (L ^ j : ZMod _) (x - y) + y) i₁)
      (blockDir L j (reflBase (L ^ j) μ (L ^ j : ZMod _) (v - y) + y) i₁) := by
  exact ctx.D2_Eloc_pointSymm_at_of_blockDir i₀ i₁ hy (flipBy (L ^ j) μ)
    (flipBy_mem_fullJSymGroup μ) (flipBy_blockBase_zero ctx.jk μ) x v _ _
    (actField_flipBy_blockDir ctx.jk μ (x - y) i₁)
    (actField_flipBy_blockDir ctx.jk μ (v - y) i₁)

end Balaban.SmallField.Def6
