module

public import Balaban.Background.EquivarianceLat
public import Balaban.SmallField.Xi
public import Balaban.SmallField.Def6Terms

/-!
# Lattice-symmetry covariance of the analyticity spaces `Ξ`, `Ξ^c` (SMALLFIELD.md §1.7)

For a lattice symmetry `S : LatSymm G G' g` (`Balaban/Background/EquivarianceLat.lean`: a symmetry of
the paved torus that maps `Ω_j` onto `Ω'_j`):

* `xi_sym_iff`: `(Ψ₀ ∘ g⁻¹, h₀) ∈ Ξ_n(G'; σ, ε)` iff `(Ψ₀, h₀) ∈ Ξ_n(G; σ, ε)`;
* `xiC_sym_iff`: the same for `Ξ^c_n`.

The last section shows that every element of the groups `fullJSymGroup L j` and
`pavingSymGroup L m₀ j` of `Def6Terms` (generated by translations by `s`, the reflections
`x_μ ↦ s - 1 - x_μ` and the coordinate exchanges, `L ^ j ∣ s`, `j ≤ k`) is a symmetry of the paved
torus up to scale `j` (`Def6.nonempty_torusSymm_of_mem_symGroupBy`), hence a lattice symmetry of the
whole-lattice generating set `levelGS j` (`Def6.nonempty_latSymm_levelGS`).
-/

@[expose] public section

namespace Balaban.SmallField
open Balaban.Background Balaban.Multiscale Matrix Finset
variable {d L N₀ k N : ℕ} [NeZero N₀] [NeZero L] {ϱ : ℝ}

section Domain

variable {G G' : GeneratingSet d L N₀ k ϱ} {g : Equiv.Perm (Torus d (N₀ * L ^ k))}
  (S : LatSymm G G' g)

include S

theorem blockSet_sym_iff (x y : Torus d (N₀ * L ^ k)) :
    y ∈ blockSet G' (g x) ↔ g.symm y ∈ blockSet G x := by
  classical
  unfold blockSet
  by_cases hx : x ∈ G.Ω 1
  · have hx' : g x ∈ G'.Ω 1 := (S.mem_Ω1 x).2 hx
    obtain ⟨h1, hk, hl⟩ := G.layerIndex_spec hx
    simp only [hx, hx', ↓reduceIte, S.layerIndex_eq]
    exact S.blk_iff h1 hk ⟨x, hl⟩ x y
  · have hx' : g x ∉ G'.Ω 1 := fun h => hx ((S.mem_Ω1 x).1 h)
    simp only [hx, hx', ↓reduceIte, Finset.mem_singleton]
    exact (g.symm_apply_eq).symm

theorem blocksAdjacent_sym_iff (x x' : Torus d (N₀ * L ^ k)) :
    BlocksAdjacent G' (g x) (g x') ↔ BlocksAdjacent G x x' := by
  unfold BlocksAdjacent
  constructor
  · rintro ⟨y, hy, y', hy', hadj⟩
    refine ⟨g.symm y, (blockSet_sym_iff S x y).1 hy, g.symm y', (blockSet_sym_iff S x' y').1 hy', ?_⟩
    rw [← S.adj_iff]; simpa using hadj
  · rintro ⟨y, hy, y', hy', hadj⟩
    refine ⟨g y, (blockSet_sym_iff S x (g y)).2 (by simpa using hy), g y',
      (blockSet_sym_iff S x' (g y')).2 (by simpa using hy'), (S.adj_iff y y').2 hadj⟩

theorem isInterfacePair_sym_iff (x x' : Torus d (N₀ * L ^ k)) :
    IsInterfacePair G' (g x) (g x') ↔ IsInterfacePair G x x' := by
  unfold IsInterfacePair
  rw [S.mem_dataSites, S.mem_dataSites, S.layerIndex_eq, S.layerIndex_eq, blocksAdjacent_sym_iff S]


theorem isLayerConstant_sym {β : Type*} {Ψ : Torus d (N₀ * L ^ k) → β} (h : IsLayerConstant G Ψ) :
    IsLayerConstant G' (fun y => Ψ (g.symm y)) := by
  intro n h1 hk y hy y' hy'
  obtain ⟨x, rfl⟩ := g.surjective y
  obtain ⟨x', rfl⟩ := g.surjective y'
  simp only [Equiv.symm_apply_apply]
  have hx := (S.mem_layer h1 hk x).1 hy
  have hx' := (S.blk_iff h1 hk ⟨x, hx⟩ x (g x')).1 hy'
  simp only [Equiv.symm_apply_apply] at hx'
  exact h n h1 hk x hx x' hx'

theorem inPsiTilde_sym {ν δ : ℝ} {Ψ : Torus d (N₀ * L ^ k) → Fin N → ℝ} {h : Fin N → ℝ}
    (H : InPsiTilde G ν δ Ψ h) : InPsiTilde G' ν δ (fun y => Ψ (g.symm y)) h where
  layerConst := isLayerConstant_sym S H.layerConst
  r1 := fun x x' hxx' => by
    obtain ⟨a, rfl⟩ := g.surjective x
    obtain ⟨b, rfl⟩ := g.surjective x'
    simp only [Equiv.symm_apply_apply]
    exact H.r1 a b ((isInterfacePair_sym_iff S a b).1 hxx')
  r2 := fun x hx => by
    obtain ⟨a, rfl⟩ := g.surjective x
    simp only [Equiv.symm_apply_apply]
    exact H.r2 a ((S.mem_dataSites a).1 hx)
  r3 := fun x hx => by
    obtain ⟨a, rfl⟩ := g.surjective x
    simp only [Equiv.symm_apply_apply, S.layerIndex_eq]
    exact H.r3 a ((S.mem_dataSites a).1 hx)
  r4 := H.r4

theorem inPsiTildeC_sym {ν δ ε : ℝ} {Ψ : Torus d (N₀ * L ^ k) → Fin N → ℝ} {h : Fin N → ℝ}
    {Ψ' h' : Torus d (N₀ * L ^ k) → Fin N → ℂ} (H : InPsiTildeC G ν δ ε Ψ h Ψ' h') :
    InPsiTildeC G' ν δ ε (fun y => Ψ (g.symm y)) h (fun y => Ψ' (g.symm y))
      (fun y => h' (g.symm y)) where
  toInPsiTilde := inPsiTilde_sym S H.toInPsiTilde
  eps_pos := H.eps_pos
  layerConst' := isLayerConstant_sym S H.layerConst'
  hLayerConst' := isLayerConstant_sym S H.hLayerConst'
  c1 := fun x x' hxx' => by
    obtain ⟨a, rfl⟩ := g.surjective x
    obtain ⟨b, rfl⟩ := g.surjective x'
    simp only [Equiv.symm_apply_apply]
    exact H.c1 a b ((isInterfacePair_sym_iff S a b).1 hxx')
  c2a := fun x hx => by
    obtain ⟨a, rfl⟩ := g.surjective x
    simp only [Equiv.symm_apply_apply]
    exact H.c2a a ((S.mem_dataSites a).1 hx)
  c2b := fun x hx => by
    obtain ⟨a, rfl⟩ := g.surjective x
    simp only [Equiv.symm_apply_apply]
    exact H.c2b a ((S.mem_dataSites a).1 hx)
  c3a := fun x hx => by
    obtain ⟨a, rfl⟩ := g.surjective x
    simp only [Equiv.symm_apply_apply, S.layerIndex_eq]
    exact H.c3a a ((S.mem_Ω1 a).1 hx)
  c3b := fun x hx => by
    obtain ⟨a, rfl⟩ := g.surjective x
    simp only [Equiv.symm_apply_apply, S.layerIndex_eq]
    exact H.c3b a ((S.mem_Ω1 a).1 hx)

theorem inDomainR_sym {ν δ : ℝ} {D : BgData G N} (H : InDomainR G ν δ D) :
    InDomainR G' ν δ (S.sym D) := by
  obtain ⟨Ψ, h, H, hΨ, hh⟩ := H
  refine ⟨fun y => Ψ (g.symm y), h, inPsiTilde_sym S H, fun x hx i => ?_, fun x hx i => ?_⟩
  · obtain ⟨a, rfl⟩ := g.surjective x
    simp only [LatSymm.sym, Equiv.symm_apply_apply]
    exact hΨ a ((S.mem_dataSites a).1 hx) i
  · obtain ⟨a, rfl⟩ := g.surjective x
    simp only [LatSymm.sym, Equiv.symm_apply_apply]
    exact hh a ((S.mem_Ω1 a).1 hx) i

theorem inDomainC_sym {ν δ ε : ℝ} {D : BgData G N} (H : InDomainC G ν δ ε D) :
    InDomainC G' ν δ ε (S.sym D) := by
  obtain ⟨Ψ, h, Ψ', h', H, hΨ, hh⟩ := H
  refine ⟨fun y => Ψ (g.symm y), h, fun y => Ψ' (g.symm y), fun y => h' (g.symm y),
    inPsiTildeC_sym S H, fun x hx i => ?_, fun x hx i => ?_⟩
  · obtain ⟨a, rfl⟩ := g.surjective x
    simp only [LatSymm.sym, Equiv.symm_apply_apply]
    exact hΨ a ((S.mem_dataSites a).1 hx) i
  · obtain ⟨a, rfl⟩ := g.surjective x
    simp only [LatSymm.sym, Equiv.symm_apply_apply]
    exact hh a ((S.mem_Ω1 a).1 hx) i

theorem inUnionDomainR_sym {c₁ ν : ℝ} {D : BgData G N} (H : InUnionDomainR G c₁ ν D) :
    InUnionDomainR G' c₁ ν (S.sym D) := by
  obtain ⟨δ, h0, h1, H⟩ := H
  exact ⟨δ, h0, h1, inDomainR_sym S H⟩

theorem inUnionDomainC_sym {c₀ c₁ ν : ℝ} {D : BgData G N} (H : InUnionDomainC G c₀ c₁ ν D) :
    InUnionDomainC G' c₀ c₁ ν (S.sym D) := by
  obtain ⟨δ, ε, h0, h1, h2, h3, h4, H⟩ := H
  exact ⟨δ, ε, h0, h1, h2, h3, h4, inDomainC_sym S H⟩


theorem nbr_and_swap (P : Torus d (N₀ * L ^ k) → Prop) (a : Torus d (N₀ * L ^ k)) (μ : Fin d) :
    (P (g a + Pi.single (S.perm μ) 1) ∧ P (g a - Pi.single (S.perm μ) 1)) ↔
      (P (g (a + Pi.single μ 1)) ∧ P (g (a - Pi.single μ 1))) := by
  rw [S.step, S.step_sub]
  cases S.flip μ
  · simp
  · simp [and_comm]

theorem LatSymm.fld_sub {N : ℕ} (φ ψ : G.Ω 1 × Fin N → ℂ) : S.fld (φ - ψ) = S.fld φ - S.fld ψ := by
  funext p; simp [LatSymm.fld]

theorem xiBounds_sym {ν σ ε : ℝ} {n : ℕ} {D : BgData G N} {h₀ : Fin N → ℝ}
    {φ : G.Ω 1 × Fin N → ℂ} {α : G.Ω 1 → ℂ} (H : XiBounds G ν n σ ε D h₀ φ α) :
    XiBounds G' ν n σ ε (S.sym D) h₀ (S.fld φ) (S.mul α) := by
  refine
    { grad := fun x hx ν' => ?_
      lap := fun x hx => ?_
      mult := fun y => ?_
      close := fun x hx => ?_
      collarBond := fun z hz z' hz' hadj => ?_
      mass := fun z => ?_
      hnorm := H.hnorm }
  · obtain ⟨a, rfl⟩ := g.surjective x
    obtain ⟨μ, rfl⟩ := S.perm.surjective ν'
    have ha := (S.mem_Ω1 a).1 hx
    have := nbr_and_swap S (fun y => vn (fun i => barField G' (S.sym D).Ψ (S.fld φ) y i -
      barField G' (S.sym D).Ψ (S.fld φ) (g a) i) < σ * ε / G'.spacing (g a)) a μ
    refine this.2 ?_
    simp only [S.barField_sym, S.spacing_eq]
    exact H.grad a ha μ
  · obtain ⟨a, rfl⟩ := g.surjective x
    have ha := (S.mem_Ω1 a).1 hx
    have e : (fun i => ∑ μ' : Fin d, (barField G' (S.sym D).Ψ (S.fld φ) (g a + Pi.single μ' 1) i +
        barField G' (S.sym D).Ψ (S.fld φ) (g a - Pi.single μ' 1) i -
        2 * barField G' (S.sym D).Ψ (S.fld φ) (g a) i)) =
        fun i => ∑ μ : Fin d, (barField G D.Ψ φ (a + Pi.single μ 1) i +
        barField G D.Ψ φ (a - Pi.single μ 1) i - 2 * barField G D.Ψ φ a i) := by
      funext i
      rw [← Equiv.sum_comp S.perm]
      refine Finset.sum_congr rfl fun μ _ => ?_
      have := S.bdry_swap (fun z => barField G' (S.sym D).Ψ (S.fld φ) z i) a μ
      rw [this]
      simp only [S.barField_sym]
    rw [e, S.spacing_eq]
    exact H.lap a ha
  · obtain ⟨a, rfl⟩ := S.Ω1Equiv.surjective y
    simpa [S.spacing_eq] using H.mult a
  · obtain ⟨a, rfl⟩ := g.surjective x
    have ha := (S.mem_Ω1 a).1 hx
    simp only [LatSymm.sym, Equiv.symm_apply_apply, S.blockAvg_sym φ ha]
    exact H.close a ha
  · obtain ⟨a, rfl⟩ := g.surjective z
    obtain ⟨b, rfl⟩ := g.surjective z'
    simp only [LatSymm.sym, Equiv.symm_apply_apply]
    exact H.collarBond a ((S.mem_collar a).1 hz) b ((S.mem_collar b).1 hz')
      ((S.adj_iff a b).1 hadj)
  · obtain ⟨a, rfl⟩ := S.Ω1Equiv.surjective z
    simpa [S.spacing_eq] using H.mass a


theorem xiCBounds_sym {ν σ ε : ℝ} {Dr Dc : BgData G N} {Ψ'' h'' : Torus d (N₀ * L ^ k) → Fin N → ℂ}
    {φr φc : G.Ω 1 × Fin N → ℂ} {αr αc : G.Ω 1 → ℂ}
    (H : XiCBounds G ν σ ε Dr Dc Ψ'' h'' φr φc αr αc) :
    XiCBounds G' ν σ ε (S.sym Dr) (S.sym Dc) (fun y => Ψ'' (g.symm y)) (fun y => h'' (g.symm y))
      (S.fld φr) (S.fld φc) (S.mul αr) (S.mul αc) := by
  refine
    { grad := fun x hx ν' => ?_
      lap := fun x hx => ?_
      mult := fun y => ?_
      val := fun y => ?_
      close := fun x hx => ?_
      collarBond := fun z hz z' hz' hadj => ?_
      hAbs := fun x hx => ?_
      hDot := fun y => ?_ }
  · obtain ⟨a, rfl⟩ := g.surjective x
    obtain ⟨μ, rfl⟩ := S.perm.surjective ν'
    have ha := (S.mem_Ω1 a).1 hx
    have := nbr_and_swap S (fun y => vn (fun i =>
      (barField G' (S.sym Dc).Ψ (S.fld φc) y i - barField G' (S.sym Dr).Ψ (S.fld φr) y i) -
      (barField G' (S.sym Dc).Ψ (S.fld φc) (g a) i - barField G' (S.sym Dr).Ψ (S.fld φr) (g a) i)) <
      σ * ε / G'.spacing (g a)) a μ
    refine this.2 ?_
    simp only [S.barField_sym, S.spacing_eq]
    exact H.grad a ha μ
  · obtain ⟨a, rfl⟩ := g.surjective x
    have ha := (S.mem_Ω1 a).1 hx
    have e : (fun i => ∑ μ' : Fin d,
        ((barField G' (S.sym Dc).Ψ (S.fld φc) (g a + Pi.single μ' 1) i -
          barField G' (S.sym Dr).Ψ (S.fld φr) (g a + Pi.single μ' 1) i) +
        (barField G' (S.sym Dc).Ψ (S.fld φc) (g a - Pi.single μ' 1) i -
          barField G' (S.sym Dr).Ψ (S.fld φr) (g a - Pi.single μ' 1) i) -
        2 * (barField G' (S.sym Dc).Ψ (S.fld φc) (g a) i -
          barField G' (S.sym Dr).Ψ (S.fld φr) (g a) i))) =
        fun i => ∑ μ : Fin d,
        ((barField G Dc.Ψ φc (a + Pi.single μ 1) i - barField G Dr.Ψ φr (a + Pi.single μ 1) i) +
        (barField G Dc.Ψ φc (a - Pi.single μ 1) i - barField G Dr.Ψ φr (a - Pi.single μ 1) i) -
        2 * (barField G Dc.Ψ φc a i - barField G Dr.Ψ φr a i)) := by
      funext i
      rw [← Equiv.sum_comp S.perm]
      refine Finset.sum_congr rfl fun μ _ => ?_
      have := S.bdry_swap (fun z => barField G' (S.sym Dc).Ψ (S.fld φc) z i -
        barField G' (S.sym Dr).Ψ (S.fld φr) z i) a μ
      rw [this]
      simp only [S.barField_sym]
    rw [e, S.spacing_eq]
    exact H.lap a ha
  · obtain ⟨a, rfl⟩ := S.Ω1Equiv.surjective y
    simpa [S.spacing_eq] using H.mult a
  · obtain ⟨a, rfl⟩ := S.Ω1Equiv.surjective y
    simpa using H.val a
  · obtain ⟨a, rfl⟩ := g.surjective x
    have ha := (S.mem_Ω1 a).1 hx
    rw [← LatSymm.fld_sub S]
    simp only [Equiv.symm_apply_apply, S.blockAvg_sym (φc - φr) ha]
    exact H.close a ha
  · obtain ⟨a, rfl⟩ := g.surjective z
    obtain ⟨b, rfl⟩ := g.surjective z'
    simp only [Equiv.symm_apply_apply]
    exact H.collarBond a ((S.mem_collar a).1 hz) b ((S.mem_collar b).1 hz')
      ((S.adj_iff a b).1 hadj)
  · obtain ⟨a, rfl⟩ := g.surjective x
    simp only [Equiv.symm_apply_apply, S.layerIndex_eq]
    exact H.hAbs a ((S.mem_Ω1 a).1 hx)
  · obtain ⟨a, rfl⟩ := S.Ω1Equiv.surjective y
    simpa [S.layerIndex_eq] using H.hDot a

theorem realizes_sym {D : BgData G N} {Ψ₀ : Torus d (N₀ * L ^ k) → Fin N → ℝ} {h₀ : Fin N → ℝ}
    (H : Realizes D Ψ₀ h₀) : Realizes (S.sym D) (fun y => Ψ₀ (g.symm y)) h₀ := by
  refine ⟨fun x hx i => ?_, fun x hx i => ?_⟩
  · obtain ⟨a, rfl⟩ := g.surjective x
    simp only [LatSymm.sym, Equiv.symm_apply_apply]
    exact H.1 a ((S.mem_dataSites a).1 hx) i
  · obtain ⟨a, rfl⟩ := g.surjective x
    simp only [LatSymm.sym, Equiv.symm_apply_apply]
    exact H.2 a ((S.mem_Ω1 a).1 hx) i

theorem realizesC_sym {D : BgData G N} {Ψ₀ : Torus d (N₀ * L ^ k) → Fin N → ℝ} {h₀ : Fin N → ℝ}
    {Ψ'' h'' : Torus d (N₀ * L ^ k) → Fin N → ℂ} (H : RealizesC D Ψ₀ h₀ Ψ'' h'') :
    RealizesC (S.sym D) (fun y => Ψ₀ (g.symm y)) h₀ (fun y => Ψ'' (g.symm y))
      (fun y => h'' (g.symm y)) := by
  refine ⟨fun x hx i => ?_, fun x hx i => ?_⟩
  · obtain ⟨a, rfl⟩ := g.surjective x
    simp only [LatSymm.sym, Equiv.symm_apply_apply]
    exact H.1 a ((S.mem_dataSites a).1 hx) i
  · obtain ⟨a, rfl⟩ := g.surjective x
    simp only [LatSymm.sym, Equiv.symm_apply_apply]
    exact H.2 a ((S.mem_Ω1 a).1 hx) i

end Domain

section Spaces

variable {G G' : GeneratingSet d L N₀ k ϱ} {g : Equiv.Perm (Torus d (N₀ * L ^ k))}
  (S : LatSymm G G' g) (a : ℕ → ℝ) (ν : ℝ)

include S

theorem xi_sym {n : ℕ} {σ ε : ℝ} {Ψ₀ : Torus d (N₀ * L ^ k) → Fin N → ℝ} {h₀ : Fin N → ℝ}
    (H : Xi G a ν n σ ε Ψ₀ h₀) : Xi G' a ν n σ ε (fun y => Ψ₀ (g.symm y)) h₀ := by
  obtain ⟨hσ, hε, D, hre, hdom, hb⟩ := H
  refine ⟨hσ, hε, S.sym D, realizes_sym S hre, inUnionDomainR_sym S hdom, ?_⟩
  rw [S.bgField_sym a ν D, S.bgMult_sym a ν D]
  exact xiBounds_sym S hb

/-- **Lattice-symmetry covariance of `Ξ_n(𝔹; σ, ε)`**: for a lattice symmetry `g` from `G` to
`G'`, `(Ψ₀ ∘ g⁻¹, h₀) ∈ Ξ_n(G'; σ, ε)` iff `(Ψ₀, h₀) ∈ Ξ_n(G; σ, ε)`. -/
theorem xi_sym_iff {n : ℕ} {σ ε : ℝ} {Ψ₀ : Torus d (N₀ * L ^ k) → Fin N → ℝ} {h₀ : Fin N → ℝ} :
    Xi G' a ν n σ ε (fun y => Ψ₀ (g.symm y)) h₀ ↔ Xi G a ν n σ ε Ψ₀ h₀ := by
  refine ⟨fun H => ?_, xi_sym S a ν⟩
  have := xi_sym S.symm a ν H
  simpa using this

theorem xiC_sym {n : ℕ} {σ ε : ℝ} {Ψ₀ : Torus d (N₀ * L ^ k) → Fin N → ℝ} {h₀ : Fin N → ℝ}
    {Ψ'' h'' : Torus d (N₀ * L ^ k) → Fin N → ℂ} (H : XiC G a ν n σ ε Ψ₀ h₀ Ψ'' h'') :
    XiC G' a ν n σ ε (fun y => Ψ₀ (g.symm y)) h₀ (fun y => Ψ'' (g.symm y))
      (fun y => h'' (g.symm y)) := by
  obtain ⟨hσ, hε, Dr, Dc, hr, hrc, hdom, hb⟩ := H
  refine ⟨hσ, hε, S.sym Dr, S.sym Dc, ?_, realizesC_sym S hrc, inUnionDomainC_sym S hdom, ?_⟩
  · obtain ⟨hre, hdomr, hbr⟩ := hr
    refine ⟨realizes_sym S hre, inUnionDomainR_sym S hdomr, ?_⟩
    rw [S.bgField_sym a ν Dr, S.bgMult_sym a ν Dr]
    exact xiBounds_sym S hbr
  · rw [S.bgField_sym a ν Dr, S.bgMult_sym a ν Dr, (S.bgFieldC_sym a ν _ Dc).1,
      (S.bgFieldC_sym a ν _ Dc).2]
    exact xiCBounds_sym S hb

/-- **Lattice-symmetry covariance of `Ξ^c_n(𝔹; σ, ε)`.** -/
theorem xiC_sym_iff {n : ℕ} {σ ε : ℝ} {Ψ₀ : Torus d (N₀ * L ^ k) → Fin N → ℝ} {h₀ : Fin N → ℝ}
    {Ψ'' h'' : Torus d (N₀ * L ^ k) → Fin N → ℂ} :
    XiC G' a ν n σ ε (fun y => Ψ₀ (g.symm y)) h₀ (fun y => Ψ'' (g.symm y))
      (fun y => h'' (g.symm y)) ↔ XiC G a ν n σ ε Ψ₀ h₀ Ψ'' h'' := by
  refine ⟨fun H => ?_, xiC_sym S a ν⟩
  have := xiC_sym S.symm a ν H
  simpa using this

end Spaces
end Balaban.SmallField

namespace Balaban.SmallField.Def6
open Balaban Balaban.Multiscale Balaban.Background Balaban.Localization Finset
variable {d L N₁ m₁ k : ℕ} [NeZero L] [NeZero N₁] {ϱ : ℝ}

omit [NeZero L] [NeZero N₁] in
theorem dvd_val_natCast {j s : ℕ} (hjk : j ≤ k) (hs : L ^ j ∣ s) :
    L ^ j ∣ (((s : ℕ) : ZMod (N₁ * L ^ m₁ * L ^ k))).val := by
  rw [ZMod.val_natCast]
  refine (Nat.dvd_mod_iff ?_).2 hs
  exact (pow_dvd_pow L hjk).trans (dvd_mul_left _ _)

/-- Translation by `s` (`L ^ j ∣ s`, `j ≤ k`) is a symmetry of the paved torus up to scale `j`. -/
def torusSymm_transBy {j s : ℕ} (hjk : j ≤ k) (hs : L ^ j ∣ s) (μ : Fin d) :
    TorusSymm (N₀ := N₁ * L ^ m₁) j (transBy (N₁ := N₁) (m₁ := m₁) (k := k) (L := L) s μ) :=
  TorusSymm.ofTranslate j _ (fun μ' => by
    by_cases h : μ' = μ
    · subst h
      simpa using dvd_val_natCast (L := L) (N₁ := N₁) (m₁ := m₁) (k := k) hjk hs
    · simp [h])

omit [NeZero L] [NeZero N₁] in
theorem flipBy_eq (s : ℕ) (μ : Fin d) :
    flipBy (N₁ := N₁) (m₁ := m₁) (k := k) (L := L) s μ =
      reflPerm (N₀ := N₁ * L ^ m₁) μ ((s : ℕ) : ZMod (N₁ * L ^ m₁ * L ^ k)) :=
  Equiv.ext fun _ => rfl

/-- The reflection `x_μ ↦ s - 1 - x_μ` (`L ^ j ∣ s`, `j ≤ k`) is a symmetry of the paved torus up to
scale `j`. -/
def torusSymm_flipBy {j s : ℕ} (hjk : j ≤ k) (hs : L ^ j ∣ s) (μ : Fin d) :
    TorusSymm (N₀ := N₁ * L ^ m₁) j (flipBy (N₁ := N₁) (m₁ := m₁) (k := k) (L := L) s μ) := by
  rw [flipBy_eq]
  exact TorusSymm.ofReflect j μ _ (dvd_val_natCast hjk hs)

omit [NeZero L] [NeZero N₁] in
theorem swapJ_eq (μ ν : Fin d) :
    swapJ (N₁ := N₁) (m₁ := m₁) (k := k) (L := L) μ ν =
      coordPerm (N₀ := N₁ * L ^ m₁) (Equiv.swap μ ν) :=
  Equiv.ext fun x => by funext i; simp [swapJ, coordPerm]

/-- The coordinate exchanges are symmetries of the paved torus. -/
def torusSymm_swapJ (j : ℕ) (μ ν : Fin d) :
    TorusSymm (N₀ := N₁ * L ^ m₁) j (swapJ (N₁ := N₁) (m₁ := m₁) (k := k) (L := L) μ ν) := by
  rw [swapJ_eq]
  exact TorusSymm.ofCoordPerm j _

/-- **Every element of the group `symGroupBy s` generated by the translations by `s`, the
reflections `x_μ ↦ s - 1 - x_μ` and the coordinate exchanges, `L ^ j ∣ s`, `j ≤ k`, is a symmetry
of the paved torus up to scale `j`.**  In particular this applies to `fullJSymGroup L j`
(`s = L ^ j`) and to `pavingSymGroup L m₀ j` (`s = L ^ (j + m₀ + m₁)`). -/
theorem nonempty_torusSymm_of_mem_symGroupBy {j s : ℕ} (hjk : j ≤ k) (hs : L ^ j ∣ s)
    {g : Equiv.Perm (CTorus d L N₁ m₁ k)} (hg : g ∈ symGroupBy (N₁ := N₁) (m₁ := m₁) (k := k) s) :
    Nonempty (TorusSymm (N₀ := N₁ * L ^ m₁) j g) := by
  refine Subgroup.closure_induction
    (p := fun g _ => Nonempty (TorusSymm (N₀ := N₁ * L ^ m₁) j g)) ?_ ?_ ?_ ?_ hg
  · rintro g ((⟨μ, rfl⟩ | ⟨μ, rfl⟩) | ⟨μ, ν, rfl⟩)
    · exact ⟨torusSymm_transBy hjk hs μ⟩
    · exact ⟨torusSymm_flipBy hjk hs μ⟩
    · exact ⟨torusSymm_swapJ j μ ν⟩
  · exact ⟨TorusSymm.refl j⟩
  · rintro g h - - ⟨S⟩ ⟨S'⟩
    exact ⟨by rw [Equiv.Perm.mul_def]; exact S'.trans S⟩
  · rintro g - ⟨S⟩
    exact ⟨by rw [Equiv.Perm.inv_def]; exact S.symm⟩

theorem nonempty_torusSymm_of_mem_fullJSymGroup {j : ℕ} (hjk : j ≤ k)
    {g : Equiv.Perm (CTorus d L N₁ m₁ k)}
    (hg : g ∈ fullJSymGroup (N₁ := N₁) (m₁ := m₁) (k := k) (d := d) L j) :
    Nonempty (TorusSymm (N₀ := N₁ * L ^ m₁) j g) :=
  nonempty_torusSymm_of_mem_symGroupBy hjk dvd_rfl hg

theorem nonempty_torusSymm_of_mem_pavingSymGroup {j : ℕ} (m₀ : ℕ) (hjk : j ≤ k)
    {g : Equiv.Perm (CTorus d L N₁ m₁ k)}
    (hg : g ∈ pavingSymGroup (N₁ := N₁) (m₁ := m₁) (k := k) (d := d) L m₀ j) :
    Nonempty (TorusSymm (N₀ := N₁ * L ^ m₁) j g) :=
  nonempty_torusSymm_of_mem_symGroupBy hjk (pow_dvd_pow L (by omega)) hg

/-- The only layer of the whole-lattice generating set `levelGS j` is the layer `j`. -/
theorem levelGS_layer_nonempty {j : ℕ} (hj : j ≤ k) {n : ℕ}
    (h : ((levelGS (d := d) (L := L) (N₁ := N₁) (m₁ := m₁) (k := k) (ϱ := ϱ) j hj).layer n).Nonempty) :
    n = j := by
  classical
  obtain ⟨x, hx⟩ := h
  rw [GeneratingSet.mem_layer] at hx
  simp only [levelGS] at hx
  by_cases h1 : n ≤ j
  · by_cases h2 : n + 1 ≤ j
    · simp [h2] at hx
    · omega
  · simp [h1] at hx

/-- **Every element of `symGroupBy s`, `L ^ j ∣ s`, `j ≤ k`, is a lattice symmetry of the
whole-lattice generating set `levelGS j`** (whose `Ω_i` are `𝕋` or `∅`, hence preserved by every
permutation of the torus): all the covariance theorems for `bgField`, `bgFieldC`, `Ξ`, `Ξ^c` apply
to it. -/
theorem nonempty_latSymm_levelGS {j s : ℕ} (hjk : j ≤ k) (hs : L ^ j ∣ s)
    {g : Equiv.Perm (CTorus d L N₁ m₁ k)} (hg : g ∈ symGroupBy (N₁ := N₁) (m₁ := m₁) (k := k) s) :
    Nonempty (LatSymm (levelGS (d := d) (L := L) (N₁ := N₁) (m₁ := m₁) (k := k) (ϱ := ϱ) j hjk)
      (levelGS (d := d) (L := L) (N₁ := N₁) (m₁ := m₁) (k := k) (ϱ := ϱ) j hjk) g) := by
  obtain ⟨T⟩ := nonempty_torusSymm_of_mem_symGroupBy hjk hs hg
  refine ⟨LatSymm.ofTorusSymm T (fun i _ _ x => ?_) (fun n _ _ hne => (levelGS_layer_nonempty hjk hne).le)⟩
  simp only [levelGS]
  split_ifs <;> simp

end Balaban.SmallField.Def6
