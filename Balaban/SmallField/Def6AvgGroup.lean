module

public import Balaban.SmallField.Def6BridgeInfMoment

/-!
# Reynolds averaging over paving offsets: the symmetry groups of the fine lattice `ℤ^d`

CLASS-RULINGS Q-A, "Proof and repair of the centred I-6 symmetry".  The groups act on the fine
lattice `ℤ^d`:

* `symZ s`: generated by the translations by `s e_μ`, the reflections `x_μ ↦ s - 1 - x_μ` and the
  coordinate exchanges (`fullJSymGroup` for `s = L^j`, `pavingSymGroup` for `s = L^j L^{m₀+m₁}`
  on the torus; `exists_torus_lift` realizes every element on every torus);
* `symZ_decomp`: `symZ W = symZ (W Mb) · {translations by W a, a ∈ [0, Mb)^d}`: the paving offsets
  are a finite system of coset representatives (`finite_quotient`);
* `blkZ`: the induced action on the `W`-blocks (`blkZ_spec`, `blkZ_mul`);
* `reynolds`: the abstract Reynolds average over `Γ ⧸ K` with the fixed representatives
  `Quotient.out`, invariant under all of `Γ` (`reynolds_act`) and independent of the choice of
  representatives (`reynolds_rep`).
-/

@[expose] public section

namespace Balaban.SmallField.Def6

open Balaban Balaban.Multiscale Balaban.Localization

section Group
variable {d : ℕ}

/-- Translation of the fine lattice `ℤ^d` by a vector. -/
def tV (v : Fin d → ℤ) : Equiv.Perm (Fin d → ℤ) := Equiv.addRight v

/-- Translation by `s e_μ`. -/
def tZ (s : ℤ) (μ : Fin d) : Equiv.Perm (Fin d → ℤ) := tV (s • (Pi.single μ (1 : ℤ)))

/-- The reflection `x_μ ↦ s - 1 - x_μ`. -/
def fZ (s : ℤ) (μ : Fin d) : Equiv.Perm (Fin d → ℤ) where
  toFun x := Function.update x μ (s - 1 - x μ)
  invFun x := Function.update x μ (s - 1 - x μ)
  left_inv x := by ext i; by_cases h : i = μ <;> simp [h]
  right_inv x := by ext i; by_cases h : i = μ <;> simp [h]

/-- The exchange of two coordinates. -/
def sZ (μ ν : Fin d) : Equiv.Perm (Fin d → ℤ) where
  toFun x := x ∘ Equiv.swap μ ν
  invFun x := x ∘ Equiv.swap μ ν
  left_inv x := by ext i; simp
  right_inv x := by ext i; simp

/-- The group generated by the translations by `s`, the reflections `x_μ ↦ s - 1 - x_μ` and the
coordinate exchanges of the fine lattice `ℤ^d`. -/
def symZ (s : ℕ) : Subgroup (Equiv.Perm (Fin d → ℤ)) :=
  Subgroup.closure ({g | ∃ μ, g = tZ (s : ℤ) μ} ∪ {g | ∃ μ, g = fZ (s : ℤ) μ} ∪
    {g | ∃ μ ν, g = sZ μ ν})

theorem tV_apply (v x : Fin d → ℤ) : tV v x = x + v := rfl

theorem tV_add (u v : Fin d → ℤ) : tV (u + v) = tV u * tV v := by
  ext x μ; simp [tV_apply, Equiv.Perm.mul_apply]; ring

theorem tV_inv (v : Fin d → ℤ) : (tV v)⁻¹ = tV (-v) := by
  ext x μ; simp [tV, Equiv.Perm.inv_def]

theorem tV_zero : tV (0 : Fin d → ℤ) = 1 := by
  ext x μ; simp [tV_apply]

theorem fZ_apply (s : ℤ) (μ : Fin d) (x : Fin d → ℤ) :
    fZ s μ x = Function.update x μ (s - 1 - x μ) := rfl

theorem fZ_inv (s : ℤ) (μ : Fin d) : (fZ s μ)⁻¹ = fZ s μ := by
  ext x i; simp [Equiv.Perm.inv_def, fZ]

theorem sZ_inv (μ ν : Fin d) : (sZ μ ν)⁻¹ = sZ μ ν := by
  ext x i; simp [Equiv.Perm.inv_def, sZ]

theorem sZ_apply (μ ν : Fin d) (x : Fin d → ℤ) : sZ μ ν x = x ∘ Equiv.swap μ ν := rfl


theorem tZ_mem (s : ℕ) (μ : Fin d) : tZ (s : ℤ) μ ∈ symZ (d := d) s :=
  Subgroup.subset_closure (Or.inl (Or.inl ⟨μ, rfl⟩))

theorem fZ_mem (s : ℕ) (μ : Fin d) : fZ (s : ℤ) μ ∈ symZ (d := d) s :=
  Subgroup.subset_closure (Or.inl (Or.inr ⟨μ, rfl⟩))

theorem sZ_mem (s : ℕ) (μ ν : Fin d) : sZ μ ν ∈ symZ (d := d) s :=
  Subgroup.subset_closure (Or.inr ⟨μ, ν, rfl⟩)

theorem tZ_eq_tV (s : ℤ) (μ : Fin d) : tZ s μ = tV (s • (Pi.single μ (1 : ℤ))) := rfl

/-- The translation by `W a` for `a : Fin d → Fin Mb`. -/
def tA (W Mb : ℕ) (a : Fin d → Fin Mb) : Equiv.Perm (Fin d → ℤ) :=
  tV (fun μ => (W : ℤ) * ((a μ : ℕ) : ℤ))

theorem tV_smul_single_mem (W : ℕ) (n : ℕ) (μ : Fin d) :
    tV ((n : ℤ) • ((W : ℤ) • (Pi.single μ (1 : ℤ)))) ∈ symZ (d := d) W := by
  induction n with
  | zero => simp [tV_zero, (symZ (d := d) W).one_mem]
  | succ n ih =>
    have : tV (((n + 1 : ℕ) : ℤ) • ((W : ℤ) • (Pi.single μ (1 : ℤ)))) =
        tV (((n : ℕ) : ℤ) • ((W : ℤ) • (Pi.single μ (1 : ℤ)))) * tZ (W : ℤ) μ := by
      rw [tZ_eq_tV, ← tV_add]; congr 1; push_cast; rw [add_smul, one_smul]
    rw [this]; exact (symZ (d := d) W).mul_mem ih (tZ_mem W μ)


theorem tA_apply (W Mb : ℕ) (a : Fin d → Fin Mb) (x : Fin d → ℤ) (ν : Fin d) :
    tA W Mb a x ν = x ν + (W : ℤ) * ((a ν : ℕ) : ℤ) := rfl

theorem tZ_apply (s : ℤ) (μ : Fin d) (x : Fin d → ℤ) (ν : Fin d) :
    tZ s μ x ν = x ν + s * (Pi.single μ (1 : ℤ) : Fin d → ℤ) ν := by
  simp [tZ, tV_apply]

theorem tA_mul_tZ_lt {W Mb : ℕ} (a : Fin d → Fin Mb) (μ : Fin d) (hlt : (a μ : ℕ) + 1 < Mb) :
    tA W Mb a * tZ (W : ℤ) μ = tA W Mb (Function.update a μ ⟨(a μ : ℕ) + 1, hlt⟩) := by
  ext x ν
  simp only [Equiv.Perm.mul_apply, tA_apply, tZ_apply]
  by_cases h : ν = μ
  · subst h; simp; ring
  · simp [h]

theorem tA_mul_tZ_ge {W Mb : ℕ} (a : Fin d → Fin Mb) (μ : Fin d) (hMb : 0 < Mb)
    (hge : ¬ (a μ : ℕ) + 1 < Mb) :
    tA W Mb a * tZ (W : ℤ) μ = tZ ((W * Mb : ℕ) : ℤ) μ * tA W Mb (Function.update a μ ⟨0, hMb⟩) := by
  ext x ν
  simp only [Equiv.Perm.mul_apply, tA_apply, tZ_apply]
  by_cases h : ν = μ
  · subst h
    have : (a ν : ℕ) + 1 = Mb := by have := (a ν).2; omega
    simp
    have h2 : ((a ν : ℕ) : ℤ) + 1 = Mb := by exact_mod_cast this
    have : (W : ℤ) * ((a ν : ℕ) : ℤ) + W = W * Mb := by rw [← h2]; ring
    linarith
  · simp [h]

theorem tA_mul_tZ_inv_pos {W Mb : ℕ} (a : Fin d → Fin Mb) (μ : Fin d) (hpos : 0 < (a μ : ℕ)) :
    tA W Mb a * (tZ (W : ℤ) μ)⁻¹ =
      tA W Mb (Function.update a μ ⟨(a μ : ℕ) - 1, by have := (a μ).2; omega⟩) := by
  ext x ν
  have hz : (tZ (W : ℤ) μ)⁻¹ = tZ (-(W : ℤ)) μ := by
    rw [tZ_eq_tV, tZ_eq_tV, tV_inv]; congr 1; ext ν; simp
  rw [hz]
  simp only [Equiv.Perm.mul_apply, tA_apply, tZ_apply]
  by_cases h : ν = μ
  · subst h
    simp
    have : (((a ν : ℕ) - 1 : ℕ) : ℤ) = ((a ν : ℕ) : ℤ) - 1 := by omega
    rw [this]; ring
  · simp [h]

theorem tA_mul_tZ_inv_zero {W Mb : ℕ} (a : Fin d → Fin Mb) (μ : Fin d) (hMb : 0 < Mb)
    (hz : (a μ : ℕ) = 0) :
    tA W Mb a * (tZ (W : ℤ) μ)⁻¹ = (tZ ((W * Mb : ℕ) : ℤ) μ)⁻¹ *
      tA W Mb (Function.update a μ ⟨Mb - 1, by omega⟩) := by
  ext x ν
  have hz1 : (tZ (W : ℤ) μ)⁻¹ = tZ (-(W : ℤ)) μ := by
    rw [tZ_eq_tV, tZ_eq_tV, tV_inv]; congr 1; ext ν; simp
  have hz2 : (tZ ((W * Mb : ℕ) : ℤ) μ)⁻¹ = tZ (-((W * Mb : ℕ) : ℤ)) μ := by
    rw [tZ_eq_tV, tZ_eq_tV, tV_inv]; congr 1; ext ν; simp
  rw [hz1, hz2]
  simp only [Equiv.Perm.mul_apply, tA_apply, tZ_apply]
  by_cases h : ν = μ
  · subst h
    simp [hz]
    have : (((Mb - 1 : ℕ)) : ℤ) = (Mb : ℤ) - 1 := by omega
    rw [this]; ring
  · simp [h]

theorem tA_mul_fZ {W Mb : ℕ} (a : Fin d → Fin Mb) (μ : Fin d) :
    tA W Mb a * fZ (W : ℤ) μ = fZ ((W * Mb : ℕ) : ℤ) μ *
      tA W Mb (Function.update a μ ⟨Mb - 1 - (a μ : ℕ), by omega⟩) := by
  ext x ν
  simp only [Equiv.Perm.mul_apply, tA_apply, fZ_apply]
  by_cases h : ν = μ
  · subst h
    have h1 : ((Mb - 1 - (a ν : ℕ) : ℕ) : ℤ) = (Mb : ℤ) - 1 - (a ν : ℕ) := by
      have := (a ν).2; omega
    simp [h1]; ring
  · simp [h, tA_apply]

theorem tA_mul_sZ {W Mb : ℕ} (a : Fin d → Fin Mb) (μ ν : Fin d) :
    tA W Mb a * sZ μ ν = sZ μ ν * tA W Mb (a ∘ Equiv.swap μ ν) := by
  ext x i
  simp [Equiv.Perm.mul_apply, tA_apply, sZ_apply]


/-- **Every element of `symZ W` is `h * tA a` with `h ∈ symZ (W * Mb)`** (the paving offsets). -/
theorem symZ_decomp {W Mb : ℕ} (hMb : 0 < Mb) {g : Equiv.Perm (Fin d → ℤ)}
    (hg : g ∈ symZ (d := d) W) :
    ∃ h ∈ symZ (d := d) (W * Mb), ∃ a : Fin d → Fin Mb, g = h * tA W Mb a := by
  refine Subgroup.closure_induction_right
    (p := fun g _ => ∃ h ∈ symZ (d := d) (W * Mb), ∃ a : Fin d → Fin Mb, g = h * tA W Mb a)
    ⟨1, (symZ (d := d) (W * Mb)).one_mem, fun _ => ⟨0, hMb⟩, ?_⟩ ?_ ?_ hg
  · ext x μ; simp [tA_apply]
  · rintro x hx y hy ⟨h, hh, a, rfl⟩
    rcases hy with (⟨μ, rfl⟩ | ⟨μ, rfl⟩) | ⟨μ, ν, rfl⟩
    · by_cases hlt : (a μ : ℕ) + 1 < Mb
      · exact ⟨h, hh, _, by rw [mul_assoc, tA_mul_tZ_lt a μ hlt]⟩
      · exact ⟨h * tZ ((W * Mb : ℕ) : ℤ) μ, (symZ (d := d) (W * Mb)).mul_mem hh (tZ_mem _ μ), _,
          by rw [mul_assoc, tA_mul_tZ_ge a μ hMb hlt, mul_assoc]⟩
    · exact ⟨h * fZ ((W * Mb : ℕ) : ℤ) μ, (symZ (d := d) (W * Mb)).mul_mem hh (fZ_mem _ μ), _,
        by rw [mul_assoc, tA_mul_fZ a μ, mul_assoc]⟩
    · exact ⟨h * sZ μ ν, (symZ (d := d) (W * Mb)).mul_mem hh (sZ_mem _ μ ν), _,
        by rw [mul_assoc, tA_mul_sZ, mul_assoc]⟩
  · rintro x hx y hy ⟨h, hh, a, rfl⟩
    rcases hy with (⟨μ, rfl⟩ | ⟨μ, rfl⟩) | ⟨μ, ν, rfl⟩
    · by_cases hpos : 0 < (a μ : ℕ)
      · exact ⟨h, hh, _, by rw [mul_assoc, tA_mul_tZ_inv_pos a μ hpos]⟩
      · exact ⟨h * (tZ ((W * Mb : ℕ) : ℤ) μ)⁻¹,
          (symZ (d := d) (W * Mb)).mul_mem hh ((symZ (d := d) (W * Mb)).inv_mem (tZ_mem _ μ)), _,
          by rw [mul_assoc, tA_mul_tZ_inv_zero a μ hMb (by omega), mul_assoc]⟩
    · rw [fZ_inv]
      exact ⟨h * fZ ((W * Mb : ℕ) : ℤ) μ, (symZ (d := d) (W * Mb)).mul_mem hh (fZ_mem _ μ), _,
        by rw [mul_assoc, tA_mul_fZ a μ, mul_assoc]⟩
    · rw [sZ_inv]
      exact ⟨h * sZ μ ν, (symZ (d := d) (W * Mb)).mul_mem hh (sZ_mem _ μ ν), _,
        by rw [mul_assoc, tA_mul_sZ, mul_assoc]⟩


theorem symZ_mono {W Mb : ℕ} (hMb : 0 < Mb) : symZ (d := d) (W * Mb) ≤ symZ (d := d) W := by
  rw [symZ, Subgroup.closure_le]
  rintro g ((⟨μ, rfl⟩ | ⟨μ, rfl⟩) | ⟨μ, ν, rfl⟩)
  · have := tV_smul_single_mem (d := d) W Mb μ
    have e : tZ ((W * Mb : ℕ) : ℤ) μ = tV ((Mb : ℤ) • ((W : ℤ) • (Pi.single μ (1 : ℤ)))) := by
      rw [tZ_eq_tV, smul_smul]; congr 2; push_cast; ring
    rw [SetLike.mem_coe, e]; exact this
  · have h1 := tV_smul_single_mem (d := d) W (Mb - 1) μ
    have e : fZ ((W * Mb : ℕ) : ℤ) μ =
        tV ((((Mb - 1 : ℕ)) : ℤ) • ((W : ℤ) • (Pi.single μ (1 : ℤ)))) * fZ (W : ℤ) μ := by
      ext x ν
      simp only [Equiv.Perm.mul_apply, tV_apply, fZ_apply]
      by_cases h : ν = μ
      · subst h
        have : (((Mb - 1 : ℕ)) : ℤ) = (Mb : ℤ) - 1 := by omega
        simp [this]; ring
      · simp [h]
    rw [SetLike.mem_coe, e]; exact (symZ (d := d) W).mul_mem h1 (fZ_mem W μ)
  · exact sZ_mem W μ ν

/-! ### Blocks -/

/-- The block (floor division by `W`) of a fine site. -/
def bW (W : ℕ) (x : Fin d → ℤ) : Fin d → ℤ := fun μ => x μ / (W : ℤ)

/-- The corner of a block. -/
def ibZ (W : ℕ) (b : Fin d → ℤ) : Fin d → ℤ := fun μ => (W : ℤ) * b μ

/-- The block map induced by a permutation of the fine lattice. -/
def blkZ (W : ℕ) (g : Equiv.Perm (Fin d → ℤ)) (b : Fin d → ℤ) : Fin d → ℤ := bW W (g (ibZ W b))

theorem bW_ibZ {W : ℕ} (hW : 0 < W) (b : Fin d → ℤ) : bW W (ibZ W b) = b := by
  funext μ; simp [bW, ibZ, Int.mul_ediv_cancel_left _ (by exact_mod_cast hW.ne' : (W : ℤ) ≠ 0)]

theorem bW_ibZ_bW {W : ℕ} (hW : 0 < W) (x : Fin d → ℤ) : bW W (ibZ W (bW W x)) = bW W x :=
  bW_ibZ hW _

theorem bW_add_dvd {W : ℕ} (x v : Fin d → ℤ) (hv : ∀ μ, (W : ℤ) ∣ v μ) :
    bW W (x + v) = bW W x + bW W v := by
  funext μ; simp [bW, Int.add_ediv_of_dvd_right (hv μ)]

theorem bW_neg_dvd {W : ℕ} (x v : Fin d → ℤ) (hv : ∀ μ, (W : ℤ) ∣ v μ) :
    bW W (x + -v) = bW W x + -bW W v := by
  rw [bW_add_dvd x (-v) (fun μ => by simpa using (hv μ).neg_right)]
  funext μ; simp [bW, Int.neg_ediv_of_dvd (hv μ)]

theorem bW_fZ {W : ℕ} (hW : 0 < W) (u : ℕ) (μ : Fin d) (x : Fin d → ℤ) :
    bW W (fZ ((W * u : ℕ) : ℤ) μ x) = fZ (u : ℤ) μ (bW W x) := by
  funext ν
  by_cases h : ν = μ
  · subst h
    simp only [bW, fZ_apply, Function.update_self]
    have hW0 : (W : ℤ) ≠ 0 := by exact_mod_cast hW.ne'
    have hq := Int.emod_add_mul_ediv (x ν) (W : ℤ)
    have h0 := Int.emod_nonneg (x ν) hW0
    have h1 := Int.emod_lt_of_pos (x ν) (by exact_mod_cast hW : (0 : ℤ) < W)
    set q := x ν / (W : ℤ)
    set r := x ν % (W : ℤ)
    have : ((W * u : ℕ) : ℤ) - 1 - x ν = (W : ℤ) * ((u : ℤ) - 1 - q) + ((W : ℤ) - 1 - r) := by
      rw [← hq]; push_cast; ring
    rw [this, Int.mul_add_ediv_left _ _ hW0, Int.ediv_eq_zero_of_lt (by omega) (by omega)]
    ring
  · simp [bW, fZ_apply, h]

theorem bW_sZ {W : ℕ} (μ ν : Fin d) (x : Fin d → ℤ) :
    bW W (sZ μ ν x) = sZ μ ν (bW W x) := by
  funext i; simp [bW, sZ_apply]

theorem bW_tZ {W : ℕ} (hW : 0 < W) (u : ℕ) (μ : Fin d) (x : Fin d → ℤ) :
    bW W (tZ ((W * u : ℕ) : ℤ) μ x) = tZ (u : ℤ) μ (bW W x) := by
  have hW0 : (W : ℤ) ≠ 0 := by exact_mod_cast hW.ne'
  rw [tZ_eq_tV, tV_apply, bW_add_dvd _ _ (fun ν => by
    simp only [Pi.smul_apply, smul_eq_mul]
    exact Dvd.dvd.mul_right (by push_cast; exact dvd_mul_right _ _) _)]
  funext ν
  by_cases h : ν = μ
  · subst h
    simp [bW, tZ_apply]
    rw [Int.mul_ediv_cancel_left _ hW0]
  · simp [bW, tZ_apply, h]

/-- A permutation of the fine lattice in `symZ (W * u)` acts on `W`-blocks through an element of
`symZ u`. -/
theorem exists_block_map {W : ℕ} (hW : 0 < W) (u : ℕ) {g : Equiv.Perm (Fin d → ℤ)}
    (hg : g ∈ symZ (d := d) (W * u)) :
    ∃ g' ∈ symZ (d := d) u, ∀ x, bW W (g x) = g' (bW W x) := by
  refine Subgroup.closure_induction
    (p := fun g _ => ∃ g' ∈ symZ (d := d) u, ∀ x, bW W (g x) = g' (bW W x)) ?_ ?_ ?_ ?_ hg
  · rintro g ((⟨μ, rfl⟩ | ⟨μ, rfl⟩) | ⟨μ, ν, rfl⟩)
    · exact ⟨tZ (u : ℤ) μ, tZ_mem u μ, bW_tZ hW u μ⟩
    · exact ⟨fZ (u : ℤ) μ, fZ_mem u μ, bW_fZ hW u μ⟩
    · exact ⟨sZ μ ν, sZ_mem u μ ν, bW_sZ μ ν⟩
  · exact ⟨1, (symZ (d := d) u).one_mem, fun x => rfl⟩
  · rintro g g' - - ⟨a, ha, hga⟩ ⟨b, hb, hgb⟩
    exact ⟨a * b, (symZ (d := d) u).mul_mem ha hb, fun x => by
      simp [Equiv.Perm.mul_apply, hgb, hga]⟩
  · rintro g - ⟨a, ha, hga⟩
    refine ⟨a⁻¹, (symZ (d := d) u).inv_mem ha, fun x => ?_⟩
    have := hga (g⁻¹ x)
    rw [show g (g⁻¹ x) = x from by simp] at this
    rw [this]; simp


theorem blkZ_spec {W s : ℕ} (hW : 0 < W) (hs : W ∣ s) {g : Equiv.Perm (Fin d → ℤ)}
    (hg : g ∈ symZ (d := d) s) (x : Fin d → ℤ) : bW W (g x) = blkZ W g (bW W x) := by
  obtain ⟨u, rfl⟩ := hs
  obtain ⟨g', -, hg'⟩ := exists_block_map hW u hg
  have : blkZ W g (bW W x) = g' (bW W x) := by
    unfold blkZ; rw [hg', bW_ibZ hW]
  rw [this, hg']

theorem blkZ_mul {W s : ℕ} (hW : 0 < W) (hs : W ∣ s) {g g' : Equiv.Perm (Fin d → ℤ)}
    (hg : g ∈ symZ (d := d) s) (b : Fin d → ℤ) :
    blkZ W (g * g') b = blkZ W g (blkZ W g' b) := by
  unfold blkZ
  rw [Equiv.Perm.mul_apply, blkZ_spec hW hs hg]
  rfl

theorem blkZ_one {W : ℕ} (hW : 0 < W) (b : Fin d → ℤ) : blkZ W 1 b = b := by
  simp [blkZ, bW_ibZ hW]

theorem blkZ_inv_blkZ {W s : ℕ} (hW : 0 < W) (hs : W ∣ s) {g : Equiv.Perm (Fin d → ℤ)}
    (hg : g ∈ symZ (d := d) s) (b : Fin d → ℤ) : blkZ W g⁻¹ (blkZ W g b) = b := by
  rw [← blkZ_mul hW hs ((symZ (d := d) s).inv_mem hg), inv_mul_cancel, blkZ_one hW]

theorem blkZ_blkZ_inv {W s : ℕ} (hW : 0 < W) (hs : W ∣ s) {g : Equiv.Perm (Fin d → ℤ)}
    (hg : g ∈ symZ (d := d) s) (b : Fin d → ℤ) : blkZ W g (blkZ W g⁻¹ b) = b := by
  have := blkZ_inv_blkZ hW hs ((symZ (d := d) s).inv_mem hg) b
  simpa using this

theorem blkZ_injective {W s : ℕ} (hW : 0 < W) (hs : W ∣ s) {g : Equiv.Perm (Fin d → ℤ)}
    (hg : g ∈ symZ (d := d) s) : Function.Injective (blkZ W g) :=
  Function.LeftInverse.injective (blkZ_inv_blkZ hW hs hg)

theorem blkZ_tA {W Mb : ℕ} (hW : 0 < W) (a : Fin d → Fin Mb) (b : Fin d → ℤ) :
    blkZ W (tA W Mb a) b = b + fun μ => ((a μ : ℕ) : ℤ) := by
  funext μ
  simp [blkZ, bW, ibZ, tA_apply, Int.mul_ediv_cancel_left _ (by exact_mod_cast hW.ne' : (W : ℤ) ≠ 0),
    ← mul_add]

end Group

section Torus

variable {d L N₁ m₁ k : ℕ} [NeZero L] [NeZero N₁]

omit [NeZero L] [NeZero N₁] in
theorem toTorus_smul_single (s : ℤ) (μ : Fin d) :
    toTorus L N₁ m₁ k (s • (Pi.single μ (1 : ℤ))) =
      ((s : ZMod (N₁ * L ^ m₁ * L ^ k)) • (Pi.single μ 1 : CTorus d L N₁ m₁ k)) := by
  funext ν
  by_cases h : ν = μ
  · subst h; simp [toTorus]
  · simp [toTorus, h]

omit [NeZero L] [NeZero N₁] in
theorem transBy_toTorus (s : ℕ) (μ : Fin d) (x : Fin d → ℤ) :
    transBy (N₁ := N₁) (m₁ := m₁) (k := k) (L := L) s μ (toTorus L N₁ m₁ k x) =
      toTorus L N₁ m₁ k (tZ (s : ℤ) μ x) := by
  funext ν
  by_cases h : ν = μ
  · subst h; simp [transBy, tZ_apply, toTorus]
  · simp [transBy, tZ_apply, toTorus, h]

omit [NeZero L] [NeZero N₁] in
theorem flipBy_toTorus (s : ℕ) (μ : Fin d) (x : Fin d → ℤ) :
    flipBy (N₁ := N₁) (m₁ := m₁) (k := k) (L := L) s μ (toTorus L N₁ m₁ k x) =
      toTorus L N₁ m₁ k (fZ (s : ℤ) μ x) := by
  funext ν
  by_cases h : ν = μ
  · subst h; simp [flipBy, fZ_apply, toTorus]
  · simp [flipBy, fZ_apply, toTorus, h]

omit [NeZero L] [NeZero N₁] in
theorem swapJ_toTorus (μ ν : Fin d) (x : Fin d → ℤ) :
    swapJ (N₁ := N₁) (m₁ := m₁) (k := k) (L := L) μ ν (toTorus L N₁ m₁ k x) =
      toTorus L N₁ m₁ k (sZ μ ν x) := by
  funext i; simp [swapJ, sZ_apply, toTorus]

omit [NeZero L] [NeZero N₁] in
/-- **Every element of `symZ s` is realized on the torus by an element of `symGroupBy s`**: the
fine-lattice maps intertwine with `toTorus`. -/
theorem exists_torus_lift {s : ℕ} {g : Equiv.Perm (Fin d → ℤ)} (hg : g ∈ symZ (d := d) s) :
    ∃ gb ∈ symGroupBy (d := d) (L := L) (N₁ := N₁) (m₁ := m₁) (k := k) s,
      ∀ x, gb (toTorus L N₁ m₁ k x) = toTorus L N₁ m₁ k (g x) := by
  refine Subgroup.closure_induction
    (p := fun g _ => ∃ gb ∈ symGroupBy (d := d) (L := L) (N₁ := N₁) (m₁ := m₁) (k := k) s,
      ∀ x, gb (toTorus L N₁ m₁ k x) = toTorus L N₁ m₁ k (g x)) ?_ ?_ ?_ ?_ hg
  · rintro g ((⟨μ, rfl⟩ | ⟨μ, rfl⟩) | ⟨μ, ν, rfl⟩)
    · exact ⟨transBy s μ, Subgroup.subset_closure (Or.inl (Or.inl ⟨μ, rfl⟩)),
        fun x => transBy_toTorus s μ x⟩
    · exact ⟨flipBy s μ, Subgroup.subset_closure (Or.inl (Or.inr ⟨μ, rfl⟩)),
        fun x => flipBy_toTorus s μ x⟩
    · exact ⟨swapJ μ ν, Subgroup.subset_closure (Or.inr ⟨μ, ν, rfl⟩),
        fun x => swapJ_toTorus μ ν x⟩
  · exact ⟨1, Subgroup.one_mem _, fun x => rfl⟩
  · rintro g g' - - ⟨a, ha, hga⟩ ⟨b, hb, hgb⟩
    exact ⟨a * b, Subgroup.mul_mem _ ha hb, fun x => by
      simp [Equiv.Perm.mul_apply, hgb, hga]⟩
  · rintro g - ⟨a, ha, hga⟩
    refine ⟨a⁻¹, Subgroup.inv_mem _ ha, fun x => ?_⟩
    have := hga (g⁻¹ x)
    rw [show g (g⁻¹ x) = x from by simp] at this
    rw [← this]; simp

end Torus


section Reynolds

variable {Γ S : Type*} [Group Γ] (K : Subgroup Γ) [Fintype (Γ ⧸ K)] (act : Γ → S → S)

/-- **The Reynolds average over the cosets `Γ ⧸ K`** of a function `F` on a set `S` on which `Γ`
acts, with the fixed system of coset representatives `Quotient.out`. -/
noncomputable def reynolds (F : S → ℂ) (s : S) : ℂ :=
  (Fintype.card (Γ ⧸ K) : ℂ)⁻¹ * ∑ q : Γ ⧸ K, F (act (Quotient.out q)⁻¹ s)

variable {K act}

theorem reynolds_act {F : S → ℂ} (hmul : ∀ a b s, act (a * b) s = act a (act b s))
    (hK : ∀ k ∈ K, ∀ s, F (act k s) = F s) (g : Γ) (s : S) :
    reynolds K act F (act g s) = reynolds K act F s := by
  unfold reynolds
  congr 1
  conv_rhs => rw [← Equiv.sum_comp (MulAction.toPerm g⁻¹ : Equiv.Perm (Γ ⧸ K))]
  refine Finset.sum_congr rfl fun q _ => ?_
  rw [← hmul]
  have hq : ((g⁻¹ * Quotient.out q : Γ) : Γ ⧸ K) = (MulAction.toPerm g⁻¹ : Equiv.Perm (Γ ⧸ K)) q := by
    have : ((g⁻¹ * Quotient.out q : Γ) : Γ ⧸ K) = g⁻¹ • ((Quotient.out q : Γ) : Γ ⧸ K) := rfl
    rw [this, QuotientGroup.out_eq']
    rfl
  set q' := (MulAction.toPerm g⁻¹ : Equiv.Perm (Γ ⧸ K)) q with hq'
  have hk : (Quotient.out q')⁻¹ * (g⁻¹ * Quotient.out q) ∈ K := by
    rw [← QuotientGroup.eq, QuotientGroup.out_eq', hq]
  have : (Quotient.out q)⁻¹ * g =
      ((Quotient.out q')⁻¹ * (g⁻¹ * Quotient.out q))⁻¹ * (Quotient.out q')⁻¹ := by
    group
  rw [this, hmul]
  exact hK _ (K.inv_mem hk) _

/-- The Reynolds average does not depend on the choice of coset representatives. -/
theorem reynolds_rep {F : S → ℂ} (hmul : ∀ a b s, act (a * b) s = act a (act b s))
    (hK : ∀ k ∈ K, ∀ s, F (act k s) = F s) (r : Γ ⧸ K → Γ) (hr : ∀ q, ((r q : Γ) : Γ ⧸ K) = q)
    (s : S) :
    ∑ q : Γ ⧸ K, F (act (r q)⁻¹ s) = ∑ q : Γ ⧸ K, F (act (Quotient.out q)⁻¹ s) := by
  refine Finset.sum_congr rfl fun q _ => ?_
  have hk : (Quotient.out q)⁻¹ * r q ∈ K := by
    rw [← QuotientGroup.eq, QuotientGroup.out_eq', hr]
  have : (r q)⁻¹ = ((Quotient.out q)⁻¹ * r q)⁻¹ * (Quotient.out q)⁻¹ := by group
  rw [this, hmul]
  exact hK _ (K.inv_mem hk) _

end Reynolds


section Quotient

variable {d : ℕ}

/-- The translation vectors whose translation lies in `symZ W`. -/
def tVSub (W : ℕ) : AddSubgroup (Fin d → ℤ) where
  carrier := {v | tV v ∈ symZ (d := d) W}
  zero_mem' := by simp [tV_zero]
  add_mem' := fun {u v} hu hv => by
    show tV (u + v) ∈ symZ (d := d) W
    rw [tV_add]; exact (symZ (d := d) W).mul_mem hu hv
  neg_mem' := fun {v} hv => by
    show tV (-v) ∈ symZ (d := d) W
    rw [← tV_inv]; exact (symZ (d := d) W).inv_mem hv

theorem tA_mem_symZ (W Mb : ℕ) (a : Fin d → Fin Mb) : tA W Mb a ∈ symZ (d := d) W := by
  have hgen : ∀ μ : Fin d, ((W : ℤ) • (Pi.single μ (1 : ℤ)) : Fin d → ℤ) ∈ tVSub (d := d) W :=
    fun μ => tZ_mem W μ
  have : (fun μ => (W : ℤ) * ((a μ : ℕ) : ℤ)) ∈ tVSub (d := d) W := by
    have e : (fun μ => (W : ℤ) * ((a μ : ℕ) : ℤ)) =
        ∑ μ : Fin d, ((a μ : ℕ) : ℤ) • ((W : ℤ) • (Pi.single μ (1 : ℤ)) : Fin d → ℤ) := by
      funext ν
      rw [Finset.sum_apply, Finset.sum_eq_single ν]
      · simp [mul_comm]
      · intro μ _ hμ; simp [Pi.single_eq_of_ne (Ne.symm hμ)]
      · simp
    rw [e]
    exact AddSubgroup.sum_mem _ fun μ _ => AddSubgroup.zsmul_mem _ (hgen μ) _
  exact this

theorem finite_quotient {W Mb : ℕ} (hMb : 0 < Mb) :
    Finite (↥(symZ (d := d) W) ⧸ (symZ (d := d) (W * Mb)).subgroupOf (symZ (d := d) W)) := by
  have : NeZero Mb := ⟨hMb.ne'⟩
  refine Finite.of_surjective (fun a : Fin d → Fin Mb =>
    (QuotientGroup.mk ⟨(tA W Mb a)⁻¹, (symZ (d := d) W).inv_mem (tA_mem_symZ W Mb a)⟩ :
      ↥(symZ (d := d) W) ⧸ (symZ (d := d) (W * Mb)).subgroupOf (symZ (d := d) W))) ?_
  intro q
  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective q
  obtain ⟨h, hh, a, hga⟩ := symZ_decomp hMb ((symZ (d := d) W).inv_mem g.2)
  refine ⟨a, ?_⟩
  rw [QuotientGroup.eq, Subgroup.mem_subgroupOf]
  have : (((⟨(tA W Mb a)⁻¹, (symZ (d := d) W).inv_mem (tA_mem_symZ W Mb a)⟩ : ↥(symZ (d := d) W))⁻¹ * g :
      ↥(symZ (d := d) W)) : Equiv.Perm (Fin d → ℤ)) = h⁻¹ := by
    have h1 : (g : Equiv.Perm (Fin d → ℤ)) = (h * tA W Mb a)⁻¹ := by rw [← hga]; simp
    rw [Subgroup.coe_mul, Subgroup.coe_inv, h1]
    simp
  rw [this]; exact (symZ (d := d) (W * Mb)).inv_mem hh

/-- The representative of a coset is a paving element times a paving offset. -/
theorem exists_rep {W Mb : ℕ} (hMb : 0 < Mb)
    (q : ↥(symZ (d := d) W) ⧸ (symZ (d := d) (W * Mb)).subgroupOf (symZ (d := d) W)) :
    ∃ h ∈ symZ (d := d) (W * Mb), ∃ a : Fin d → Fin Mb,
      ((Quotient.out q : ↥(symZ (d := d) W)) : Equiv.Perm (Fin d → ℤ))⁻¹ = h * tA W Mb a :=
  symZ_decomp hMb ((symZ (d := d) W).inv_mem (Quotient.out q).2)

end Quotient

