/-!
# Def-6: translation covariance of the second derivative of the density (CLASS-RULINGS Q-A, Q-B)

From the covariance (H.3-E) `eucEloc` of the density `Eloc` under the translations of the level-`j`
lattice (`fullJSymGroup`) and the slice calculus of `Def6InfD2`:

* `LiftCtx.D2_Eloc_translate`: `∂_x ∂_0 ℰ(y) = ∂_{x-y} ∂_{-y} ℰ(0)` at the constant field;
* `LiftCtx.momentSum_eq`: the finite-torus second-moment sum `momentSum` equals
  `∑_{u,v} ∂_u ∂_v ℰ(0) |u - v|²` (CLASS-RULINGS Q-B equation (1) on the torus).
-/

@[expose] public section

namespace Balaban.SmallField.Def6

open Balaban Balaban.Multiscale Balaban.Background Balaban.Localization Balaban.Fluctuation
  Balaban.SmallField Filter Metric Set

section Transl

variable {d n : ℕ}

theorem addRight_add_mem {H : Subgroup (Equiv.Perm (Torus d n))} {a b : Torus d n}
    (ha : Equiv.addRight a ∈ H) (hb : Equiv.addRight b ∈ H) : Equiv.addRight (a + b) ∈ H := by
  have : Equiv.addRight (a + b) = Equiv.addRight a * Equiv.addRight b := by
    ext x μ; simp [add_comm, add_left_comm]
  rw [this]; exact H.mul_mem ha hb

theorem addRight_nsmul_mem {H : Subgroup (Equiv.Perm (Torus d n))} {a : Torus d n}
    (ha : Equiv.addRight a ∈ H) (q : ℕ) : Equiv.addRight (q • a) ∈ H := by
  induction q with
  | zero => simp [H.one_mem]
  | succ q ih => rw [succ_nsmul]; exact addRight_add_mem ih ha

end Transl

section SymG

variable {d L N₁ m₁ k N : ℕ} [NeZero L] [NeZero N₁]

/-- The translation by a site aligned to the grid of side `s` lies in the group generated by the
translations by `s`. -/
theorem addRight_mem_symGroupBy {s : ℕ} {t : CTorus d L N₁ m₁ k} (ht : Aligned s t) :
    Equiv.addRight t ∈ symGroupBy (d := d) (L := L) (N₁ := N₁) (m₁ := m₁) (k := k) s := by
  set H := symGroupBy (d := d) (L := L) (N₁ := N₁) (m₁ := m₁) (k := k) s with hH
  have hgen : ∀ μ : Fin d, Equiv.addRight (s • (Pi.single μ 1 : CTorus d L N₁ m₁ k)) ∈ H := by
    intro μ
    exact Subgroup.subset_closure (Or.inl (Or.inl ⟨μ, rfl⟩))
  have ht' : t = ∑ μ : Fin d, ((t μ).val / s) • (s • (Pi.single μ 1 : CTorus d L N₁ m₁ k)) := by
    funext ν
    rw [Finset.sum_apply, Finset.sum_eq_single ν]
    · have h1 : s * ((t ν).val / s) = (t ν).val := by
        have := Nat.div_add_mod (t ν).val s
        have h2 := ht ν
        omega
      rw [Pi.smul_apply, Pi.smul_apply, Pi.single_eq_same, nsmul_eq_mul, nsmul_eq_mul, mul_one,
        ← Nat.cast_mul, mul_comm ((t ν).val / s) s, h1]
      exact (ZMod.natCast_zmod_val (t ν)).symm
    · intro μ _ hμ
      simp [Pi.single_eq_of_ne (Ne.symm hμ)]
    · simp
  rw [ht']
  have key : ∀ (S : Finset (Fin d)), Equiv.addRight (∑ μ ∈ S, ((t μ).val / s) •
      (s • (Pi.single μ 1 : CTorus d L N₁ m₁ k))) ∈ H := by
    intro S
    induction S using Finset.induction_on with
    | empty => simp [H.one_mem]
    | insert a S ha ih =>
      rw [Finset.sum_insert ha]
      exact addRight_add_mem (addRight_nsmul_mem (hgen a) _) ih
  exact key _


theorem cbase_add_aligned {a : ℕ} (ha : a ∣ N₁ * L ^ m₁ * L ^ k) {y : CTorus d L N₁ m₁ k}
    (hy : Aligned a y) (z : CTorus d L N₁ m₁ k) : cbase a (y + z) = y + cbase a z := by
  have : NeZero (N₁ * L ^ m₁ * L ^ k) := ⟨by
    have := NeZero.pos N₁; have := NeZero.pos L; positivity⟩
  have hz : z = natT (fun μ => (z μ).val) := by
    funext μ; simp [natT]
  have hm : ∀ μ, ((y + z) μ).val % a = (z μ).val % a := by
    intro μ
    have := mod_of_aligned_add ha hy (w := fun μ => (z μ).val) μ
    rw [← hz] at this
    exact this
  rw [cbase_eq_sub, cbase_eq_sub]
  have : (fun μ => ((y + z) μ).val % a) = fun μ => (z μ).val % a := funext hm
  rw [this]; abel

theorem aligned_neg {a : ℕ} (ha : a ∣ N₁ * L ^ m₁ * L ^ k) {y : CTorus d L N₁ m₁ k}
    (hy : Aligned a y) : Aligned a (-y) := by
  have : NeZero (N₁ * L ^ m₁ * L ^ k) := ⟨by
    have := NeZero.pos N₁; have := NeZero.pos L; positivity⟩
  rw [aligned_iff ha] at hy ⊢
  intro μ
  rw [Pi.neg_apply, map_neg, hy μ, neg_zero]

theorem aligned_add {a : ℕ} (ha : a ∣ N₁ * L ^ m₁ * L ^ k) {y z : CTorus d L N₁ m₁ k}
    (hy : Aligned a y) (hz : Aligned a z) : Aligned a (y + z) := by
  have : NeZero (N₁ * L ^ m₁ * L ^ k) := ⟨by
    have := NeZero.pos N₁; have := NeZero.pos L; positivity⟩
  rw [aligned_iff ha] at hy hz ⊢
  intro μ
  rw [Pi.add_apply, map_add, hy μ, hz μ, add_zero]

theorem actField_addRight_neg_blockDir {j : ℕ} (hjk : j ≤ k) {y : CTorus d L N₁ m₁ k}
    (hy : Aligned (L ^ j) y) (x : CTorus d L N₁ m₁ k) (i : Fin N) :
    actField (N := N) (Equiv.addRight (-y)) (blockDir L j x i) = blockDir L j (x - y) i := by
  have hdvd : L ^ j ∣ N₁ * L ^ m₁ * L ^ k := by
    rw [side_eq hjk]; exact dvd_mul_right _ _
  funext z i'
  simp only [actField, blockDir, Equiv.addRight_symm, Equiv.coe_addRight, neg_neg]
  have : cbase (L ^ j) (z + y) = cbase (L ^ j) z + y := by
    rw [add_comm z y, cbase_add_aligned hdvd hy, add_comm]
  rw [this]
  simp only [eq_sub_iff_add_eq]

end SymG


section Cov

variable {d L N₁ m₁ k N : ℕ} [NeZero L] [NeZero N₁] {ϱ : ℝ} {P : Consts} {β ν a : ℕ → ℝ}
  {Tm : Terms d L N₁ m₁ k N ϱ}
  {ρd : (CTorus d L N₁ m₁ k → Fin N → ℝ) → (Fin N → ℝ) → (CTorus d L N₁ m₁ k → Fin N → ℝ) → ℝ}
  {Ek : ℝ} {j : ℕ} {ρ : ℝ}

/-- The constant field `e_{i₀}`. -/
abbrev eFld (d L N₁ m₁ k N : ℕ) (i₀ : Fin N) : Fld d L N₁ m₁ k N :=
  constFld (Pi.single i₀ 1)

/-- **The data domain near the constant `e_{i₀}`**: a block-constant field within `ρ` of `e_{i₀}`,
with the constant field `h = e_{i₀}`, lies in `Ξ^c_j(𝔹; 1, ε_j)` of every generating set of level
`≤ j`. -/
theorem LiftCtx.xiDom_const (ctx : LiftCtx P β ν a Tm ρd Ek j ρ)
    (G : GeneratingSet d L (N₁ * L ^ m₁) k ϱ) (hΩ : ∀ i, j < i → G.Ω i = ∅) (i₀ : Fin N)
    (Ψ : Fld d L N₁ m₁ k N) (hΨ : ∀ x i, ‖Ψ x i - (Pi.single i₀ 1 : Fin N → ℂ) i‖ ≤ ρ)
    (hΨb : ∀ x x', jBlock d L (N₁ * L ^ m₁) k j x = jBlock d L (N₁ * L ^ m₁) k j x' → Ψ x = Ψ x') :
    XiDom G (aIdeal L k (a k)) (bgMass L k (β k) (ν k)) j (P.eps d L j) Ψ (eFld d L N₁ m₁ k N i₀) := by
  obtain ⟨δ, hδ0, hδ1, hδ2, hδ3, hδ4⟩ := ctx.radius
  have hN : (0 : ℝ) ≤ N * rotB N := by unfold rotB; positivity
  have hρ0 := ctx.rho_pos
  refine xiDom_of_close ctx.bg hΩ ctx.jk i₀ hδ0 hδ1 hδ2 hρ0 (by nlinarith) hδ3 Ψ
    (Pi.single i₀ 1) hΨ hΨb ?_
  intro i
  rw [sub_self, norm_zero, mul_zero]
  exact hρ0.le


theorem cbase_pow_eq_of_jBlock {j : ℕ} (hjk : j ≤ k) {z z' : CTorus d L N₁ m₁ k}
    (h : jBlock d L (N₁ * L ^ m₁) k j z = jBlock d L (N₁ * L ^ m₁) k j z') :
    cbase (L ^ j) z = cbase (L ^ j) z' := by
  have : NeZero (N₁ * L ^ m₁ * L ^ (k - j)) := ⟨by
    have := NeZero.pos N₁; have := NeZero.pos L; positivity⟩
  funext μ
  have h1 := congrFun h μ
  simp only [jBlock, blockMap_apply] at h1
  have e1 := blockCoord_val (side_eq hjk) (z μ)
  have e2 := blockCoord_val (side_eq hjk) (z' μ)
  have h2 : (z μ).val / L ^ j = (z' μ).val / L ^ j := by
    rw [← e1, ← e2, h1]
  simp only [cbase, h2]

theorem blockDir_jBlock {j : ℕ} (hjk : j ≤ k) (x : CTorus d L N₁ m₁ k) (i : Fin N)
    {z z' : CTorus d L N₁ m₁ k}
    (h : jBlock d L (N₁ * L ^ m₁) k j z = jBlock d L (N₁ * L ^ m₁) k j z') :
    blockDir (N := N) L j x i z = blockDir (N := N) L j x i z' := by
  funext i'
  simp only [blockDir, cbase_pow_eq_of_jBlock hjk h]

omit [NeZero N₁] in
theorem norm_blockDir_le (L j : ℕ) (x : CTorus d L N₁ m₁ k) (i : Fin N)
    (z : CTorus d L N₁ m₁ k) (i' : Fin N) :
    ‖(blockDir (N := N) L j x i z i' : ℂ)‖ ≤ 1 := by
  unfold blockDir
  split_ifs <;> simp

omit [NeZero L] in
omit [NeZero N₁] in
/-- The slice `e + s δ_u + t δ_v` of block directions is block-constant and within `|s| + |t|`
of the constant field. -/
theorem slice_dev {j : ℕ} (u v : CTorus d L N₁ m₁ k) (i₁ i₀ : Fin N) (s t : ℂ)
    (z : CTorus d L N₁ m₁ k) (i : Fin N) :
    ‖(eFld d L N₁ m₁ k N i₀ + s • blockDir L j u i₁ + t • blockDir L j v i₁) z i -
      (Pi.single i₀ 1 : Fin N → ℂ) i‖ ≤ ‖s‖ + ‖t‖ := by
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, eFld, constFld]
  have h1 := norm_blockDir_le (N := N) L j u i₁ z i
  have h2 := norm_blockDir_le (N := N) L j v i₁ z i
  calc ‖(Pi.single i₀ 1 : Fin N → ℂ) i + s * blockDir L j u i₁ z i + t * blockDir L j v i₁ z i -
        (Pi.single i₀ 1 : Fin N → ℂ) i‖ = ‖s * blockDir L j u i₁ z i + t * blockDir L j v i₁ z i‖ := by
        congr 1; ring
    _ ≤ ‖s * blockDir L j u i₁ z i‖ + ‖t * blockDir L j v i₁ z i‖ := norm_add_le _ _
    _ ≤ ‖s‖ + ‖t‖ := by
        rw [norm_mul, norm_mul]
        nlinarith [norm_nonneg s, norm_nonneg t, norm_nonneg (blockDir L j u i₁ z i),
          norm_nonneg (blockDir L j v i₁ z i)]

theorem slice_jBlock {j : ℕ} (hjk : j ≤ k) (u v : CTorus d L N₁ m₁ k) (i₁ i₀ : Fin N) (s t : ℂ)
    {z z' : CTorus d L N₁ m₁ k}
    (h : jBlock d L (N₁ * L ^ m₁) k j z = jBlock d L (N₁ * L ^ m₁) k j z') :
    (eFld d L N₁ m₁ k N i₀ + s • blockDir L j u i₁ + t • blockDir L j v i₁) z =
      (eFld d L N₁ m₁ k N i₀ + s • blockDir L j u i₁ + t • blockDir L j v i₁) z' := by
  simp only [Pi.add_apply, Pi.smul_apply, eFld, constFld,
    blockDir_jBlock hjk u i₁ h, blockDir_jBlock hjk v i₁ h]


theorem LiftCtx.analyticAt_E (ctx : LiftCtx P β ν a Tm ρd Ek j ρ) (i₀ : Fin N)
    (y : CTorus d L N₁ m₁ k) {X : Set (CTorus d L N₁ m₁ k)} (hX : IsPolyDom P.m₀ j X) (hy : y ∈ X) :
    AnalyticAt ℂ (fun ψ : Fld d L N₁ m₁ k N => Tm.E j y X ψ (eFld d L N₁ m₁ k N i₀))
      (eFld d L N₁ m₁ k N i₀) := by
  have hp0 : XiDom (Tm.gs j X) (aIdeal L k (a k)) (bgMass L k (β k) (ν k)) j (P.eps d L j)
      (eFld d L N₁ m₁ k N i₀) (eFld d L N₁ m₁ k N i₀) :=
    ctx.xiDom_const (Tm.gs j X) (ctx.sf.gs_spec j ctx.j1 ctx.jk X hX).2 i₀ _
      (fun x i => by simp [eFld, constFld, ctx.rho_pos.le]) (fun _ _ _ => rfl)
  have h1 := ctx.sf.analyticE j ctx.j1 ctx.jk y X hX hy (eFld d L N₁ m₁ k N i₀, eFld d L N₁ m₁ k N i₀)
    hp0
  have h2 : AnalyticAt ℂ (fun ψ : Fld d L N₁ m₁ k N => (ψ, eFld d L N₁ m₁ k N i₀))
      (eFld d L N₁ m₁ k N i₀) := AnalyticAt.prod analyticAt_id analyticAt_const
  exact AnalyticAt.comp (f := fun ψ : Fld d L N₁ m₁ k N => (ψ, eFld d L N₁ m₁ k N i₀)) h1 h2

open Classical in
theorem LiftCtx.analyticAt_Eloc (ctx : LiftCtx P β ν a Tm ρd Ek j ρ) (i₀ : Fin N)
    (y : CTorus d L N₁ m₁ k) :
    AnalyticAt ℂ (fun ψ : Fld d L N₁ m₁ k N => Eloc P.m₀ Tm j y ψ (eFld d L N₁ m₁ k N i₀))
      (eFld d L N₁ m₁ k N i₀) := by
  have hfin : (polysAt (d := d) (L := L) (N₁ := N₁) (m₁ := m₁) (k := k) P.m₀ j y).Finite :=
    Set.toFinite _
  have : (fun ψ : Fld d L N₁ m₁ k N => Eloc P.m₀ Tm j y ψ (eFld d L N₁ m₁ k N i₀)) =
      fun ψ => ∑ X ∈ hfin.toFinset, Tm.E j y X ψ (eFld d L N₁ m₁ k N i₀) := by
    funext ψ
    unfold Eloc
    exact finsum_mem_eq_finite_toFinset_sum _ hfin
  rw [this]
  exact Finset.analyticAt_fun_sum _ fun X hX =>
    ctx.analyticAt_E i₀ y (Set.Finite.mem_toFinset hfin |>.1 hX).1 (Set.Finite.mem_toFinset hfin |>.1 hX).2


omit [NeZero N₁] in
theorem blockBase_zero (L j : ℕ) :
    blockBase (d := d) (N₁ := N₁) (m₁ := m₁) (k := k) L j (0 : CTorus d L N₁ m₁ k) = 0 := by
  funext μ; simp [blockBase, cbase]

theorem mem_fullJSymGroup_addRight_neg {j : ℕ} {y : CTorus d L N₁ m₁ k}
    (hy : Aligned (L ^ j) y) :
    (Equiv.addRight (-y) : Equiv.Perm (CTorus d L N₁ m₁ k)) ∈
      fullJSymGroup (N₁ := N₁) (m₁ := m₁) (k := k) (d := d) L j := by
  have h := addRight_mem_symGroupBy (L := L) (N₁ := N₁) (m₁ := m₁) (k := k) hy
  have h2 := (symGroupBy (d := d) (L := L) (N₁ := N₁) (m₁ := m₁) (k := k) (L ^ j)).inv_mem h
  have : (Equiv.addRight y : Equiv.Perm (CTorus d L N₁ m₁ k))⁻¹ = Equiv.addRight (-y) := by
    ext z μ; simp [Equiv.Perm.inv_def]
  rw [this] at h2
  exact h2

/-- **Translation covariance of the second derivative of the density** (CLASS-RULINGS Q-A, Q-B (1)):
`∂_x ∂_0 ℰ(y) = ∂_{x-y} ∂_{-y} ℰ(0)` at the constant field, from the covariance (H.3-E) of the
density under the translations of the level-`j` lattice. -/
theorem LiftCtx.D2_Eloc_translate (ctx : LiftCtx P β ν a Tm ρd Ek j ρ) (i₀ i₁ : Fin N)
    {y : CTorus d L N₁ m₁ k} (hy : Aligned (L ^ j) y) (x : CTorus d L N₁ m₁ k) :
    D2 (fun ψ : Fld d L N₁ m₁ k N => Eloc P.m₀ Tm j y ψ (eFld d L N₁ m₁ k N i₀))
        (eFld d L N₁ m₁ k N i₀) (blockDir L j x i₁) (blockDir L j 0 i₁) =
      D2 (fun ψ : Fld d L N₁ m₁ k N => Eloc P.m₀ Tm j 0 ψ (eFld d L N₁ m₁ k N i₀))
        (eFld d L N₁ m₁ k N i₀) (blockDir L j (x - y) i₁) (blockDir L j (-y) i₁) := by
  have hjk := ctx.jk
  have hr := mem_fullJSymGroup_addRight_neg (L := L) (N₁ := N₁) (m₁ := m₁) (k := k) hy
  have hlev : ∀ i, j < i →
      (levelGS (d := d) (L := L) (N₁ := N₁) (m₁ := m₁) (ϱ := ϱ) j hjk).Ω i = ∅ := by
    intro i hi
    simp [levelGS, not_le.2 hi]
  refine D2_congr_slice (ctx.analyticAt_Eloc i₀ y) (ctx.analyticAt_Eloc i₀ 0)
    (δ := ρ / 2) (by linarith [ctx.rho_pos]) fun s t hs ht => ?_
  have hst : ‖s‖ + ‖t‖ ≤ ρ := by linarith
  have X1 := ctx.xiDom_const (levelGS (d := d) (L := L) (N₁ := N₁) (m₁ := m₁) (ϱ := ϱ) j hjk) hlev i₀
    (eFld d L N₁ m₁ k N i₀ + s • blockDir L j x i₁ + t • blockDir L j 0 i₁)
    (fun z i => (slice_dev x 0 i₁ i₀ s t z i).trans hst) (fun z z' h => slice_jBlock hjk x 0 i₁ i₀ s t h)
  have X2 := ctx.xiDom_const (levelGS (d := d) (L := L) (N₁ := N₁) (m₁ := m₁) (ϱ := ϱ) j hjk) hlev i₀
    (eFld d L N₁ m₁ k N i₀ + s • blockDir L j (x - y) i₁ + t • blockDir L j (-y) i₁)
    (fun z i => (slice_dev (x - y) (-y) i₁ i₀ s t z i).trans hst)
    (fun z z' h => slice_jBlock hjk (x - y) (-y) i₁ i₀ s t h)
  set r : Equiv.Perm (CTorus d L N₁ m₁ k) := Equiv.addRight (-y) with hrdef
  have e1 := actField_addRight_neg_blockDir (N := N) hjk hy x i₁
  have e2 := actField_addRight_neg_blockDir (N := N) hjk hy 0 i₁
  rw [zero_sub] at e2
  have hact : actField (N := N) r (eFld d L N₁ m₁ k N i₀ + s • blockDir L j x i₁ +
      t • blockDir L j 0 i₁) = eFld d L N₁ m₁ k N i₀ + s • blockDir L j (x - y) i₁ +
        t • blockDir L j (-y) i₁ := by
    funext z i'
    have h1 := congrFun (congrFun e1 z) i'
    have h2 := congrFun (congrFun e2 z) i'
    simp only [actField, Pi.add_apply, Pi.smul_apply, smul_eq_mul, eFld, constFld] at h1 h2 ⊢
    rw [h1, h2]
  have hc0 : actField (N := N) r (eFld d L N₁ m₁ k N i₀) = eFld d L N₁ m₁ k N i₀ := rfl
  have key := ctx.sf.eucEloc j ctx.j1 hjk y r hr
    (eFld d L N₁ m₁ k N i₀ + s • blockDir L j x i₁ + t • blockDir L j 0 i₁)
    (eFld d L N₁ m₁ k N i₀) X1 (by rw [hact, hc0]; exact X2)
  rw [hact, hc0] at key
  have hry : r y = 0 := by
    funext μ; simp [hrdef]
  rw [hry, blockBase_zero] at key
  exact key.symm


open Classical in
/-- **The second-moment sum on the torus in terms of the density at the origin**
(CLASS-RULINGS Q-B (1), finite-torus form): by translation covariance of the density,
`∑_x ∂_x∂_0 ℰ_total |x|² = ∑_{u,v} ∂_u∂_v ℰ(0) |u - v|²`. -/
theorem LiftCtx.momentSum_eq (ctx : LiftCtx P β ν a Tm ρd Ek j ρ) (i₀ i₁ : Fin N) :
    momentSum P.m₀ Tm j i₀ i₁ =
      ∑ u ∈ (Finset.univ : Finset (CTorus d L N₁ m₁ k)).filter (Aligned (L ^ j)),
        ∑ v ∈ (Finset.univ : Finset (CTorus d L N₁ m₁ k)).filter (Aligned (L ^ j)),
          D2 (fun ψ : Fld d L N₁ m₁ k N => Eloc P.m₀ Tm j 0 ψ (eFld d L N₁ m₁ k N i₀))
            (eFld d L N₁ m₁ k N i₀) (blockDir L j u i₁) (blockDir L j v i₁) *
            (liftSq L j (u - v) : ℂ) := by
  set Λ : Finset (CTorus d L N₁ m₁ k) :=
    (Finset.univ : Finset (CTorus d L N₁ m₁ k)).filter (Aligned (L ^ j)) with hΛ
  have hjk := ctx.jk
  have hdvd : L ^ j ∣ N₁ * L ^ m₁ * L ^ k := by
    rw [side_eq hjk]; exact dvd_mul_right _ _
  have hmem : ∀ x, x ∈ Λ ↔ Aligned (L ^ j) x := by intro x; simp [hΛ]
  set G : CTorus d L N₁ m₁ k → CTorus d L N₁ m₁ k → ℂ := fun u v =>
    D2 (fun ψ : Fld d L N₁ m₁ k N => Eloc P.m₀ Tm j 0 ψ (eFld d L N₁ m₁ k N i₀))
      (eFld d L N₁ m₁ k N i₀) (blockDir L j u i₁) (blockDir L j v i₁) with hG
  have step : ∀ x, D2 (fun ψ : Fld d L N₁ m₁ k N => Edens P.m₀ Tm j ψ (eFld d L N₁ m₁ k N i₀))
      (eFld d L N₁ m₁ k N i₀) (blockDir L j x i₁) (blockDir L j 0 i₁) = ∑ y ∈ Λ, G (x - y) (-y) := by
    intro x
    have h1 : (fun ψ : Fld d L N₁ m₁ k N => Edens P.m₀ Tm j ψ (eFld d L N₁ m₁ k N i₀)) =
        fun ψ => ∑ y ∈ Λ, Eloc P.m₀ Tm j y ψ (eFld d L N₁ m₁ k N i₀) := rfl
    rw [h1, D2_sum Λ (fun y _ => ctx.analyticAt_Eloc i₀ y)]
    exact Finset.sum_congr rfl fun y hy => ctx.D2_Eloc_translate i₀ i₁ ((hmem y).1 hy) x
  have hneg : ∀ y ∈ Λ, -y ∈ Λ := fun y hy => (hmem _).2 (aligned_neg hdvd ((hmem _).1 hy))
  have hsub : ∀ x y, x ∈ Λ → y ∈ Λ → x - y ∈ Λ := fun x y hx hy => (hmem _).2 (by
    rw [sub_eq_add_neg]
    exact aligned_add hdvd ((hmem _).1 hx) (aligned_neg hdvd ((hmem _).1 hy)))
  unfold momentSum
  simp only [step, Finset.sum_mul]
  rw [← Finset.sum_product', ← Finset.sum_product']
  refine Finset.sum_nbij' (fun p => (p.1 - p.2, -p.2)) (fun p => (p.1 - p.2, -p.2)) ?_ ?_ ?_ ?_ ?_
  · intro p hp
    rw [Finset.mem_product] at hp ⊢
    exact ⟨hsub _ _ hp.1 hp.2, hneg _ hp.2⟩
  · intro p hp
    rw [Finset.mem_product] at hp ⊢
    exact ⟨hsub _ _ hp.1 hp.2, hneg _ hp.2⟩
  · intro p hp
    ext <;> simp
  · intro p hp
    ext <;> simp
  · intro p hp
    simp only [hG]
    congr 2
    simp

end Cov

