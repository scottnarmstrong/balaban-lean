module

public import Balaban.Analysis.AnalyticLimit
public import Mathlib.Analysis.Convex.Integral
public import Mathlib.MeasureTheory.Constructions.BorelSpace.ContinuousMap
public import Mathlib.Topology.ContinuousMap.Compact
public import Mathlib.Topology.ContinuousMap.SecondCountableSpace

/-!
# Analyticity of dominated parameter integrals

Mathlib has no statement that an integral of functions analytic in a finite-dimensional complex
parameter is analytic.  `ParamIntegralAnalytic.lean` treats a finite measure carried by a compact
set with an integrand continuous in the integration variable.  Here the integration variable lives
in a measurable space without topology and the integrand is dominated by an integrable function:

* `analyticAt_integral_continuousMap`: if `x ↦ Ψ x` is integrable with values in the Banach space
  `C(closedBall e₀ ρ, ℂ)` and almost every `Ψ x` agrees on the open ball with a function analytic
  there, then so does `e ↦ ∫ Ψ x e dμ(x)` (the Bochner integral stays in the closed
  convex set of such functions, closed by the several-variable Weierstrass theorem
  `analyticOnNhd_of_tendstoUniformlyOn`);
* `analyticOnNhd_integral_of_dominated`: if `G(e, x)` is analytic in `e ∈ U` for every `x`,
  measurable in `x` for every `e ∈ U`, and `|G(e, x)| ≤ g(x)` with `g` integrable, then
  `e ↦ ∫ G(e, x) dμ(x)` is analytic on `U` (the map `x ↦ G(·, x)` into `C(closedBall e₀ ρ, ℂ)` is
  measurable because the Borel σ-algebra of that space is generated by the evaluations,
  `ContinuousMap.measurable_iff_eval`, and it is separable).
-/

@[expose] public section

namespace Balaban.Analysis

open MeasureTheory Metric Set Filter Topology

variable {E X : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [MeasurableSpace X]
  {μ : Measure X} [IsFiniteMeasure μ]

/-- **Integrals of continuous-function-valued maps with analytic values.**  If `Ψ : X → C(K, ℂ)`,
`K = closedBall e₀ ρ`, is integrable and almost every `Ψ x` agrees on the open ball with a function
analytic there, then so does `e ↦ ∫ Ψ x e dμ(x)`. -/
theorem analyticAt_integral_continuousMap {e0 : E} {ρ : ℝ} [CompactSpace (closedBall e0 ρ)]
    {Ψ : X → C(closedBall e0 ρ, ℂ)} (hΨi : Integrable Ψ μ)
    (hΨA : ∀ᵐ x ∂μ, ∃ h : E → ℂ, AnalyticOnNhd ℂ h (ball e0 ρ) ∧
      ∀ z : closedBall e0 ρ, (z : E) ∈ ball e0 ρ → Ψ x z = h z) :
    ∃ h : E → ℂ, AnalyticOnNhd ℂ h (ball e0 ρ) ∧
      ∀ z : closedBall e0 ρ, (z : E) ∈ ball e0 ρ → ∫ x, Ψ x z ∂μ = h z := by
  classical
  let A : Set C(closedBall e0 ρ, ℂ) := {f | ∃ h : E → ℂ, AnalyticOnNhd ℂ h (ball e0 ρ) ∧
    ∀ z : closedBall e0 ρ, (z : E) ∈ ball e0 ρ → f z = h z}
  have hAsmul : ∀ (c : ℝ) (f : C(closedBall e0 ρ, ℂ)), f ∈ A → c • f ∈ A := by
    rintro c f ⟨h, hh, hfh⟩
    refine ⟨fun e => (c : ℂ) * h e, analyticOnNhd_const.mul hh, fun z hz => ?_⟩
    rw [ContinuousMap.smul_apply, hfh z hz, Complex.real_smul]
  have hAadd : ∀ f₁ f₂ : C(closedBall e0 ρ, ℂ), f₁ ∈ A → f₂ ∈ A → f₁ + f₂ ∈ A := by
    rintro f₁ f₂ ⟨h₁, hh₁, e₁⟩ ⟨h₂, hh₂, e₂⟩
    exact ⟨fun e => h₁ e + h₂ e, hh₁.add hh₂, fun z hz => by
      rw [ContinuousMap.add_apply, e₁ z hz, e₂ z hz]⟩
  have hAconv : Convex ℝ A := fun f₁ hf₁ f₂ hf₂ a b _ _ _ =>
    hAadd _ _ (hAsmul a f₁ hf₁) (hAsmul b f₂ hf₂)
  have hAclosed : IsClosed A := by
    refine IsSeqClosed.isClosed fun f f' hfA hlim => ?_
    choose h hh hfh using hfA
    obtain ⟨M, hM⟩ : ∃ M, ∀ n, ‖f n‖ ≤ M := by
      obtain ⟨M, hM⟩ := hlim.norm.bddAbove_range
      exact ⟨M, fun n => hM ⟨n, rfl⟩⟩
    let h' : E → ℂ := fun e => if he : e ∈ closedBall e0 ρ then f' ⟨e, he⟩ else 0
    have hunif : TendstoUniformlyOn h h' atTop (ball e0 ρ) := by
      rw [Metric.tendstoUniformlyOn_iff]
      intro ε hε
      obtain ⟨N, hN⟩ := (Metric.tendsto_atTop.1 hlim) ε hε
      filter_upwards [eventually_ge_atTop N] with n hn z hz
      have hz' : z ∈ closedBall e0 ρ := ball_subset_closedBall hz
      have h1 : h' z = f' ⟨z, hz'⟩ := by simp only [h', hz', dite_true]
      rw [h1, ← hfh n ⟨z, hz'⟩ hz, dist_comm]
      exact lt_of_le_of_lt (ContinuousMap.dist_apply_le_dist _) (hN n hn)
    have han := analyticOnNhd_of_tendstoUniformlyOn (M := M) isOpen_ball hh
      (fun n z hz => by
        have hz' : z ∈ closedBall e0 ρ := ball_subset_closedBall hz
        rw [← hfh n ⟨z, hz'⟩ hz]
        exact (ContinuousMap.norm_coe_le_norm (f n) _).trans (hM n)) hunif
    exact ⟨h', han, fun z _ => by simp only [h', z.2, dite_true]⟩
  have h0A : (0 : C(closedBall e0 ρ, ℂ)) ∈ A :=
    ⟨fun _ => 0, analyticOnNhd_const, fun z _ => rfl⟩
  have hmem : (∫ x, Ψ x ∂μ) ∈ A := by
    by_cases hμ0 : μ = 0
    · rw [hμ0, integral_zero_measure]
      exact h0A
    · have : NeZero μ := ⟨hμ0⟩
      have h1 := hAconv.average_mem hAclosed hΨA hΨi
      have hne : μ.real univ ≠ 0 :=
        ENNReal.toReal_ne_zero.2 ⟨by simpa using hμ0, measure_ne_top μ univ⟩
      have h2 : ∫ x, Ψ x ∂μ = (μ.real univ) • ⨍ x, Ψ x ∂μ := by
        rw [average_eq, smul_smul, mul_inv_cancel₀ hne, one_smul]
      rw [h2]
      exact hAsmul _ _ h1
  obtain ⟨h, hh, hval⟩ := hmem
  refine ⟨h, hh, fun z hz => ?_⟩
  rw [← hval z hz]
  have hcomm := (ContinuousMap.evalCLM ℂ z).integral_comp_comm hΨi
  simpa using hcomm

/-- **A dominated parameter integral of analytic functions is analytic** (finite measure,
finite-dimensional complex parameter): if `e ↦ G(e, x)` is analytic on the open set `U` for every
`x`, `G(e, ·)` is measurable for every `e ∈ U`, and `|G(e, x)| ≤ g(x)` on `U` with `g` integrable,
then `e ↦ ∫ G(e, x) dμ(x)` is analytic on `U`. -/
theorem analyticOnNhd_integral_of_dominated [FiniteDimensional ℂ E] {U : Set E} (hU : IsOpen U)
    {G : E → X → ℂ} (hG : ∀ x, AnalyticOnNhd ℂ (fun e => G e x) U)
    (hGm : ∀ e ∈ U, Measurable (G e)) {g : X → ℝ} (hgi : Integrable g μ)
    (hbd : ∀ e ∈ U, ∀ x, ‖G e x‖ ≤ g x) :
    AnalyticOnNhd ℂ (fun e => ∫ x, G e x ∂μ) U := by
  intro e0 he0
  have : ProperSpace E := FiniteDimensional.proper_rclike ℂ E
  obtain ⟨r, hr, hrU⟩ := Metric.isOpen_iff.1 hU e0 he0
  set ρ : ℝ := r / 2 with hρdef
  have hρ : 0 < ρ := by positivity
  have hcbU : closedBall e0 ρ ⊆ U := (closedBall_subset_ball (by linarith)).trans hrU
  have hbU : ball e0 ρ ⊆ U := ball_subset_closedBall.trans hcbU
  have : CompactSpace (closedBall e0 ρ) :=
    isCompact_iff_compactSpace.1 (isCompact_closedBall e0 ρ)
  let Ψ : X → C(closedBall e0 ρ, ℂ) := fun x =>
    ⟨fun z => G (z : E) x, ((hG x).continuousOn.mono hcbU).comp_continuous
      continuous_subtype_val (fun z => z.2)⟩
  have hΨm : Measurable Ψ :=
    ContinuousMap.measurable_iff_eval.2 (fun z => hGm z (hcbU z.2))
  have hΨi : Integrable Ψ μ := by
    refine Integrable.mono' hgi hΨm.aestronglyMeasurable (Eventually.of_forall fun x => ?_)
    refine (ContinuousMap.norm_le _ ((norm_nonneg _).trans (hbd e0 he0 x))).2 (fun z => ?_)
    exact hbd z (hcbU z.2) x
  obtain ⟨h, hh, hval⟩ := analyticAt_integral_continuousMap hΨi
    (Eventually.of_forall fun x => ⟨fun e => G e x, (hG x).mono hbU, fun _ _ => rfl⟩)
  refine (hh e0 (mem_ball_self hρ)).congr ?_
  filter_upwards [ball_mem_nhds e0 hρ] with z hz
  exact (hval ⟨z, ball_subset_closedBall hz⟩ hz).symm

end Balaban.Analysis
