module

public import Balaban.LargeField.Geometry.Lattice
public import Mathlib.Algebra.CharP.Two
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Ring
import Mathlib.Tactic.Abel

/-!
# Closed `ZMod 2`-cochains on `ℤ^d` are exact

A function `f : ℤ^d → Fin d → ZMod 2` assigning a value `f x i` to the edge `{x, x + e_i}` that
sums to zero around every plaquette is the coboundary of a function `h : ℤ^d → ZMod 2`
(the discrete Poincaré lemma mod 2; the cycle space of `ℤ^d` is generated by plaquettes). This is
the algebraic input of Timár's boundary-connectivity lemma.
-/

@[expose] public section

namespace Balaban.LatticeGeom

open Function

variable {d : ℕ}

private theorem z2_aux1 (A B P Q R S : ZMod 2) (h : P + R = Q + S) :
    (A + S) + (B + P) + R = A + B + Q := by
  revert A B P Q R S; decide

private theorem z2_aux2 (A B C F : ZMod 2) :
    A + (C + (A + B + F)) = B + C + F := by
  revert A B C F; decide

private theorem z2_aux3 (a b : ZMod 2) : a + b + b = a := by
  revert a b; decide

/-- A primitive of a sequence `D : ℤ → ZMod 2`: `c (n + 1) = c n + D n`. -/
theorem exists_primitive (D : ℤ → ZMod 2) : ∃ c : ℤ → ZMod 2, ∀ n, c (n + 1) = c n + D n := by
  let g : ℕ → ZMod 2 := fun k => ∑ i ∈ Finset.range k, D i
  let g' : ℕ → ZMod 2 := fun k => ∑ i ∈ Finset.range k, D (-1 - i)
  refine ⟨fun n => match n with | Int.ofNat k => g k | Int.negSucc k => g' (k + 1), ?_⟩
  intro n
  match n with
  | Int.ofNat k =>
    simp only [g]
    rw [Int.ofNat_eq_natCast, ← Nat.cast_succ]
    simp [Finset.sum_range_succ]
  | Int.negSucc 0 =>
    simp only [g, g']
    have : Int.negSucc 0 + 1 = 0 := by decide
    rw [this]
    simp [CharTwo.add_self_eq_zero]
  | Int.negSucc (k + 1) =>
    have : Int.negSucc (k + 1) + 1 = Int.negSucc k := by omega
    rw [this]
    simp only [g']
    rw [Finset.sum_range_succ _ (k + 1)]
    have h2 : (Int.negSucc (k + 1) : ℤ) = -1 - ((k + 1 : ℕ) : ℤ) := by omega
    have h3 : Int.negSucc (k + 1) = -1 - ((k + 1 : ℕ) : ℤ) := h2
    rw [← h3]
    simp only [Int.negSucc_eq] at *
    rw [add_assoc, CharTwo.add_self_eq_zero, add_zero]

/-- A chosen primitive. -/
noncomputable def primFn (D : ℤ → ZMod 2) : ℤ → ZMod 2 := Classical.choose (exists_primitive D)

theorem primFn_succ (D : ℤ → ZMod 2) (n : ℤ) : primFn D (n + 1) = primFn D n + D n :=
  Classical.choose_spec (exists_primitive D) n

/-- Discrete Poincaré lemma mod 2 on `ℤ^d`. -/
theorem exists_primitive_of_closed (f : Pt d → Fin d → ZMod 2)
    (hf : ∀ x i j, i ≠ j →
      f x i + f (x + Pi.single i 1) j = f x j + f (x + Pi.single j 1) i) :
    ∃ h : Pt d → ZMod 2, ∀ x i, h (x + Pi.single i 1) = h x + f x i := by
  classical
  have key : ∀ s : Finset (Fin d), ∃ h : Pt d → ZMod 2,
      ∀ x, ∀ i ∈ s, h (x + Pi.single i 1) = h x + f x i := by
    intro s
    induction s using Finset.induction_on with
    | empty => exact ⟨fun _ => 0, by simp⟩
    | insert j s hj ih =>
      obtain ⟨h, hh⟩ := ih
      set D : Pt d → ZMod 2 := fun x => h (x + Pi.single j 1) + h x + f x j with hD
      have hDinv : ∀ x, ∀ i ∈ s, D (x + Pi.single i 1) = D x := by
        intro x i hi
        have hij : i ≠ j := fun e => hj (e ▸ hi)
        have e1 := hf x i j hij
        have e2 : x + Pi.single i 1 + Pi.single j 1 = x + Pi.single j 1 + Pi.single i 1 := by
          abel
        have a1 : h (x + Pi.single i 1 + Pi.single j 1)
            = h (x + Pi.single j 1) + f (x + Pi.single j 1) i := by
          rw [e2]; exact hh _ i hi
        have a2 := hh x i hi
        simp only [hD]
        rw [a1, a2]
        exact z2_aux1 _ _ _ _ _ _ e1
      have hupd : ∀ x t, Function.update (x + (Pi.single j 1 : Pt d)) j t = Function.update x j t := by
        intro x t; ext l
        by_cases hl : l = j <;> simp [Function.update, hl]
      have hupd2 : ∀ x i, i ≠ j → ∀ t, Function.update (x + Pi.single i 1) j t
          = Function.update x j t + (Pi.single i 1 : Pt d) := by
        intro x i hij t; ext l
        by_cases hl : l = j
        · subst hl; simp [Function.update, hij.symm]
        · simp [Function.update, hl]
      let c : Pt d → ZMod 2 := fun x => primFn (fun t => D (Function.update x j t)) (x j)
      refine ⟨fun x => h x + c x, ?_⟩
      intro x i hi
      rcases Finset.mem_insert.mp hi with rfl | hi
      · have hF : (fun t => D (Function.update (x + Pi.single i 1) i t))
            = (fun t => D (Function.update x i t)) := funext fun t => by rw [hupd]
        have hc : c (x + Pi.single i 1) = c x + D x := by
          simp only [c]
          rw [hF]
          have : (x + (Pi.single i 1 : Pt d)) i = x i + 1 := by simp
          rw [this, primFn_succ]
          simp
        show h (x + Pi.single i 1) + c (x + Pi.single i 1) = h x + c x + f x i
        rw [hc]
        simp only [hD]
        exact z2_aux2 _ _ _ _
      · have hij : i ≠ j := fun e => hj (e ▸ hi)
        have hF : (fun t => D (Function.update (x + Pi.single i 1) j t))
            = (fun t => D (Function.update x j t)) :=
          funext fun t => by rw [hupd2 x i hij, hDinv _ i hi]
        have hc : c (x + Pi.single i 1) = c x := by
          simp only [c]
          rw [hF]
          have : (x + (Pi.single i 1 : Pt d)) j = x j := by simp [hij.symm]
          rw [this]
        show h (x + Pi.single i 1) + c (x + Pi.single i 1) = h x + c x + f x i
        rw [hc, hh x i hi]
        abel
  obtain ⟨h, hh⟩ := key Finset.univ
  exact ⟨h, fun x i => hh x i (Finset.mem_univ i)⟩

end Balaban.LatticeGeom
