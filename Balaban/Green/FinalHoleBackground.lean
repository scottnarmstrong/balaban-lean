module

public import Balaban.Background.Def5
public import Balaban.LargeField.Characteristic.RealDomain

/-!
# Variational background of a retained datum

Theorem 7.1 of the landed P2 background theory works on every generating set, including
the set generated by the complement of a selected last-scale bad region. The datum's real
domain and its distance from the constant unit direction remain explicit physical clauses.
-/

@[expose] public section

namespace Balaban.Green

open Balaban.Background Balaban.Multiscale

/-- The P2 minimizer on any chosen generating set is unique and remains within
`K₁ δ + η` of the constant direction if its datum is within `η`. -/
theorem finalHoleBackground_of_retained_datum
    {d L N₀ k N : ℕ} [NeZero N₀] [NeZero L] {ϱ : ℝ}
    {G : GeneratingSet d L N₀ k ϱ} {a : ℕ → ℝ} {ν δ η : ℝ}
    (H : BgHyp d L k ϱ a ν) (hδ0 : 0 < δ) (hδ1 : δ ≤ bgC1 d L N)
    {D : BgData G N} (hD : InDomainR G ν δ D)
    (h : Fin N → ℝ)
    (hData : ∀ x : G.Ω 1,
      vn (fun i => D.Ψ x i - (h i : ℂ)) ≤ η) :
    (∃! φ : G.Ω 1 × Fin N → ℂ, IsMinimizer G a ν D φ) ∧
      IsRealUnitField G (bgField G a ν D) ∧
      IsSmallSolution G a ν (bgC0 d L N) D
        (bgField G a ν D) (bgMult G a ν D) ∧
      (∀ x : G.Ω 1,
        vn (fun i => bgField G a ν D (x, i) - (h i : ℂ)) ≤
          bgK1 d L N * δ + η) := by
  have hU : InUnionDomainR G (bgC1 d L N) ν D := ⟨δ, hδ0, hδ1, hD⟩
  obtain ⟨hu, hr, hs, -, hb⟩ := theorem71 H hU
  refine ⟨hu, hr, hs, fun x => ?_⟩
  have hv := (hb δ hδ0 hδ1 hD).val x
  have ht := vn_triangle
    (fun i => bgField G a ν D (x, i)) (D.Ψ x) (fun i => (h i : ℂ))
  exact ht.trans (add_le_add hv (hData x))

/-- The variational background at a real retained datum is the value of one analytic
function of the complex raw data. The source domain is the full landed P2 union domain. -/
theorem finalHoleBackground_analytic_of_retained_datum
    {d L N₀ k N : ℕ} [NeZero N₀] [NeZero L] {ϱ : ℝ}
    {G : GeneratingSet d L N₀ k ϱ} {a : ℕ → ℝ} {ν δ : ℝ}
    (H : BgHyp d L k ϱ a ν) (hδ0 : 0 < δ) (hδ1 : δ ≤ bgC1 d L N)
    {D : BgData G N} (hD : InDomainR G ν δ D) :
    ∃ F : RawData d L N₀ k N → (G.Ω 1 × Fin N → ℂ) × (G.Ω 1 → ℂ),
      AnalyticOnNhd ℂ F {p | ∃ E : BgData G N,
        InUnionDomainC G (bgC0 d L N) (bgC1 d L N) ν E ∧ p = (E.Ψ, E.h)} ∧
      F (D.Ψ, D.h) = (bgField G a ν D, bgMult G a ν D) := by
  have hU : InUnionDomainR G (bgC1 d L N) ν D := ⟨δ, hδ0, hδ1, hD⟩
  have hC := Balaban.LargeField.inUnionDomainC_of_R H hU
  obtain ⟨F, hF, hval⟩ := theorem72_analytic (G := G) H
  refine ⟨F, hF, ?_⟩
  rw [hval D hC]
  rw [(theorem72_real H hU).1, (theorem72_real H hU).2]

end Balaban.Green
