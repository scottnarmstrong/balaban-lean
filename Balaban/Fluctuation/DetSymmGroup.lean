/-!
# Covariance of the determinant activities under the generated symmetry group

Let `G` be a level set of the top level `k + 1` (`IsLevel G (k + 1)`) and `L ^ m₀ ∣ N₁`.  The
group `GenSymm` is generated by the translations by vectors divisible by the cell side
`L ^ (k + 1 + m₀ + m₁)`, all coordinate permutations and the reflections
`x_μ₀ ↦ c - 1 - x_μ₀` with `L ^ (k + 1 + m₀ + m₁) ∣ c.val`.  This file discharges, for every
element `σ` of this group, the structural premises of `detActivityBg_sym`:

* `UnitBlockPres σ` (`unitBlockPres_of_genSymm`), with composition (`UnitBlockPres.trans`);
* `σ ∈ pavingSymGroup L m₀ (k + 1)` (`genSymm_mem_pavingSymGroup`): the group generated here is a
  subgroup of the symmetry group of the paving;
* the patch-image identity `Pset (τ q) = σ '' Pset q` (`fullSymm_pset_image`).

Consequences: `detActivityBg_sym_genSymm` and `sum_detActivityBg_sym_genSymm` (covariance of the
determinant activities and of the block sums for the whole group), `exists_detExpansionLocC_sym`
(covariance of the terms of the record `DetExpansionLocC`), and instances at reflections and at a
composite of a translation and a swap of the top level set.

Covariance of the CLASS terms (after the collar regrouping, on the class domain) and covariance
under the spin rotations are NOT proved here.  The statements concern level sets only and are
independent of the choice of generators.
-/

@[expose] public section

namespace Balaban.Fluctuation

open Balaban Balaban.Multiscale Balaban.Background Balaban.Localization Balaban.Analysis
  Balaban.SmallField Balaban.SmallField.Def6 Balaban.Localization.DecEquiv
  Balaban.Localization.DetUnitIncidence Finset Matrix

/-! ### Unit blocks -/

section UnitBlocks

variable {d L N₁ m₁ k : ℕ} [NeZero N₁] [NeZero L]

omit [NeZero N₁] [NeZero L] in
/-- Composition (first `σ`, then `σ'`) preserves the property of preserving the unit blocks. -/
theorem _root_.Balaban.Localization.DetUnitIncidence.UnitBlockPres.trans
    {σ σ' : Equiv.Perm (CTorus d L N₁ m₁ (k + 1))} (h : UnitBlockPres σ) (h' : UnitBlockPres σ') :
    UnitBlockPres (σ.trans σ') := fun x y => by
  simp only [Equiv.trans_apply]
  rw [h' (σ x) (σ y), h x y]

variable {m₀ : ℕ}

/-- **Every symmetry of the group generated by the admissible translations, coordinate
permutations and reflections preserves the unit blocks.** -/
theorem unitBlockPres_of_genSymm {σ : Equiv.Perm (CTorus d L N₁ m₁ (k + 1))}
    (h : GenSymm L N₁ m₁ (k + 1) (k + 1) m₀ σ) : UnitBlockPres σ := by
  induction h with
  | one => exact UnitBlockPres.one
  | translate t ht =>
    exact unitBlockPres_of_torusSymm (j := k) le_rfl (TorusSymm.ofTranslate k t fun μ =>
      (pow_dvd_pow L (by omega)).trans (ht μ))
  | perm π => exact unitBlockPres_of_torusSymm (j := k) le_rfl (TorusSymm.ofCoordPerm k π)
  | reflect μ₀ c hc =>
    exact unitBlockPres_of_torusSymm (j := k) le_rfl
      (TorusSymm.ofReflect k μ₀ c ((pow_dvd_pow L (by omega)).trans hc))
  | trans _ _ ih ih' => exact ih.trans ih'

end UnitBlocks

/-! ### The generated group lies in the symmetry group of the paving -/

section Paving

variable {d L N₁ m₁ K : ℕ} [NeZero N₁] [NeZero L] {m₀ : ℕ}

private abbrev PG (L m₀ K : ℕ) : Subgroup (Equiv.Perm (CTorus d L N₁ m₁ K)) :=
  symGroupBy (cellSide L m₀ m₁ K)

/-- The translation vectors `t` with `addRight t` in the group form an additive subgroup. -/
private def transSub (H : Subgroup (Equiv.Perm (CTorus d L N₁ m₁ K))) :
    AddSubgroup (CTorus d L N₁ m₁ K) where
  carrier := {t | (Equiv.addRight t : Equiv.Perm (CTorus d L N₁ m₁ K)) ∈ H}
  zero_mem' := by
    have : (Equiv.addRight (0 : CTorus d L N₁ m₁ K) : Equiv.Perm (CTorus d L N₁ m₁ K)) = 1 := by
      ext x; simp
    show (Equiv.addRight (0 : CTorus d L N₁ m₁ K) : Equiv.Perm (CTorus d L N₁ m₁ K)) ∈ H
    rw [this]; exact H.one_mem
  add_mem' := fun {a b} ha hb => by
    have : (Equiv.addRight (a + b) : Equiv.Perm (CTorus d L N₁ m₁ K)) =
        Equiv.addRight b * Equiv.addRight a := by
      ext x; simp [add_assoc]
    show (Equiv.addRight (a + b) : Equiv.Perm (CTorus d L N₁ m₁ K)) ∈ H
    rw [this]; exact H.mul_mem hb ha
  neg_mem' := fun {a} ha => by
    have : (Equiv.addRight (-a) : Equiv.Perm (CTorus d L N₁ m₁ K)) =
        (Equiv.addRight a)⁻¹ := by
      ext x; simp
    show (Equiv.addRight (-a) : Equiv.Perm (CTorus d L N₁ m₁ K)) ∈ H
    rw [this]; exact H.inv_mem ha

omit [NeZero N₁] [NeZero L] in
private theorem mem_transSub {H : Subgroup (Equiv.Perm (CTorus d L N₁ m₁ K))}
    {t : CTorus d L N₁ m₁ K} :
    t ∈ transSub H ↔ (Equiv.addRight t : Equiv.Perm (CTorus d L N₁ m₁ K)) ∈ H := Iff.rfl

omit [NeZero N₁] [NeZero L] in
private theorem single_mem (s : ℕ) (μ : Fin d) :
    s • (Pi.single μ 1 : CTorus d L N₁ m₁ K) ∈ transSub (symGroupBy s) :=
  Subgroup.subset_closure (Or.inl (Or.inl ⟨μ, rfl⟩))

omit [NeZero N₁] [NeZero L] in
private theorem natCast_single_mem (s j : ℕ) (μ : Fin d) :
    (Pi.single μ ((j * s : ℕ) : ZMod (N₁ * L ^ m₁ * L ^ K)) : CTorus d L N₁ m₁ K) ∈
      transSub (symGroupBy s) := by
  have : (Pi.single μ ((j * s : ℕ) : ZMod (N₁ * L ^ m₁ * L ^ K)) : CTorus d L N₁ m₁ K) =
      j • (s • (Pi.single μ 1 : CTorus d L N₁ m₁ K)) := by
    ext i
    by_cases h : i = μ
    · subst h; simp [mul_comm]
    · simp [h]
  rw [this]
  exact AddSubgroup.nsmul_mem _ (single_mem s μ) j

private theorem translate_mem (s : ℕ) (t : CTorus d L N₁ m₁ K)
    (ht : ∀ μ, s ∣ (t μ).val) :
    (Equiv.addRight t : Equiv.Perm (CTorus d L N₁ m₁ K)) ∈ symGroupBy s := by
  have h : t = ∑ μ, (Pi.single μ (((t μ).val / s * s : ℕ) : ZMod (N₁ * L ^ m₁ * L ^ K)) :
      CTorus d L N₁ m₁ K) := by
    ext i
    rw [Finset.sum_apply, Finset.sum_eq_single i]
    · simp [Nat.div_mul_cancel (ht i)]
    · intro b _ hb; simp [Ne.symm hb]
    · simp
  have : t ∈ transSub (symGroupBy s) := by
    rw [h]
    exact AddSubgroup.sum_mem _ fun μ _ => natCast_single_mem s _ μ
  exact this

private theorem reflect_mem (s : ℕ) (μ₀ : Fin d) (c : ZMod (N₁ * L ^ m₁ * L ^ K))
    (hc : s ∣ c.val) :
    (reflPerm μ₀ c : Equiv.Perm (CTorus d L N₁ m₁ K)) ∈ symGroupBy s := by
  have hflip : (flipBy s μ₀ : Equiv.Perm (CTorus d L N₁ m₁ K)) ∈ symGroupBy s :=
    Subgroup.subset_closure (Or.inl (Or.inr ⟨μ₀, rfl⟩))
  have ht : (Pi.single μ₀ (c - s) : CTorus d L N₁ m₁ K) ∈ transSub (symGroupBy s) := by
    have e : (Pi.single μ₀ (c - s) : CTorus d L N₁ m₁ K) =
        Pi.single μ₀ ((c.val / s * s : ℕ) : ZMod (N₁ * L ^ m₁ * L ^ K)) -
          s • (Pi.single μ₀ 1 : CTorus d L N₁ m₁ K) := by
      ext i
      by_cases h : i = μ₀
      · subst h
        simp [Nat.div_mul_cancel hc]
      · simp [h]
    rw [e]
    exact AddSubgroup.sub_mem _ (natCast_single_mem s _ μ₀) (single_mem s μ₀)
  have e : (reflPerm μ₀ c : Equiv.Perm (CTorus d L N₁ m₁ K)) =
      Equiv.addRight (Pi.single μ₀ (c - s) : CTorus d L N₁ m₁ K) * flipBy s μ₀ := by
    ext x i
    by_cases h : i = μ₀
    · subst h; simp [reflPerm, flipBy]; ring
    · simp [reflPerm, flipBy, h]
  rw [e]
  exact (symGroupBy s).mul_mem ht hflip

omit [NeZero N₁] [NeZero L] in
private theorem coordPerm_mem (s : ℕ) (π : Equiv.Perm (Fin d)) :
    (coordPerm π : Equiv.Perm (CTorus d L N₁ m₁ K)) ∈ symGroupBy s := by
  induction π using Equiv.Perm.swap_induction_on with
  | one =>
    have : (coordPerm (1 : Equiv.Perm (Fin d)) : Equiv.Perm (CTorus d L N₁ m₁ K)) = 1 := by
      ext x i; rfl
    rw [this]; exact (symGroupBy s).one_mem
  | swap_mul f x y hxy ih =>
    have e : (coordPerm (Equiv.swap x y * f) : Equiv.Perm (CTorus d L N₁ m₁ K)) =
        swapJ x y * coordPerm f := by
      ext z i
      simp only [coordPerm, swapJ, Equiv.coe_fn_mk, Equiv.Perm.mul_apply, Function.comp]
      rw [Equiv.Perm.mul_def, Equiv.symm_trans_apply, Equiv.symm_swap]
    rw [e]
    exact (symGroupBy s).mul_mem (Subgroup.subset_closure (Or.inr ⟨x, y, rfl⟩)) ih

/-- **The group generated by the admissible translations, coordinate permutations and
reflections is a subgroup of the symmetry group of the paving.**  The generators of `GenSymm` at
the level `n = K` are the translations by vectors divisible by the cell side
`L ^ (K + m₀ + m₁)`, the coordinate permutations and the reflections `x_μ ↦ c - 1 - x_μ` with
the cell side dividing `c`; each of them is a product of generators of `pavingSymGroup`
(translations by one cell side, the reflections `x_μ ↦ cell side - 1 - x_μ`, coordinate
exchanges).  Hence every element of `GenSymm` lies in `pavingSymGroup L m₀ K`.  The two groups
have the same generators in this sense, so the inclusion is the only direction used. -/
theorem genSymm_mem_pavingSymGroup {σ : Equiv.Perm (CTorus d L N₁ m₁ K)}
    (h : GenSymm L N₁ m₁ K K m₀ σ) :
    σ ∈ pavingSymGroup (N₁ := N₁) (m₁ := m₁) (k := K) (d := d) L m₀ K := by
  induction h with
  | one => exact one_mem _
  | translate t ht => exact translate_mem _ t ht
  | perm π => exact coordPerm_mem _ π
  | reflect μ₀ c hc => exact reflect_mem _ μ₀ c hc
  | trans _ _ ih ih' => exact (pavingSymGroup L m₀ K).mul_mem ih' ih

end Paving

/-! ### Covariance of the determinant activities for the whole group -/

section Covariance

variable {d L N₁ m₁ k N : ℕ} [NeZero N₁] [NeZero L] {ϱ : ℝ} {m₀ : ℕ}

/-- The patch-image identity for the cover symmetry of a full symmetry bundle. -/
theorem fullSymm_pset_image {G : GeneratingSet d L (N₁ * L ^ m₁) (k + 1) ϱ}
    {σ : Equiv.Perm (CTorus d L N₁ m₁ (k + 1))} (F : FullSymm G m₀ σ) :
    ∀ q ∈ cubeIdx G, Pset m₁ (F.cover.τ q) = σ '' Pset m₁ q :=
  fun _ hq => (F.polymer.image_pset hq).symm

open Classical in
/-- **Covariance of the determinant activities under the whole generated group.**  For a level
set `G` of the top level and every `σ` in the group generated by the admissible translations,
coordinate permutations and reflections there are a lattice symmetry `S` of `G`, a proof `hU`
that `σ` preserves the unit blocks, and for all data the identity
`detActivityBg (S.sym D) (u y) (σ • Y) = detActivityBg D y Y` (`u = unitAct G S hU`). -/
theorem detActivityBg_sym_genSymm {G : GeneratingSet d L (N₁ * L ^ m₁) (k + 1) ϱ}
    (hG : IsLevel G (k + 1)) (hN : L ^ m₀ ∣ N₁) {σ : Equiv.Perm (CTorus d L N₁ m₁ (k + 1))}
    (h : GenSymm L N₁ m₁ (k + 1) (k + 1) m₀ σ) (a : ℕ → ℝ) (aT ν : ℝ) :
    ∃ (S : LatSymm G G σ) (hU : UnitBlockPres σ),
      ∀ (ρ : ℝ) (D : BgData G N) (y : unitPts G)
        (Y : Finset (CubeB (d := d) (L := L) (N₁ := N₁) (m₁ := m₁) (K := k + 1) m₀ (k + 1)
          Set.univ)),
        detActivityBg m₀ a aT ν ρ (S.sym D) (unitAct G S hU y) (cubeAct σ Y) =
          detActivityBg m₀ a aT ν ρ D y Y := by
  obtain ⟨F⟩ := FullSymm.of_genSymm hG hN h
  have hU := unitBlockPres_of_genSymm h
  exact ⟨F.lat, hU, fun ρ D y Y => detActivityBg_sym F.lat hU F.cover F.block hN
    (genSymm_mem_pavingSymGroup h) (fullSymm_pset_image F) y ρ D Y⟩

open Classical in
/-- **Covariance of the block sums under the whole generated group**: the sums of the
determinant activities over the unit blocks of `B(σ z)` and of `B(z)` agree. -/
theorem sum_detActivityBg_sym_genSymm (St : StepSetting d L N₁ m₁ k N ϱ)
    (hG : IsLevel St.G' (k + 1)) (hN : L ^ m₀ ∣ N₁)
    {σ : Equiv.Perm (CTorus d L N₁ m₁ (k + 1))}
    (h : GenSymm L N₁ m₁ (k + 1) (k + 1) m₀ σ) :
    ∃ S : LatSymm St.G' St.G' σ, ∀ (ρ : ℝ) (D : BgData St.G' N)
      (z : Torus d (N₁ * L ^ m₁ * L ^ (k + 1 - (k + 1))))
      (T : Finset (CubeB (d := d) (L := L) (N₁ := N₁) (m₁ := m₁) (K := k + 1) m₀ (k + 1)
        Set.univ)),
      ∑ y' ∈ St.blockU (rootAct σ z), detActivityBg m₀ St.a St.a₁ St.ν ρ (S.sym D) y'
          (cubeAct σ T) =
        ∑ y ∈ St.blockU z, detActivityBg m₀ St.a St.a₁ St.ν ρ D y T := by
  obtain ⟨F⟩ := FullSymm.of_genSymm hG hN h
  exact ⟨F.lat, fun ρ D z T => sum_detActivityBg_sym St F.lat (unitBlockPres_of_genSymm h)
    F.cover F.block hN (genSymm_mem_pavingSymGroup h) (fullSymm_pset_image F) D z T⟩

end Covariance

/-! ### Covariance of the terms of the record -/

section Record

variable {d L N₁ m₁ k N : ℕ} [NeZero L] [NeZero N₁] {ϱ ϱm : ℝ} {m₀ : ℕ}
variable (S : StepSetting d L N₁ m₁ k N ϱ)
  {Hm : GeneratingSet d L (N₁ * L ^ m₁) (k + 1) ϱm}
  {c BG κ eps Kc Cx c₂ BG₂ δ₁ δc : ℝ}

open Classical in
/-- **Covariance of the terms of the localized determinant family under the whole generated
group.**  Under the hypotheses of `exists_detExpansionLocC_of_chart`, for a step whose top level
set `S.G'` is a level set and every `σ` in the generated group there are records `E` for the
root `z` and `E'` for the root `rootAct σ z`, with the same rate and constant, and a lattice
symmetry `Sy` of `S.G'`, such that `Sy.sym` maps the data of the chart `Ξ^c(𝔹_{k+1}; 1, eps)` to
data of the chart, and `E'.term (Sy.sym D) (σ • T) = E.term D T` for all data `D` and sets `T`
of cubes. -/
theorem exists_detExpansionLocC_sym
    (hC : FlCore N S.G' Hm S.a₁ S.ν c BG κ eps Kc Cx c₂ BG₂ δ₁) (hδc : 0 ≤ δc)
    (hMX : cstarX d L * Real.exp (N0 d L * κ) ≤ (L : ℝ) ^ m₁)
    (hdm : decDomMargin d L N BG κ (xiC1 d * eps) < δc)
    (hα : K4 d L N BG κ * (xiC1 d * eps) < coerciveConst d / 2)
    (hsm : δc ^ 2 * smallConstX d L κ ≤ 1 / 4) (hconn : HatConn S.G') (hN : L ^ m₀ ∣ N₁)
    (hz : ((detDeg d L + 1 : ℕ) : ℝ) ^ 2 * (2 / Real.exp κ) < 1)
    (hG : IsLevel S.G' (k + 1)) {σ : Equiv.Perm (CTorus d L N₁ m₁ (k + 1))}
    (h : GenSymm L N₁ m₁ (k + 1) (k + 1) m₀ σ)
    (z : Torus d (N₁ * L ^ m₁ * L ^ (k + 1 - (k + 1)))) :
    ∃ (E : DetExpansionLocC S m₀ z eps
        ((κ - Real.log 2 - 2 * Real.log ((detDeg d L + 1 : ℕ) : ℝ)) / (2 * d * L))
        ((L : ℝ) ^ d * ((1 / 2 : ℝ) * N * covBLog d L (S.a k) (S.a₁ / (L : ℝ) ^ 2) κ /
          (1 - ((detDeg d L + 1 : ℕ) : ℝ) ^ 2 * (2 / Real.exp κ)))))
      (E' : DetExpansionLocC S m₀ (rootAct σ z) eps
        ((κ - Real.log 2 - 2 * Real.log ((detDeg d L + 1 : ℕ) : ℝ)) / (2 * d * L))
        ((L : ℝ) ^ d * ((1 / 2 : ℝ) * N * covBLog d L (S.a k) (S.a₁ / (L : ℝ) ^ 2) κ /
          (1 - ((detDeg d L + 1 : ℕ) : ℝ) ^ 2 * (2 / Real.exp κ))))),
      ∃ Sy : LatSymm S.G' S.G' σ,
        (∀ D : BgData S.G' N, XiCData S.G' S.a S.ν (k + 1) 1 eps D →
          XiCData S.G' S.a S.ν (k + 1) 1 eps (Sy.sym D)) ∧
        ∀ (D : BgData S.G' N) T, E'.term (Sy.sym D) (cubeAct σ T) = E.term D T := by
  obtain ⟨E, hE⟩ := exists_detExpansionLocC_of_chart S hC hδc hMX hdm hα hsm hconn hN hz z
  obtain ⟨E', hE'⟩ := exists_detExpansionLocC_of_chart S hC hδc hMX hdm hα hsm hconn hN hz
    (rootAct σ z)
  obtain ⟨Sy, hSy⟩ := sum_detActivityBg_sym_genSymm S hG hN h
  refine ⟨E, E', Sy, fun D hD => xiCData_sym Sy hD, fun D T => ?_⟩
  rw [hE', hE]
  exact hSy _ D z T

end Record

/-! ### Non-vacuity at the top level set of the level step -/

section Inhabited

open Balaban.Inhabited Balaban.Inhabited.LevelStep

variable (m₁ k : ℕ) (ϱ : ℝ) {N : ℕ}

/-- **Covariance of the determinant activities at a reflection of the top level set**
`lvTop 3 m₁ k ϱ` (`d = L = N₁ = 3`, `m₀ = 0`): for `c` with `3 ^ (k + 1 + m₁) ∣ c.val` and
`c.val ≠ 1` the reflection `x_μ₀ ↦ c - 1 - x_μ₀` is not the identity, and the determinant
activities are covariant under it. -/
theorem detActivityBg_sym_reflect_lvTop (μ₀ : Fin 3) (c : ZMod ((3 * 3 ^ m₁) * 3 ^ (k + 1)))
    (hc : 3 ^ (k + 1 + m₁) ∣ c.val) (hc1 : c.val ≠ 1) (a : ℕ → ℝ) (aT ν : ℝ) :
    (reflPerm μ₀ c : Equiv.Perm (CTorus 3 3 3 m₁ (k + 1))) ≠ 1 ∧
    ∃ (S : LatSymm (lvTop 3 m₁ k ϱ) (lvTop 3 m₁ k ϱ) (reflPerm μ₀ c))
      (hU : UnitBlockPres (reflPerm μ₀ c : Equiv.Perm (CTorus 3 3 3 m₁ (k + 1)))),
      ∀ (ρ : ℝ) (D : BgData (lvTop 3 m₁ k ϱ) N) (y : unitPts (lvTop 3 m₁ k ϱ))
        (Y : Finset (CubeB (d := 3) (L := 3) (N₁ := 3) (m₁ := m₁) (K := k + 1) 0 (k + 1)
          Set.univ)),
        detActivityBg 0 a aT ν ρ (S.sym D) (unitAct (lvTop 3 m₁ k ϱ) S hU y)
            (cubeAct (reflPerm μ₀ c) Y) =
          detActivityBg 0 a aT ν ρ D y Y :=
  ⟨reflect_ne_one m₁ k μ₀ c hc1, detActivityBg_sym_genSymm (isLevel_lvTop) (by norm_num)
    (GenSymm.reflect μ₀ c (by simpa using hc)) a aT ν⟩

/-- The reflection with `c = 0`. -/
theorem detActivityBg_sym_reflect_zero_lvTop (μ₀ : Fin 3) (a : ℕ → ℝ) (aT ν : ℝ) :
    (reflPerm μ₀ (0 : ZMod ((3 * 3 ^ m₁) * 3 ^ (k + 1))) : Equiv.Perm (CTorus 3 3 3 m₁ (k + 1))) ≠ 1 ∧
    ∃ (S : LatSymm (lvTop 3 m₁ k ϱ) (lvTop 3 m₁ k ϱ) (reflPerm μ₀ (0 : ZMod ((3 * 3 ^ m₁) * 3 ^ (k + 1)))))
      (hU : UnitBlockPres (reflPerm μ₀ (0 : ZMod ((3 * 3 ^ m₁) * 3 ^ (k + 1))) : Equiv.Perm (CTorus 3 3 3 m₁ (k + 1)))),
      ∀ (ρ : ℝ) (D : BgData (lvTop 3 m₁ k ϱ) N) (y : unitPts (lvTop 3 m₁ k ϱ))
        (Y : Finset (CubeB (d := 3) (L := 3) (N₁ := 3) (m₁ := m₁) (K := k + 1) 0 (k + 1)
          Set.univ)),
        detActivityBg 0 a aT ν ρ (S.sym D) (unitAct (lvTop 3 m₁ k ϱ) S hU y)
            (cubeAct (reflPerm μ₀ (0 : ZMod ((3 * 3 ^ m₁) * 3 ^ (k + 1)))) Y) =
          detActivityBg 0 a aT ν ρ D y Y :=
  detActivityBg_sym_reflect_lvTop (N := N) m₁ k ϱ μ₀ 0 (by simp) (by simp) a aT ν

/-- The reflection with `c = 3 ^ (k + 1 + m₁)` (`stepVec m₁ k 0`). -/
theorem detActivityBg_sym_reflect_stepVec_lvTop (μ₀ : Fin 3) (a : ℕ → ℝ) (aT ν : ℝ) :
    (reflPerm μ₀ (stepVec m₁ k 0) : Equiv.Perm (CTorus 3 3 3 m₁ (k + 1))) ≠ 1 ∧
    ∃ (S : LatSymm (lvTop 3 m₁ k ϱ) (lvTop 3 m₁ k ϱ) (reflPerm μ₀ (stepVec m₁ k 0)))
      (hU : UnitBlockPres (reflPerm μ₀ (stepVec m₁ k 0) : Equiv.Perm (CTorus 3 3 3 m₁ (k + 1)))),
      ∀ (ρ : ℝ) (D : BgData (lvTop 3 m₁ k ϱ) N) (y : unitPts (lvTop 3 m₁ k ϱ))
        (Y : Finset (CubeB (d := 3) (L := 3) (N₁ := 3) (m₁ := m₁) (K := k + 1) 0 (k + 1)
          Set.univ)),
        detActivityBg 0 a aT ν ρ (S.sym D) (unitAct (lvTop 3 m₁ k ϱ) S hU y)
            (cubeAct (reflPerm μ₀ (stepVec m₁ k 0)) Y) =
          detActivityBg 0 a aT ν ρ D y Y :=
  detActivityBg_sym_reflect_lvTop (N := N) m₁ k ϱ μ₀ (stepVec m₁ k 0) (stepVec_dvd m₁ k 0)
    (by rw [stepVec_val]; exact (Nat.one_lt_pow (by omega) (by norm_num)).ne') a aT ν

/-- **Covariance at a composite**: the translation by `stepVec` followed by the coordinate swap
is not the identity, belongs to the generated group, and the determinant activities are covariant
under it. -/
theorem detActivityBg_sym_translate_swap_lvTop (a : ℕ → ℝ) (aT ν : ℝ) :
    ((Equiv.addRight (stepVec m₁ k)).trans (coordPerm swap01) :
        Equiv.Perm (CTorus 3 3 3 m₁ (k + 1))) ≠ 1 ∧
    ∃ (S : LatSymm (lvTop 3 m₁ k ϱ) (lvTop 3 m₁ k ϱ)
        ((Equiv.addRight (stepVec m₁ k)).trans (coordPerm swap01)))
      (hU : UnitBlockPres ((Equiv.addRight (stepVec m₁ k)).trans (coordPerm swap01) :
        Equiv.Perm (CTorus 3 3 3 m₁ (k + 1)))),
      ∀ (ρ : ℝ) (D : BgData (lvTop 3 m₁ k ϱ) N) (y : unitPts (lvTop 3 m₁ k ϱ))
        (Y : Finset (CubeB (d := 3) (L := 3) (N₁ := 3) (m₁ := m₁) (K := k + 1) 0 (k + 1)
          Set.univ)),
        detActivityBg 0 a aT ν ρ (S.sym D) (unitAct (lvTop 3 m₁ k ϱ) S hU y)
            (cubeAct ((Equiv.addRight (stepVec m₁ k)).trans (coordPerm swap01)) Y) =
          detActivityBg 0 a aT ν ρ D y Y := by
  refine ⟨?_, detActivityBg_sym_genSymm (isLevel_lvTop) (by norm_num)
    (GenSymm.trans (GenSymm.translate _ (fun μ => by simpa using stepVec_dvd m₁ k μ))
      (GenSymm.perm swap01)) a aT ν⟩
  intro h
  have h0 := congrArg (fun σ : Equiv.Perm (CTorus 3 3 3 m₁ (k + 1)) => (σ 0) 0) h
  have hv : stepVec m₁ k 0 = 0 := by simpa [coordPerm, stepVec] using h0
  have := stepVec_val m₁ k 0
  rw [hv, ZMod.val_zero] at this
  exact (pow_pos (by norm_num : (0 : ℕ) < 3) _).ne this

end Inhabited

end Balaban.Fluctuation
