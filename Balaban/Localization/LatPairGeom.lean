/-!
# The symmetry data between two generating sets related by an element of the paving group

For `r` in the group `symGroupBy s` generated by the translations by `s`, the reflections
`x_μ ↦ s - 1 - x_μ` and the coordinate exchanges (`pavingSymGroup L m₀ K` for
`s = L ^ (K + m₀ + m₁)`), with `L ^ (K + m₁) ∣ s`:

* `exists_cubeAct_of_mem_symGroupBy`: there is a permutation `τ` of the centres `(j, y₀)` of the
  cubes of side `L ^ (j + m₁)` carried by `r` (layer kept, bumps, interaction boxes, cube bases
  and cells transported);
* `exists_blockAct_of_mem_symGroupBy`: the same for the blocks of side `L ^ j`;
these do not involve any generating set (closure induction over the generators; the inverse and
the products are handled once, generically).  Then for two generating sets `G`, `G'` with
`Ω_i(G') = r Ω_i(G)`:

* `coverData_of_cubeAct`: the fields `hidx`, `hchi`, `hbox`, `hqset` of the transport of the
  covers `coverOf G → coverOf G'` (cube-aligned sets);
* `blockData_of_blockAct`: the fields `hbidx`, `hblayer`, `hbump`, `hbbase` of the transport of the
  blocks;
* `nonempty_latSymm_of_mem_symGroupBy`: the lattice symmetry `LatSymm G G' r`;
* `unitBlockPres_of_mem_symGroupBy`: `r` preserves the unit blocks;
* `genSymm_of_mem_pavingSymGroup`: the paving group is generated as a monoid by the admissible
  translations, reflections and coordinate permutations (`GenSymm`, inverse closure
  `genSymm_inv`), so the symmetry bundle `FullSymm` of a level set exists for all its elements
  (`nonempty_fullSymm_of_mem_pavingSymGroup`).
-/

@[expose] public section

namespace Balaban.Localization.DecEquiv

open Balaban Balaban.Multiscale Balaban.Background Balaban.SmallField Balaban.SmallField.Def6
  Balaban.Fluctuation Finset

variable {d L N₁ m₁ K : ℕ} [NeZero N₁] [NeZero L] {ϱ : ℝ}

omit [NeZero N₁] [NeZero L] in
theorem dvd_val_natCast_side {j s : ℕ} (hj : j ≤ K) (hs : L ^ (j + m₁) ∣ s) :
    L ^ (j + m₁) ∣ (((s : ℕ) : ZMod ((N₁ * L ^ m₁) * L ^ K))).val := by
  rw [ZMod.val_natCast]
  exact (Nat.dvd_mod_iff (dvd_side hj)).2 hs

omit [NeZero N₁] [NeZero L] in
theorem dvd_val_natCast_side' {j s : ℕ} (hj : j ≤ K) (hs : L ^ j ∣ s) :
    L ^ j ∣ (((s : ℕ) : ZMod ((N₁ * L ^ m₁) * L ^ K))).val := by
  rw [ZMod.val_natCast]
  exact (Nat.dvd_mod_iff (dvd_side' hj)).2 hs

omit [NeZero N₁] [NeZero L] in
theorem dvd_val_transVec {a s : ℕ} (μ μ' : Fin d)
    (h : a ∣ (((s : ℕ) : ZMod ((N₁ * L ^ m₁) * L ^ K))).val) :
    a ∣ ((s • (Pi.single μ 1 : CTorus d L N₁ m₁ K)) μ').val := by
  by_cases hμ : μ' = μ
  · subst hμ
    simpa using h
  · simp [hμ]

/-! ### The action on the cubes and on the blocks, without generating sets -/

section Act

omit [NeZero N₁] [NeZero L] in
/-- `f (f⁻¹ x) = x` for a permutation. -/
theorem apply_inv_self_perm {α : Type*} (f : Equiv.Perm α) (x : α) : f (f⁻¹ x) = x :=
  f.apply_symm_apply x

omit [NeZero N₁] [NeZero L] in
/-- The cube properties are stable under products. -/
theorem cubeAct_mul {g g' : Equiv.Perm (CTorus d L N₁ m₁ K)}
    {τ τ' : Equiv.Perm (ℕ × CTorus d L N₁ m₁ K)}
    (H : (∀ q, (τ q).1 = q.1) ∧
      (∀ j y x, cubeBump m₁ j (τ (j, y)).2 (g x) = cubeBump m₁ j y x) ∧
      (∀ j y x R, InBox m₁ j (τ (j, y)).2 R (g x) ↔ InBox m₁ j y R x) ∧
      (∀ j y, j ≤ K → (CubeBase m₁ j (τ (j, y)).2 ↔ CubeBase m₁ j y)) ∧
      (∀ j y y', j ≤ K → CubeBase m₁ j y →
        (SameCell (L ^ (j + m₁)) (g y') (τ (j, y)).2 ↔ SameCell (L ^ (j + m₁)) y' y)))
    (H' : (∀ q, (τ' q).1 = q.1) ∧
      (∀ j y x, cubeBump m₁ j (τ' (j, y)).2 (g' x) = cubeBump m₁ j y x) ∧
      (∀ j y x R, InBox m₁ j (τ' (j, y)).2 R (g' x) ↔ InBox m₁ j y R x) ∧
      (∀ j y, j ≤ K → (CubeBase m₁ j (τ' (j, y)).2 ↔ CubeBase m₁ j y)) ∧
      (∀ j y y', j ≤ K → CubeBase m₁ j y →
        (SameCell (L ^ (j + m₁)) (g' y') (τ' (j, y)).2 ↔ SameCell (L ^ (j + m₁)) y' y))) :
    (∀ q, ((τ * τ') q).1 = q.1) ∧
      (∀ j y x, cubeBump m₁ j ((τ * τ') (j, y)).2 ((g * g') x) = cubeBump m₁ j y x) ∧
      (∀ j y x R, InBox m₁ j ((τ * τ') (j, y)).2 R ((g * g') x) ↔ InBox m₁ j y R x) ∧
      (∀ j y, j ≤ K → (CubeBase m₁ j ((τ * τ') (j, y)).2 ↔ CubeBase m₁ j y)) ∧
      (∀ j y y', j ≤ K → CubeBase m₁ j y →
        (SameCell (L ^ (j + m₁)) ((g * g') y') ((τ * τ') (j, y)).2 ↔ SameCell (L ^ (j + m₁)) y' y)) := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := H
  obtain ⟨h1', h2', h3', h4', h5'⟩ := H'
  have e : ∀ j y, τ' (j, y) = (j, (τ' (j, y)).2) := fun j y => Prod.ext (h1' _) rfl
  refine ⟨fun q => by simp [h1, h1'], fun j y x => ?_, fun j y x R => ?_,
    fun j y hj => ?_, fun j y y' hj hy => ?_⟩
  · simp only [Equiv.Perm.coe_mul, Function.comp_apply]
    rw [e j y, h2, h2']
  · simp only [Equiv.Perm.coe_mul, Function.comp_apply]
    rw [e j y, h3, h3']
  · simp only [Equiv.Perm.coe_mul, Function.comp_apply]
    rw [e j y, h4 _ _ hj, h4' _ _ hj]
  · simp only [Equiv.Perm.coe_mul, Function.comp_apply]
    rw [e j y, h5 _ _ _ hj ((h4' _ _ hj).2 hy), h5' _ _ _ hj hy]

omit [NeZero N₁] [NeZero L] in
/-- The cube properties are stable under inverses. -/
theorem cubeAct_inv {g : Equiv.Perm (CTorus d L N₁ m₁ K)}
    {τ : Equiv.Perm (ℕ × CTorus d L N₁ m₁ K)}
    (H : (∀ q, (τ q).1 = q.1) ∧
      (∀ j y x, cubeBump m₁ j (τ (j, y)).2 (g x) = cubeBump m₁ j y x) ∧
      (∀ j y x R, InBox m₁ j (τ (j, y)).2 R (g x) ↔ InBox m₁ j y R x) ∧
      (∀ j y, j ≤ K → (CubeBase m₁ j (τ (j, y)).2 ↔ CubeBase m₁ j y)) ∧
      (∀ j y y', j ≤ K → CubeBase m₁ j y →
        (SameCell (L ^ (j + m₁)) (g y') (τ (j, y)).2 ↔ SameCell (L ^ (j + m₁)) y' y))) :
    (∀ q, (τ⁻¹ q).1 = q.1) ∧
      (∀ j y x, cubeBump m₁ j (τ⁻¹ (j, y)).2 (g⁻¹ x) = cubeBump m₁ j y x) ∧
      (∀ j y x R, InBox m₁ j (τ⁻¹ (j, y)).2 R (g⁻¹ x) ↔ InBox m₁ j y R x) ∧
      (∀ j y, j ≤ K → (CubeBase m₁ j (τ⁻¹ (j, y)).2 ↔ CubeBase m₁ j y)) ∧
      (∀ j y y', j ≤ K → CubeBase m₁ j y →
        (SameCell (L ^ (j + m₁)) (g⁻¹ y') (τ⁻¹ (j, y)).2 ↔ SameCell (L ^ (j + m₁)) y' y)) := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := H
  have e : ∀ j y, τ⁻¹ (j, y) = (j, (τ⁻¹ (j, y)).2) := fun j y => by
    refine Prod.ext ?_ rfl
    have := h1 (τ⁻¹ (j, y))
    simp only [apply_inv_self_perm] at this
    exact this.symm
  have hτ : ∀ j y, τ (j, (τ⁻¹ (j, y)).2) = (j, y) := fun j y => by
    rw [← e j y, apply_inv_self_perm]
  refine ⟨fun q => ?_, fun j y x => ?_, fun j y x R => ?_, fun j y hj => ?_,
    fun j y y' hj hy => ?_⟩
  · have := h1 (τ⁻¹ q)
    simp only [apply_inv_self_perm] at this
    exact this.symm
  · have := h2 j (τ⁻¹ (j, y)).2 (g⁻¹ x)
    rw [hτ, apply_inv_self_perm] at this
    exact this.symm
  · have := h3 j (τ⁻¹ (j, y)).2 (g⁻¹ x) R
    rw [hτ, apply_inv_self_perm] at this
    exact this.symm
  · have := h4 j (τ⁻¹ (j, y)).2 hj
    rw [hτ] at this
    exact this.symm
  · have hb : CubeBase m₁ j (τ⁻¹ (j, y)).2 := by
      have := h4 j (τ⁻¹ (j, y)).2 hj
      rw [hτ] at this
      exact this.1 hy
    have := h5 j (τ⁻¹ (j, y)).2 (g⁻¹ y') hj hb
    rw [hτ, apply_inv_self_perm] at this
    exact this.symm

/-- The cube properties for the generators of `symGroupBy s`. -/
theorem cubeAct_gen {s : ℕ} (hs : L ^ (K + m₁) ∣ s) {g : Equiv.Perm (CTorus d L N₁ m₁ K)}
    (hg : g ∈ ({g | ∃ μ, g = transBy (N₁ := N₁) (m₁ := m₁) (k := K) (L := L) s μ} ∪
      {g | ∃ μ, g = flipBy (N₁ := N₁) (m₁ := m₁) (k := K) (L := L) s μ} ∪
      {g | ∃ μ ν, g = swapJ (N₁ := N₁) (m₁ := m₁) (k := K) (L := L) μ ν})) :
    ∃ τ : Equiv.Perm (ℕ × CTorus d L N₁ m₁ K), (∀ q, (τ q).1 = q.1) ∧
      (∀ j y x, cubeBump m₁ j (τ (j, y)).2 (g x) = cubeBump m₁ j y x) ∧
      (∀ j y x R, InBox m₁ j (τ (j, y)).2 R (g x) ↔ InBox m₁ j y R x) ∧
      (∀ j y, j ≤ K → (CubeBase m₁ j (τ (j, y)).2 ↔ CubeBase m₁ j y)) ∧
      (∀ j y y', j ≤ K → CubeBase m₁ j y →
        (SameCell (L ^ (j + m₁)) (g y') (τ (j, y)).2 ↔ SameCell (L ^ (j + m₁)) y' y)) := by
  have hsj : ∀ j, j ≤ K → L ^ (j + m₁) ∣ s := fun j hj =>
    (pow_dvd_pow L (by omega)).trans hs
  have hs0 : ∀ j, 0 < L ^ (j + m₁) := fun j => Nat.pos_of_ne_zero (pow_ne_zero _ (NeZero.ne L))
  rcases hg with (⟨μ, rfl⟩ | ⟨μ, rfl⟩) | ⟨μ, ν, rfl⟩
  · refine ⟨translateCentres (s • (Pi.single μ 1 : CTorus d L N₁ m₁ K)), fun _ => rfl,
      fun j y x => cubeBump_translate j y x _, fun j y x R => inBox_add_iff j y x _ R,
      fun j y hj => cubeBase_add_iff hj y _ fun μ' =>
        dvd_val_transVec μ μ' (dvd_val_natCast_side hj (hsj j hj)),
      fun j y y' hj _ => ?_⟩
    exact sameCell_add_iff (dvd_side hj) y' y _ fun μ' =>
      dvd_val_transVec μ μ' (dvd_val_natCast_side hj (hsj j hj))
  · rw [flipBy_eq]
    refine ⟨reflectCover μ ((s : ℕ) : ZMod ((N₁ * L ^ m₁) * L ^ K)), fun _ => rfl,
      fun j y x => cubeBump_reflect j μ _ y x, fun j y x R => inBox_refl_iff j μ _ y x R,
      fun j y hj => cubeBase_reflBase_iff hj μ _ (dvd_val_natCast_side hj (hsj j hj)) y,
      fun j y y' hj hy => ?_⟩
    exact sameCell_refl_iff (dvd_side hj) (hs0 j) μ _ (dvd_val_natCast_side hj (hsj j hj)) y' y
      fun μ' => Nat.dvd_of_mod_eq_zero (hy μ')
  · rw [swapJ_eq]
    exact ⟨permuteCentres (Equiv.swap μ ν), fun _ => rfl,
      fun j y x => cubeBump_coordPerm _ j y x, fun j y x R => inBox_coordPerm_iff _ j y x R,
      fun j y _ => cubeBase_coordPerm_iff _ j y,
      fun j y y' _ _ => sameCell_coordPerm_iff _ _ y' y⟩

/-- **The action of an element of `symGroupBy s` on the cubes of the covers** (no generating
set): a permutation `τ` of the centres keeping the layer, with
`b_{τ(j,y)}(r x) = b_{(j,y)}(x)`, `r x ∈ □(τ(j,y)) ↔ x ∈ □(j,y)` for every radius, cube bases
carried to cube bases, and, for a cube base `y`, `r y'` in the cube of `τ(j,y)` iff `y'` in the
cube of `y`. -/
theorem exists_cubeAct_of_mem_symGroupBy {s : ℕ} (hs : L ^ (K + m₁) ∣ s)
    {r : Equiv.Perm (CTorus d L N₁ m₁ K)}
    (hr : r ∈ symGroupBy (N₁ := N₁) (m₁ := m₁) (k := K) (d := d) (L := L) s) :
    ∃ τ : Equiv.Perm (ℕ × CTorus d L N₁ m₁ K), (∀ q, (τ q).1 = q.1) ∧
      (∀ j y x, cubeBump m₁ j (τ (j, y)).2 (r x) = cubeBump m₁ j y x) ∧
      (∀ j y x R, InBox m₁ j (τ (j, y)).2 R (r x) ↔ InBox m₁ j y R x) ∧
      (∀ j y, j ≤ K → (CubeBase m₁ j (τ (j, y)).2 ↔ CubeBase m₁ j y)) ∧
      (∀ j y y', j ≤ K → CubeBase m₁ j y →
        (SameCell (L ^ (j + m₁)) (r y') (τ (j, y)).2 ↔ SameCell (L ^ (j + m₁)) y' y)) := by
  induction hr using Subgroup.closure_induction with
  | mem g hg => exact cubeAct_gen hs hg
  | one => exact ⟨1, fun _ => rfl, fun _ _ _ => rfl, fun _ _ _ _ => Iff.rfl, fun _ _ _ => Iff.rfl,
      fun _ _ _ _ _ => Iff.rfl⟩
  | mul g g' _ _ ih ih' =>
    obtain ⟨τ, H⟩ := ih
    obtain ⟨τ', H'⟩ := ih'
    exact ⟨τ * τ', cubeAct_mul H H'⟩
  | inv g _ ih =>
    obtain ⟨τ, H⟩ := ih
    exact ⟨τ⁻¹, cubeAct_inv H⟩

omit [NeZero N₁] [NeZero L] in
/-- The block properties are stable under products. -/
theorem blockAct_mul {g g' : Equiv.Perm (CTorus d L N₁ m₁ K)}
    {τ τ' : Equiv.Perm (ℕ × CTorus d L N₁ m₁ K)}
    (H : (∀ q, (τ q).1 = q.1) ∧
      (∀ q x, Background.bump (τ q).1 (τ q).2 (g x) = Background.bump q.1 q.2 x) ∧
      (∀ j y, j ≤ K → (IsBase j (τ (j, y)).2 ↔ IsBase j y)) ∧
      (∀ j y y', j ≤ K → IsBase j y →
        (SameCell (L ^ j) (g y') (τ (j, y)).2 ↔ SameCell (L ^ j) y' y)))
    (H' : (∀ q, (τ' q).1 = q.1) ∧
      (∀ q x, Background.bump (τ' q).1 (τ' q).2 (g' x) = Background.bump q.1 q.2 x) ∧
      (∀ j y, j ≤ K → (IsBase j (τ' (j, y)).2 ↔ IsBase j y)) ∧
      (∀ j y y', j ≤ K → IsBase j y →
        (SameCell (L ^ j) (g' y') (τ' (j, y)).2 ↔ SameCell (L ^ j) y' y))) :
    (∀ q, ((τ * τ') q).1 = q.1) ∧
      (∀ q x, Background.bump ((τ * τ') q).1 ((τ * τ') q).2 ((g * g') x) = Background.bump q.1 q.2 x) ∧
      (∀ j y, j ≤ K → (IsBase j ((τ * τ') (j, y)).2 ↔ IsBase j y)) ∧
      (∀ j y y', j ≤ K → IsBase j y →
        (SameCell (L ^ j) ((g * g') y') ((τ * τ') (j, y)).2 ↔ SameCell (L ^ j) y' y)) := by
  obtain ⟨h1, h2, h4, h5⟩ := H
  obtain ⟨h1', h2', h4', h5'⟩ := H'
  have e : ∀ j y, τ' (j, y) = (j, (τ' (j, y)).2) := fun j y => Prod.ext (h1' _) rfl
  refine ⟨fun q => by simp [h1, h1'], fun q x => ?_, fun j y hj => ?_, fun j y y' hj hy => ?_⟩
  · simp only [Equiv.Perm.coe_mul, Function.comp_apply]
    rw [h2, h2']
  · simp only [Equiv.Perm.coe_mul, Function.comp_apply]
    rw [e j y, h4 _ _ hj, h4' _ _ hj]
  · simp only [Equiv.Perm.coe_mul, Function.comp_apply]
    rw [e j y, h5 _ _ _ hj ((h4' _ _ hj).2 hy), h5' _ _ _ hj hy]

omit [NeZero N₁] [NeZero L] in
/-- The block properties are stable under inverses. -/
theorem blockAct_inv {g : Equiv.Perm (CTorus d L N₁ m₁ K)}
    {τ : Equiv.Perm (ℕ × CTorus d L N₁ m₁ K)}
    (H : (∀ q, (τ q).1 = q.1) ∧
      (∀ q x, Background.bump (τ q).1 (τ q).2 (g x) = Background.bump q.1 q.2 x) ∧
      (∀ j y, j ≤ K → (IsBase j (τ (j, y)).2 ↔ IsBase j y)) ∧
      (∀ j y y', j ≤ K → IsBase j y →
        (SameCell (L ^ j) (g y') (τ (j, y)).2 ↔ SameCell (L ^ j) y' y))) :
    (∀ q, (τ⁻¹ q).1 = q.1) ∧
      (∀ q x, Background.bump (τ⁻¹ q).1 (τ⁻¹ q).2 (g⁻¹ x) = Background.bump q.1 q.2 x) ∧
      (∀ j y, j ≤ K → (IsBase j (τ⁻¹ (j, y)).2 ↔ IsBase j y)) ∧
      (∀ j y y', j ≤ K → IsBase j y →
        (SameCell (L ^ j) (g⁻¹ y') (τ⁻¹ (j, y)).2 ↔ SameCell (L ^ j) y' y)) := by
  obtain ⟨h1, h2, h4, h5⟩ := H
  have e : ∀ j y, τ⁻¹ (j, y) = (j, (τ⁻¹ (j, y)).2) := fun j y => by
    refine Prod.ext ?_ rfl
    have := h1 (τ⁻¹ (j, y))
    simp only [apply_inv_self_perm] at this
    exact this.symm
  have hτ : ∀ j y, τ (j, (τ⁻¹ (j, y)).2) = (j, y) := fun j y => by
    rw [← e j y, apply_inv_self_perm]
  refine ⟨fun q => ?_, fun q x => ?_, fun j y hj => ?_, fun j y y' hj hy => ?_⟩
  · have := h1 (τ⁻¹ q)
    simp only [apply_inv_self_perm] at this
    exact this.symm
  · have := h2 (τ⁻¹ q) (g⁻¹ x)
    rw [apply_inv_self_perm, apply_inv_self_perm] at this
    exact this.symm
  · have := h4 j (τ⁻¹ (j, y)).2 hj
    rw [hτ] at this
    exact this.symm
  · have hb : IsBase j (τ⁻¹ (j, y)).2 := by
      have := h4 j (τ⁻¹ (j, y)).2 hj
      rw [hτ] at this
      exact this.1 hy
    have := h5 j (τ⁻¹ (j, y)).2 (g⁻¹ y') hj hb
    rw [hτ, apply_inv_self_perm] at this
    exact this.symm

/-- The block properties for the generators of `symGroupBy s`. -/
theorem blockAct_gen {s : ℕ} (hs : L ^ K ∣ s) {g : Equiv.Perm (CTorus d L N₁ m₁ K)}
    (hg : g ∈ ({g | ∃ μ, g = transBy (N₁ := N₁) (m₁ := m₁) (k := K) (L := L) s μ} ∪
      {g | ∃ μ, g = flipBy (N₁ := N₁) (m₁ := m₁) (k := K) (L := L) s μ} ∪
      {g | ∃ μ ν, g = swapJ (N₁ := N₁) (m₁ := m₁) (k := K) (L := L) μ ν})) :
    ∃ τb : Equiv.Perm (ℕ × CTorus d L N₁ m₁ K), (∀ q, (τb q).1 = q.1) ∧
      (∀ q x, Background.bump (τb q).1 (τb q).2 (g x) = Background.bump q.1 q.2 x) ∧
      (∀ j y, j ≤ K → (IsBase j (τb (j, y)).2 ↔ IsBase j y)) ∧
      (∀ j y y', j ≤ K → IsBase j y →
        (SameCell (L ^ j) (g y') (τb (j, y)).2 ↔ SameCell (L ^ j) y' y)) := by
  have hsj : ∀ j, j ≤ K → L ^ j ∣ s := fun j hj => (pow_dvd_pow L hj).trans hs
  have hs0 : ∀ j, 0 < L ^ j := fun j => Nat.pos_of_ne_zero (pow_ne_zero _ (NeZero.ne L))
  rcases hg with (⟨μ, rfl⟩ | ⟨μ, rfl⟩) | ⟨μ, ν, rfl⟩
  · refine ⟨translateCentres (s • (Pi.single μ 1 : CTorus d L N₁ m₁ K)), fun _ => rfl,
      fun q x => bump_translate q.1 q.2 x _,
      fun j y hj => isBase_add_iff hj y _ fun μ' =>
        dvd_val_transVec μ μ' (dvd_val_natCast_side' hj (hsj j hj)),
      fun j y y' hj _ => ?_⟩
    exact sameCell_add_iff (dvd_side' hj) y' y _ fun μ' =>
      dvd_val_transVec μ μ' (dvd_val_natCast_side' hj (hsj j hj))
  · rw [flipBy_eq]
    refine ⟨reflectBlock μ ((s : ℕ) : ZMod ((N₁ * L ^ m₁) * L ^ K)), fun _ => rfl,
      fun q x => bump_reflect q.1 μ _ q.2 x,
      fun j y hj => isBase_reflBase_iff hj μ _ (dvd_val_natCast_side' hj (hsj j hj)) y,
      fun j y y' hj hy => ?_⟩
    exact sameCell_refl_iff (dvd_side' hj) (hs0 j) μ _ (dvd_val_natCast_side' hj (hsj j hj))
      y' y fun μ' => Nat.dvd_of_mod_eq_zero (hy μ')
  · rw [swapJ_eq]
    exact ⟨permuteCentres (Equiv.swap μ ν), fun _ => rfl,
      fun q x => bump_coordPerm q.1 _ q.2 x, fun j y _ => isBase_coordPerm_iff _ j y,
      fun j y y' _ _ => sameCell_coordPerm_iff _ _ y' y⟩

/-- **The action of an element of `symGroupBy s` on the blocks of the interpolation** (no
generating set): a permutation `τb` of the block indices keeping the layer, with
`b_{τb(j,y)}(r x) = b_{(j,y)}(x)`, block bases carried to block bases, and, for a block base `y`,
`r y'` in the block of `τb(j,y)` iff `y'` in the block of `y`. -/
theorem exists_blockAct_of_mem_symGroupBy {s : ℕ} (hs : L ^ K ∣ s)
    {r : Equiv.Perm (CTorus d L N₁ m₁ K)}
    (hr : r ∈ symGroupBy (N₁ := N₁) (m₁ := m₁) (k := K) (d := d) (L := L) s) :
    ∃ τb : Equiv.Perm (ℕ × CTorus d L N₁ m₁ K), (∀ q, (τb q).1 = q.1) ∧
      (∀ q x, Background.bump (τb q).1 (τb q).2 (r x) = Background.bump q.1 q.2 x) ∧
      (∀ j y, j ≤ K → (IsBase j (τb (j, y)).2 ↔ IsBase j y)) ∧
      (∀ j y y', j ≤ K → IsBase j y →
        (SameCell (L ^ j) (r y') (τb (j, y)).2 ↔ SameCell (L ^ j) y' y)) := by
  induction hr using Subgroup.closure_induction with
  | mem g hg => exact blockAct_gen hs hg
  | one => exact ⟨1, fun _ => rfl, fun _ _ => rfl, fun _ _ _ => Iff.rfl, fun _ _ _ _ _ => Iff.rfl⟩
  | mul g g' _ _ ih ih' =>
    obtain ⟨τ, H⟩ := ih
    obtain ⟨τ', H'⟩ := ih'
    exact ⟨τ * τ', blockAct_mul H H'⟩
  | inv g _ ih =>
    obtain ⟨τ, H⟩ := ih
    exact ⟨τ⁻¹, blockAct_inv H⟩

end Act

section Data

variable {G G' : GeneratingSet d L (N₁ * L ^ m₁) K ϱ} {r : Equiv.Perm (CTorus d L N₁ m₁ K)}

theorem mem_layer_of_image (hΩ : ∀ i, 1 ≤ i → i ≤ K + 1 → ∀ x, r x ∈ G'.Ω i ↔ x ∈ G.Ω i)
    {j : ℕ} (h1 : 1 ≤ j) (hk : j ≤ K) (x : CTorus d L N₁ m₁ K) :
    r x ∈ G'.layer j ↔ x ∈ G.layer j := by
  rw [GeneratingSet.mem_layer, GeneratingSet.mem_layer, hΩ j h1 (by omega),
    hΩ (j + 1) (by omega) (by omega)]

/-- The layer `j` of a cube-aligned generating set is a union of cubes of side `L ^ (j + m₁)`. -/
theorem layer_iff_of_sameCell_cube (hca : CubeAligned G m₁) {j : ℕ} (h1 : 1 ≤ j) (hk : j ≤ K)
    {x x' : CTorus d L N₁ m₁ K} (h : SameCell (L ^ (j + m₁)) x x') :
    x ∈ G.layer j ↔ x' ∈ G.layer j := by
  rw [GeneratingSet.mem_layer, GeneratingSet.mem_layer, hca.union j h1 hk x x' h]
  refine and_congr_right fun _ => not_congr ?_
  rcases Nat.lt_or_ge j K with hjK | hjK
  · exact hca.union (j + 1) (by omega) (by omega) x x'
      (SameCell.mono (pow_dvd_pow L (by omega)) h)
  · have hj : j = K := by omega
    subst hj
    simp [G.top]

/-- The layer `j` of a generating set is a union of `j`-blocks. -/
theorem layer_iff_of_sameCell_block {j : ℕ} (h1 : 1 ≤ j) (hk : j ≤ K)
    {x x' : CTorus d L N₁ m₁ K} (h : SameCell (L ^ j) x x') :
    x ∈ G.layer j ↔ x' ∈ G.layer j := by
  rw [GeneratingSet.mem_layer, GeneratingSet.mem_layer,
    G.blockUnion j h1 hk x x' (jBlock_eq_of_sameCell h)]
  refine and_congr_right fun _ => not_congr ?_
  rcases Nat.lt_or_ge j K with hjK | hjK
  · exact G.blockUnion (j + 1) (by omega) (by omega) x x'
      (jBlock_eq_of_sameCell (SameCell.mono (pow_dvd_pow L (by omega)) h))
  · have hj : j = K := by omega
    subst hj
    simp [G.top]

/-- **The transport of the covers between two generating sets related by `r`**, from the action of
`r` on the cubes (`exists_cubeAct_of_mem_symGroupBy`): the fields `hidx`, `hchi`, `hbox`, `hqset`
of `LatPairCover.lean` for `Ω_i(G') = r Ω_i(G)`, `G'` cube aligned. -/
theorem coverData_of_cubeAct {τ : Equiv.Perm (ℕ × CTorus d L N₁ m₁ K)}
    (hΩ : ∀ i, 1 ≤ i → i ≤ K + 1 → ∀ x, r x ∈ G'.Ω i ↔ x ∈ G.Ω i) (hca' : CubeAligned G' m₁)
    (H : (∀ q, (τ q).1 = q.1) ∧
      (∀ j y x, cubeBump m₁ j (τ (j, y)).2 (r x) = cubeBump m₁ j y x) ∧
      (∀ j y x R, InBox m₁ j (τ (j, y)).2 R (r x) ↔ InBox m₁ j y R x) ∧
      (∀ j y, j ≤ K → (CubeBase m₁ j (τ (j, y)).2 ↔ CubeBase m₁ j y)) ∧
      (∀ j y y', j ≤ K → CubeBase m₁ j y →
        (SameCell (L ^ (j + m₁)) (r y') (τ (j, y)).2 ↔ SameCell (L ^ (j + m₁)) y' y))) :
    (∀ q, τ q ∈ (coverOf G').cubeIdx ↔ q ∈ (coverOf G).cubeIdx) ∧
    (∀ q x, (coverOf G').chi (τ q) (r x) = (coverOf G).chi q x) ∧
    (∀ q x, r x ∈ intBox (τ q) ↔ x ∈ intBox q) ∧
    (∀ q q', τ q' ∈ (coverOf G').Qset (τ q) ↔ q' ∈ (coverOf G).Qset q) := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := H
  have e : ∀ q, τ q = (q.1, (τ (q.1, q.2)).2) := fun q => Prod.ext (h1 q) rfl
  have hidx : ∀ q, τ q ∈ (coverOf G').cubeIdx ↔ q ∈ (coverOf G).cubeIdx := by
    intro q
    show τ q ∈ cubeIdx G' ↔ q ∈ cubeIdx G
    rw [e q, mem_cubeIdx, mem_cubeIdx]
    simp only
    constructor
    · rintro ⟨hr, hl, hb⟩
      have hb' : CubeBase m₁ q.1 q.2 := (h4 q.1 q.2 hr.2).1 hb
      have hc := (h5 q.1 q.2 q.2 hr.2 hb').2 (SameCell.refl _ _)
      refine ⟨hr, ?_, hb'⟩
      rw [← mem_layer_of_image hΩ hr.1 hr.2]
      exact (layer_iff_of_sameCell_cube hca' hr.1 hr.2 hc).2 hl
    · rintro ⟨hr, hl, hb⟩
      have hc := (h5 q.1 q.2 q.2 hr.2 hb).2 (SameCell.refl _ _)
      refine ⟨hr, ?_, (h4 q.1 q.2 hr.2).2 hb⟩
      exact (layer_iff_of_sameCell_cube hca' hr.1 hr.2 hc).1
        ((mem_layer_of_image hΩ hr.1 hr.2 q.2).2 hl)
  have hden : ∀ x, coverDenom G' (r x) = coverDenom G x := by
    intro x
    unfold coverDenom
    refine (Finset.sum_equiv τ (fun q => (hidx q).symm) fun q _ => ?_).symm
    rw [e q]
    exact (h2 q.1 q.2 x).symm
  refine ⟨hidx, fun q x => ?_, fun q x => ?_, fun q q' => ?_⟩
  · show chi G' (τ q) (r x) = chi G q x
    unfold chi
    rw [hden, e q, h2]
  · rw [e q, mem_intBox, mem_intBox]
    exact h3 q.1 q.2 x _
  · rw [DecCover.mem_Qset, DecCover.mem_Qset, hidx]
    refine and_congr_right fun hq' => ?_
    have hr' := ((mem_cubeIdx G).1 hq').1
    have hb' := ((mem_cubeIdx G).1 hq').2.2
    rw [e q', e q]
    constructor
    · rintro ⟨y, hy1, hy2⟩
      refine ⟨r⁻¹ y, ?_, ?_⟩
      · refine (h5 q'.1 q'.2 (r⁻¹ y) hr'.2 hb').1 ?_
        rw [apply_inv_self_perm]
        exact hy1
      · refine (h3 q.1 q.2 (r⁻¹ y) _).1 ?_
        rw [apply_inv_self_perm]
        exact hy2
    · rintro ⟨y, hy1, hy2⟩
      exact ⟨r y, (h5 q'.1 q'.2 y hr'.2 hb').2 hy1, (h3 q.1 q.2 y _).2 hy2⟩

/-- **The transport of the blocks between two generating sets related by `r`**, from the action of
`r` on the blocks (`exists_blockAct_of_mem_symGroupBy`): the fields `hbidx`, `hblayer`, `hbump`,
`hbbase` of `LatPairBg.lean` for `Ω_i(G') = r Ω_i(G)`. -/
theorem blockData_of_blockAct {τb : Equiv.Perm (ℕ × CTorus d L N₁ m₁ K)}
    (hΩ : ∀ i, 1 ≤ i → i ≤ K + 1 → ∀ x, r x ∈ G'.Ω i ↔ x ∈ G.Ω i)
    (H : (∀ q, (τb q).1 = q.1) ∧
      (∀ q x, Background.bump (τb q).1 (τb q).2 (r x) = Background.bump q.1 q.2 x) ∧
      (∀ j y, j ≤ K → (IsBase j (τb (j, y)).2 ↔ IsBase j y)) ∧
      (∀ j y y', j ≤ K → IsBase j y →
        (SameCell (L ^ j) (r y') (τb (j, y)).2 ↔ SameCell (L ^ j) y' y))) :
    (∀ q, τb q ∈ blockIdx G' ↔ q ∈ blockIdx G) ∧ (∀ q, (τb q).1 = q.1) ∧
    (∀ q x, Background.bump (τb q).1 (τb q).2 (r x) = Background.bump q.1 q.2 x) ∧
    (∀ q ∈ blockIdx G, jBlock d L (N₁ * L ^ m₁) K q.1 (r.symm (τb q).2) =
      jBlock d L (N₁ * L ^ m₁) K q.1 q.2) := by
  obtain ⟨h1, h2, h4, h5⟩ := H
  have e : ∀ q, τb q = (q.1, (τb (q.1, q.2)).2) := fun q => Prod.ext (h1 q) rfl
  refine ⟨fun q => ?_, h1, h2, fun q hq => ?_⟩
  · rw [e q, mem_blockIdx, mem_blockIdx]
    simp only
    constructor
    · rintro ⟨hr, hl, hb⟩
      have hb' : IsBase q.1 q.2 := (h4 q.1 q.2 hr.2).1 hb
      have hc := (h5 q.1 q.2 q.2 hr.2 hb').2 (SameCell.refl _ _)
      refine ⟨hr, ?_, hb'⟩
      rw [← mem_layer_of_image hΩ hr.1 hr.2]
      exact (layer_iff_of_sameCell_block (G := G') hr.1 hr.2 hc).2 hl
    · rintro ⟨hr, hl, hb⟩
      have hc := (h5 q.1 q.2 q.2 hr.2 hb).2 (SameCell.refl _ _)
      refine ⟨hr, ?_, (h4 q.1 q.2 hr.2).2 hb⟩
      exact (layer_iff_of_sameCell_block (G := G') hr.1 hr.2 hc).1
        ((mem_layer_of_image hΩ hr.1 hr.2 q.2).2 hl)
  · obtain ⟨hr, -, hb⟩ := (mem_blockIdx G).1 hq
    refine jBlock_eq_of_sameCell ((h5 q.1 q.2 (r.symm (τb q).2) hr.2 hb).1 ?_)
    rw [Equiv.apply_symm_apply]
    exact SameCell.refl _ _

end Data

section Symm

/-- The image form `Ω_i(G') = r Ω_i(G)` gives the membership form. -/
theorem mem_Ω_iff_of_image {G G' : GeneratingSet d L (N₁ * L ^ m₁) K ϱ}
    {r : Equiv.Perm (CTorus d L N₁ m₁ K)}
    (hΩ : ∀ i, ((G'.Ω i : Finset (CTorus d L N₁ m₁ K)) : Set (CTorus d L N₁ m₁ K)) =
      r '' ((G.Ω i : Finset (CTorus d L N₁ m₁ K)) : Set (CTorus d L N₁ m₁ K))) :
    ∀ i, 1 ≤ i → i ≤ K + 1 → ∀ x, r x ∈ G'.Ω i ↔ x ∈ G.Ω i := by
  intro i _ _ x
  have h1 : r x ∈ (G'.Ω i : Set (CTorus d L N₁ m₁ K)) ↔
      r x ∈ r '' (G.Ω i : Set (CTorus d L N₁ m₁ K)) := by rw [hΩ i]
  simpa using h1

/-- **An element of `symGroupBy s` (`L ^ K ∣ s`) is a lattice symmetry between two generating
sets whose domains it carries onto each other.** -/
theorem nonempty_latSymm_of_mem_symGroupBy {G G' : GeneratingSet d L (N₁ * L ^ m₁) K ϱ}
    {s : ℕ} (hs : L ^ K ∣ s) {r : Equiv.Perm (CTorus d L N₁ m₁ K)}
    (hr : r ∈ symGroupBy (N₁ := N₁) (m₁ := m₁) (k := K) (d := d) (L := L) s)
    (hΩ : ∀ i, 1 ≤ i → i ≤ K + 1 → ∀ x, r x ∈ G'.Ω i ↔ x ∈ G.Ω i) :
    Nonempty (LatSymm G G' r) := by
  obtain ⟨T⟩ := nonempty_torusSymm_of_mem_symGroupBy (j := K) le_rfl hs hr
  exact ⟨LatSymm.ofTorusSymm T hΩ fun _ _ hk _ => hk⟩

/-- **An element of `symGroupBy s` (`L ^ (k + 1) ∣ s`) preserves the unit blocks.** -/
theorem unitBlockPres_of_mem_symGroupBy {k s : ℕ} (hs : L ^ (k + 1) ∣ s)
    {r : Equiv.Perm (CTorus d L N₁ m₁ (k + 1))}
    (hr : r ∈ symGroupBy (N₁ := N₁) (m₁ := m₁) (k := k + 1) (d := d) (L := L) s) :
    DetUnitIncidence.UnitBlockPres r := by
  obtain ⟨T⟩ := nonempty_torusSymm_of_mem_symGroupBy (j := k + 1) le_rfl hs hr
  exact DetUnitIncidence.unitBlockPres_of_torusSymm (by omega) T

end Symm

section GenSymmPaving

variable {m₀ : ℕ}

/-- `GenSymm` is closed under inverses. -/
theorem genSymm_inv {n : ℕ} (hn : L ^ (n + m₀ + m₁) ∣ (N₁ * L ^ m₁) * L ^ K)
    {σ : Equiv.Perm (CTorus d L N₁ m₁ K)} (h : GenSymm L N₁ m₁ K n m₀ σ) :
    GenSymm L N₁ m₁ K n m₀ σ⁻¹ := by
  induction h with
  | one => simpa using GenSymm.one
  | translate t ht =>
    have e : (Equiv.addRight t : Equiv.Perm (CTorus d L N₁ m₁ K))⁻¹ = Equiv.addRight (-t) := by
      ext x μ; simp [Equiv.Perm.inv_def]
    rw [e]
    refine GenSymm.translate (-t) fun μ => ?_
    rw [Pi.neg_apply, ZMod.neg_val]
    split_ifs
    · exact dvd_zero _
    · exact Nat.dvd_sub hn (ht μ)
  | perm π =>
    have e : (coordPerm π : Equiv.Perm (CTorus d L N₁ m₁ K))⁻¹ = coordPerm π⁻¹ := by
      ext x μ; simp [Equiv.Perm.inv_def, coordPerm]
    rw [e]
    exact GenSymm.perm π⁻¹
  | reflect μ₀ c hc =>
    have e : (reflPerm μ₀ c : Equiv.Perm (CTorus d L N₁ m₁ K))⁻¹ = reflPerm μ₀ c := by
      rw [Equiv.Perm.inv_def, reflPerm_symm]
    rw [e]
    exact GenSymm.reflect μ₀ c hc
  | trans _ _ ih ih' =>
    rename_i σ₁ σ₂ _ _
    have e : (σ₁.trans σ₂)⁻¹ = σ₂⁻¹.trans σ₁⁻¹ := by
      ext x; simp [Equiv.Perm.inv_def]
    rw [e]
    exact GenSymm.trans ih' ih

/-- **The paving group is generated by the admissible translations, reflections and coordinate
permutations** (`L ^ m₀ ∣ N₁`): every element of `pavingSymGroup L m₀ K` lies in `GenSymm`.  With
`genSymm_mem_pavingSymGroup` the two groups agree. -/
theorem genSymm_of_mem_pavingSymGroup (hN : L ^ m₀ ∣ N₁) {σ : Equiv.Perm (CTorus d L N₁ m₁ K)}
    (hσ : σ ∈ pavingSymGroup (N₁ := N₁) (m₁ := m₁) (k := K) (d := d) L m₀ K) :
    GenSymm L N₁ m₁ K K m₀ σ := by
  have hn : L ^ (K + m₀ + m₁) ∣ (N₁ * L ^ m₁) * L ^ K := by
    obtain ⟨c, hc⟩ := hN
    exact ⟨c, by rw [hc]; ring⟩
  have hs : L ^ (K + m₀ + m₁) ∣ (((cellSide L m₀ m₁ K : ℕ) : ZMod ((N₁ * L ^ m₁) * L ^ K))).val := by
    rw [ZMod.val_natCast]
    exact (Nat.dvd_mod_iff hn).2 dvd_rfl
  induction hσ using Subgroup.closure_induction with
  | mem g hg =>
    rcases hg with (⟨μ, rfl⟩ | ⟨μ, rfl⟩) | ⟨μ, ν, rfl⟩
    · exact GenSymm.translate _ fun μ' => dvd_val_transVec μ μ' hs
    · rw [flipBy_eq]
      exact GenSymm.reflect μ _ hs
    · rw [swapJ_eq]
      exact GenSymm.perm _
  | one => exact GenSymm.one
  | mul g g' _ _ ih ih' =>
    rw [Equiv.Perm.mul_def]
    exact GenSymm.trans ih' ih
  | inv g _ ih => exact genSymm_inv hn ih

/-- **The four symmetry structures of a level set for the paving group** (`FullSymm.of_genSymm`). -/
theorem nonempty_fullSymm_of_mem_pavingSymGroup {G : GeneratingSet d L (N₁ * L ^ m₁) K ϱ}
    (hG : IsLevel G K) (hN : L ^ m₀ ∣ N₁) {σ : Equiv.Perm (CTorus d L N₁ m₁ K)}
    (hσ : σ ∈ pavingSymGroup (N₁ := N₁) (m₁ := m₁) (k := K) (d := d) L m₀ K) :
    Nonempty (FullSymm G m₀ σ) :=
  FullSymm.of_genSymm hG hN (genSymm_of_mem_pavingSymGroup hN hσ)

end GenSymmPaving

