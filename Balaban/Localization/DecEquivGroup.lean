module

public import Balaban.Localization.DecEquivReflectPolymer
public import Balaban.Localization.DecEquivPermutePolymer

/-!
# The group generated by translations, coordinate permutations and reflections

For a level set `G` (`IsLevel G n`) and `m₀` with `L ^ m₀ ∣ N₁`, the four structures
`LatSymm`, `CoverSymm`, `BlockSymm`, `PolymerSymm` are bundled in `FullSymm G m₀ σ` (the
`PolymerSymm` acts on the centres by the action of the `CoverSymm`).  Bundles compose
(`FullSymm.trans`), and exist for the generators
* translations by `t` with `L ^ (n + m₀ + m₁) ∣ t_μ` (`FullSymm.ofTranslate`),
* all coordinate permutations (`FullSymm.ofCoordPerm`),
* reflections `x_μ₀ ↦ c - 1 - x_μ₀` with `L ^ (n + m₀ + m₁) ∣ c.val` (`FullSymm.ofReflect`).

`GenSymm` is the submonoid of `Equiv.Perm (CTorus ..)` generated by them; it is a group, since the
inverse of a translation is a translation, of a permutation a permutation, and a reflection is an
involution.  `FullSymm.of_genSymm` says the four structures exist for every element.
Covariance of the output terms of a step as class terms is not proved.
-/

@[expose] public section

namespace Balaban.Localization.DecEquiv

open Balaban Balaban.Multiscale Balaban.Background Balaban.Fluctuation Finset

variable {d L N₁ m₁ K : ℕ} [NeZero N₁] [NeZero L] {ϱ : ℝ}

/-- The four symmetry structures of a symmetry `σ` of a level set, acting on the centres by the
same permutation. -/
structure FullSymm (G : GeneratingSet d L (N₁ * L ^ m₁) K ϱ) (m₀ : ℕ)
    (σ : Equiv.Perm (CTorus d L N₁ m₁ K)) where
  lat : LatSymm G G σ
  cover : CoverSymm (coverOf G) σ
  block : BlockSymm G σ
  polymer : PolymerSymm G m₀ σ cover.τ

/-- The identity. -/
noncomputable def FullSymm.refl (G : GeneratingSet d L (N₁ * L ^ m₁) K ϱ) (m₀ : ℕ) :
    FullSymm G m₀ (1 : Equiv.Perm (CTorus d L N₁ m₁ K)) where
  lat := LatSymm.refl G
  cover := CoverSymm.refl (coverOf G)
  block := BlockSymm.refl G
  polymer := polymerSymm_refl G m₀

theorem fullSymm_nonempty (G : GeneratingSet d L (N₁ * L ^ m₁) K ϱ) (m₀ : ℕ) :
    Nonempty (FullSymm G m₀ (1 : Equiv.Perm (CTorus d L N₁ m₁ K))) := ⟨FullSymm.refl G m₀⟩

variable {G : GeneratingSet d L (N₁ * L ^ m₁) K ϱ} {m₀ n : ℕ}

/-- Composition (first `σ`, then `σ'`). -/
noncomputable def FullSymm.trans {σ σ' : Equiv.Perm (CTorus d L N₁ m₁ K)}
    (F : FullSymm G m₀ σ) (F' : FullSymm G m₀ σ') : FullSymm G m₀ (σ.trans σ') where
  lat := F.lat.trans F'.lat
  cover := F.cover.trans F'.cover
  block := F.block.trans F'.block F.lat
  polymer := F.polymer.trans F'.polymer fun q hq => (F.cover.idx q).2 hq

/-- Translations by vectors divisible by the cell side. -/
noncomputable def FullSymm.ofTranslate (hG : IsLevel G n) (hN : L ^ m₀ ∣ N₁) (t : CTorus d L N₁ m₁ K)
    (ht : ∀ μ, L ^ (n + m₀ + m₁) ∣ (t μ).val) : FullSymm G m₀ (Equiv.addRight t) where
  lat := LatSymm.ofTranslateLevel hG t fun μ => (pow_dvd_pow L (by omega)).trans (ht μ)
  cover := CoverSymm.ofTranslate hG t fun μ => (pow_dvd_pow L (by omega)).trans (ht μ)
  block := BlockSymm.ofTranslate hG t fun μ => (pow_dvd_pow L (by omega)).trans (ht μ)
  polymer := PolymerSymm.ofTranslate hG hN t ht

/-- Coordinate permutations. -/
noncomputable def FullSymm.ofCoordPerm (hG : IsLevel G n) (π : Equiv.Perm (Fin d)) :
    FullSymm G m₀ (coordPerm π : Equiv.Perm (CTorus d L N₁ m₁ K)) where
  lat := LatSymm.ofCoordPermLevel hG π
  cover := CoverSymm.ofCoordPerm hG π
  block := BlockSymm.ofCoordPerm hG π
  polymer := PolymerSymm.ofCoordPerm hG π

/-- Reflections with `L ^ (n + m₀ + m₁) ∣ c.val`. -/
noncomputable def FullSymm.ofReflect (hG : IsLevel G n) (hN : L ^ m₀ ∣ N₁) (μ₀ : Fin d)
    (c : ZMod ((N₁ * L ^ m₁) * L ^ K)) (hc : L ^ (n + m₀ + m₁) ∣ c.val) :
    FullSymm G m₀ (reflPerm μ₀ c) where
  lat := LatSymm.ofReflectLevel hG μ₀ c ((pow_dvd_pow L (by omega)).trans hc)
  cover := CoverSymm.ofReflect hG μ₀ c ((pow_dvd_pow L (by omega)).trans hc)
  block := BlockSymm.ofReflect hG μ₀ c ((pow_dvd_pow L (by omega)).trans hc)
  polymer := PolymerSymm.ofReflect hG hN μ₀ c hc

/-- The monoid of symmetries generated by the admissible translations, all coordinate
permutations and the admissible reflections (`a = L ^ (n + m₀ + m₁)` is the cell side). -/
inductive GenSymm (L N₁ m₁ K n m₀ : ℕ) [NeZero N₁] [NeZero L] {d : ℕ} :
    Equiv.Perm (CTorus d L N₁ m₁ K) → Prop
  | one : GenSymm L N₁ m₁ K n m₀ 1
  | translate (t : CTorus d L N₁ m₁ K) (ht : ∀ μ, L ^ (n + m₀ + m₁) ∣ (t μ).val) :
      GenSymm L N₁ m₁ K n m₀ (Equiv.addRight t)
  | perm (π : Equiv.Perm (Fin d)) : GenSymm L N₁ m₁ K n m₀ (coordPerm π)
  | reflect (μ₀ : Fin d) (c : ZMod ((N₁ * L ^ m₁) * L ^ K)) (hc : L ^ (n + m₀ + m₁) ∣ c.val) :
      GenSymm L N₁ m₁ K n m₀ (reflPerm μ₀ c)
  | trans {σ σ' : Equiv.Perm (CTorus d L N₁ m₁ K)} :
      GenSymm L N₁ m₁ K n m₀ σ → GenSymm L N₁ m₁ K n m₀ σ' →
        GenSymm L N₁ m₁ K n m₀ (σ.trans σ')

/-- **Every symmetry in the group generated by admissible translations, coordinate permutations
and admissible reflections carries the four structures** `LatSymm`, `CoverSymm`, `BlockSymm`,
`PolymerSymm` of a level set. -/
theorem FullSymm.of_genSymm (hG : IsLevel G n) (hN : L ^ m₀ ∣ N₁)
    {σ : Equiv.Perm (CTorus d L N₁ m₁ K)} (h : GenSymm L N₁ m₁ K n m₀ σ) :
    Nonempty (FullSymm G m₀ σ) := by
  induction h with
  | one => exact ⟨FullSymm.refl G m₀⟩
  | translate t ht => exact ⟨FullSymm.ofTranslate hG hN t ht⟩
  | perm π => exact ⟨FullSymm.ofCoordPerm hG π⟩
  | reflect μ₀ c hc => exact ⟨FullSymm.ofReflect hG hN μ₀ c hc⟩
  | trans _ _ ih ih' =>
    obtain ⟨F⟩ := ih
    obtain ⟨F'⟩ := ih'
    exact ⟨F.trans F'⟩

end Balaban.Localization.DecEquiv
